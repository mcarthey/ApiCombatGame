<!-- Code Window -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
            <span class="label-muted">Developer Experience</span>
            <h2 class="display-md mt-3 mb-4" style="color: var(--md-sys-color-on-surface);">Your HTTP client is the controller</h2>
            <p class="text-base mb-6" style="color: var(--md-sys-color-on-surface-variant); line-height: 1.7;">
                No proprietary SDK required. Use curl, Postman, Python, C#, or any language
                that speaks HTTP. Every game action is an API call.
            </p>
            <div class="flex flex-wrap gap-2">
                <span class="md3-chip">REST API</span>
                <span class="md3-chip">JWT Auth</span>
                <span class="md3-chip">JSON Payloads</span>
                <span class="md3-chip">OpenAPI 3.0</span>
            </div>
        </div>
        <div class="code-window">
            <div class="code-window-header">
                <span class="code-window-dot red"></span>
                <span class="code-window-dot yellow"></span>
                <span class="code-window-dot green"></span>
                <span class="code-window-title">quickstart.sh</span>
            </div>
            <pre><code><span class="code-comment"># Register and get your token</span>
<span class="code-keyword">curl</span> <span class="code-flag">-X POST</span> <span class="code-url">/api/v1/auth/register</span> <span class="code-flag">\</span>
  <span class="code-flag">-H</span> <span class="code-string">"Content-Type: application/json"</span> <span class="code-flag">\</span>
  <span class="code-flag">-d</span> <span class="code-string">'{"username":"warrior1","password":"Pass123!"}'</span>

<span class="code-comment"># View your roster</span>
<span class="code-keyword">curl</span> <span class="code-url">/api/v1/player/roster</span> <span class="code-flag">\</span>
  <span class="code-flag">-H</span> <span class="code-string">"Authorization: Bearer $TOKEN"</span>

<span class="code-comment"># Queue for a ranked battle</span>
<span class="code-keyword">curl</span> <span class="code-flag">-X POST</span> <span class="code-url">/api/v1/battle/queue</span> <span class="code-flag">\</span>
  <span class="code-flag">-H</span> <span class="code-string">"Authorization: Bearer $TOKEN"</span> <span class="code-flag">\</span>
  <span class="code-flag">-d</span> <span class="code-string">'{"teamId":"$TEAM_ID","mode":"ranked"}'</span></code></pre>
        </div>
    </div>
</section>

<!-- Live Leaderboard -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="text-center mb-10">
        <span class="label-muted">Live Rankings</span>
        <h2 class="display-md mt-3" style="color: var(--md-sys-color-on-surface);">The arena is active</h2>
    </div>
    <div id="live-leaderboard" class="md3-card p-0 overflow-hidden max-w-3xl mx-auto" style="display: none;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: var(--md-sys-color-surface-container-high);">
                    <th class="text-left text-xs font-semibold uppercase px-5 py-3" style="color: var(--md-sys-color-on-surface-variant); letter-spacing: 0.05em;">Rank</th>
                    <th class="text-left text-xs font-semibold uppercase px-5 py-3" style="color: var(--md-sys-color-on-surface-variant); letter-spacing: 0.05em;">Player</th>
                    <th class="text-right text-xs font-semibold uppercase px-5 py-3" style="color: var(--md-sys-color-on-surface-variant); letter-spacing: 0.05em;">Rating</th>
                    <th class="text-left text-xs font-semibold uppercase px-5 py-3 hidden sm:table-cell" style="color: var(--md-sys-color-on-surface-variant); letter-spacing: 0.05em;">Tier</th>
                    <th class="text-right text-xs font-semibold uppercase px-5 py-3 hidden sm:table-cell" style="color: var(--md-sys-color-on-surface-variant); letter-spacing: 0.05em;">Win Rate</th>
                </tr>
            </thead>
            <tbody id="leaderboard-body"></tbody>
        </table>
        <div class="text-center py-4" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
            <a href="/Leaderboard" class="text-sm font-medium" style="color: var(--md-sys-color-primary); text-decoration: none;">
                View Full Leaderboard
                <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">arrow_forward</span>
            </a>
        </div>
    </div>
</section>

<script>
    (function () {
        function getTier(rating) {
            if (rating >= 1900) return 'I Use Arch btw';
            if (rating >= 1700) return 'Wizard';
            if (rating >= 1500) return '10x Dev';
            if (rating >= 1300) return 'Bug Hunter';
            if (rating >= 1100) return 'Code Monkey';
            if (rating >= 800) return 'Copy Pasta';
            return 'Rubber Duck';
        }

        fetch('/api/v1/leaderboard?limit=5')
            .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
            .then(function (players) {
                var tbody = document.getElementById('leaderboard-body');
                players.forEach(function (p) {
                    var tr = document.createElement('tr');
                    tr.style.borderTop = '1px solid var(--md-sys-color-outline-variant)';
                    tr.innerHTML =
                        '<td class="px-5 py-3 text-sm font-semibold" style="color: var(--md-sys-color-on-surface);">#' + p.rank + '</td>' +
                        '<td class="px-5 py-3 text-sm font-medium" style="color: var(--md-sys-color-on-surface);">' + p.username + '</td>' +
                        '<td class="px-5 py-3 text-sm font-semibold text-right" style="color: var(--md-sys-color-primary);">' + p.rating + '</td>' +
                        '<td class="px-5 py-3 text-xs hidden sm:table-cell" style="color: var(--md-sys-color-on-surface-variant);">' + getTier(p.rating) + '</td>' +
                        '<td class="px-5 py-3 text-sm text-right hidden sm:table-cell" style="color: var(--md-sys-color-on-surface-variant);">' + p.winRate + '%</td>';
                    tbody.appendChild(tr);
                });
                document.getElementById('live-leaderboard').style.display = 'block';
            })
            .catch(function () { /* silently hide if API unavailable */ });
    })();
</script>

