@page
@model ApiCombatGame.Pages.IndexModel
@{
    ViewData["Title"] = "Battle with Code";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Hero Section -->
    <div class="text-center py-16">
        <h1 class="text-5xl font-extrabold mb-4" style="color: var(--md-sys-color-on-surface);">
            Battle with <span style="color: var(--md-sys-color-primary);">Code</span>
        </h1>
        <p class="text-xl mb-8 max-w-2xl mx-auto" style="color: var(--md-sys-color-on-surface-variant);">
            An API-only strategic combat game for developers. No GUI provided &mdash; build your own client, configure strategies, and compete.
        </p>
        <div class="flex justify-center space-x-4">
            <md-filled-button href="/Auth/Register">
                Get Started Free
            </md-filled-button>
            <md-outlined-button href="/api-docs/v1">
                View API Docs
            </md-outlined-button>
        </div>
    </div>

    <!-- How It Works -->
    <div class="py-16" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
        <h2 class="text-3xl font-bold text-center mb-12" style="color: var(--md-sys-color-on-surface);">How It Works</h2>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="text-center p-6">
                <div class="w-16 h-16 flex items-center justify-center mx-auto mb-4"
                     style="background: var(--md-sys-color-primary-container); border-radius: 9999px;">
                    <span class="text-2xl font-bold" style="color: var(--md-sys-color-on-primary-container);">1</span>
                </div>
                <h3 class="text-xl font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">Register &amp; Get API Key</h3>
                <p style="color: var(--md-sys-color-on-surface-variant);">Create an account, grab your API key, and start making requests</p>
            </div>
            <div class="text-center p-6">
                <div class="w-16 h-16 flex items-center justify-center mx-auto mb-4"
                     style="background: var(--md-sys-color-primary-container); border-radius: 9999px;">
                    <span class="text-2xl font-bold" style="color: var(--md-sys-color-on-primary-container);">2</span>
                </div>
                <h3 class="text-xl font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">Build Your Team</h3>
                <p style="color: var(--md-sys-color-on-surface-variant);">Unlock units, configure teams, and design battle strategies via JSON</p>
            </div>
            <div class="text-center p-6">
                <div class="w-16 h-16 flex items-center justify-center mx-auto mb-4"
                     style="background: var(--md-sys-color-primary-container); border-radius: 9999px;">
                    <span class="text-2xl font-bold" style="color: var(--md-sys-color-on-primary-container);">3</span>
                </div>
                <h3 class="text-xl font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">Compete &amp; Climb</h3>
                <p style="color: var(--md-sys-color-on-surface-variant);">Queue battles, earn rewards, and climb the ELO leaderboard</p>
            </div>
        </div>
    </div>

    <!-- Sample Code -->
    <div class="py-16 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8"
         style="background: var(--md-sys-color-surface-container-highest); border-radius: var(--md-sys-shape-corner-large);">
        <h2 class="text-3xl font-bold text-center mb-8" style="color: var(--md-sys-color-on-surface);">Quick Start</h2>
        <div class="max-w-3xl mx-auto">
            <pre class="p-6 overflow-x-auto text-sm"
                 style="background: #1e1e1e; color: #d4d4d4; border-radius: var(--md-sys-shape-corner-medium);"><code># Register and get your token
curl -X POST /api/v1/auth/register \
  -H "Content-Type: application/json" \
  -d '{"username":"warrior1","email":"w@@test.com","password":"SecurePass123!"}'

# View your roster
curl /api/v1/player/roster -H "Authorization: Bearer YOUR_TOKEN"

# Create a team and queue for battle
curl -X POST /api/v1/battle/queue \
  -H "Authorization: Bearer YOUR_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"teamId":"TEAM_ID","mode":"ranked"}'</code></pre>
        </div>
    </div>

    <!-- Pricing -->
    <div class="py-16" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
        <h2 class="text-3xl font-bold text-center mb-12" style="color: var(--md-sys-color-on-surface);">Pricing</h2>
        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
            <!-- Free Tier -->
            <div class="md3-card">
                <h3 class="text-xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">Free</h3>
                <p class="text-3xl font-bold mb-4" style="color: var(--md-sys-color-on-surface);">$0<span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">/mo</span></p>
                <ul class="space-y-2 mb-6" style="color: var(--md-sys-color-on-surface-variant);">
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> 10 battles/day</li>
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> Basic units</li>
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> Public leaderboards</li>
                </ul>
                <md-outlined-button class="w-full" href="/Auth/Register">
                    Get Started
                </md-outlined-button>
            </div>
            <!-- Premium Tier -->
            <div class="md3-card-elevated relative" style="border: 2px solid var(--md-sys-color-primary);">
                <div class="absolute top-0 right-0 px-3 py-1 text-sm"
                     style="background: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary); border-radius: 0 var(--md-sys-shape-corner-large) 0 var(--md-sys-shape-corner-medium);">
                    Popular
                </div>
                <h3 class="text-xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">Premium</h3>
                <p class="text-3xl font-bold mb-4" style="color: var(--md-sys-color-on-surface);">$5<span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">/mo</span></p>
                <ul class="space-y-2 mb-6" style="color: var(--md-sys-color-on-surface-variant);">
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> Unlimited battles</li>
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> 50+ units</li>
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> Priority queue</li>
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> Advanced stats</li>
                </ul>
                <md-filled-button class="w-full" href="/Auth/Register">
                    Start Free Trial
                </md-filled-button>
            </div>
            <!-- Premium Plus Tier -->
            <div class="md3-card">
                <h3 class="text-xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">Premium Plus</h3>
                <p class="text-3xl font-bold mb-4" style="color: var(--md-sys-color-on-surface);">$10<span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">/mo</span></p>
                <ul class="space-y-2 mb-6" style="color: var(--md-sys-color-on-surface-variant);">
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> Everything in Premium</li>
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> Scripting engine</li>
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> Advanced analytics</li>
                    <li class="flex items-center"><md-icon style="color: var(--md-sys-color-primary); font-size: 18px; margin-right: 0.5rem;">check</md-icon> 2x API rate limits</li>
                </ul>
                <md-filled-tonal-button class="w-full" href="/Auth/Register">
                    Start Free Trial
                </md-filled-tonal-button>
            </div>
        </div>
    </div>
</div>
