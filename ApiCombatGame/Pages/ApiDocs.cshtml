@page "/api-docs/v1"
@model ApiCombatGame.Pages.ApiDocsModel
@{
    ViewData["Title"] = "API Documentation";
}

<style>
    /* Smooth scroll for anchor links */
    html { scroll-behavior: smooth; }
    /* Animate details open/close */
    details[open] > summary ~ * { animation: slideDown 0.15s ease-out; }
    @@keyframes slideDown { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
    /* TOC active state */
    .toc-link.active { color: #3b82f6; border-left-color: #3b82f6; }
    /* Copy button feedback */
    .copy-done .copy-icon { display: none; }
    .copy-done .check-icon { display: block !important; }
</style>

@* ==================== FULL-WIDTH DOCS BANNER ==================== *@
<div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 -mt-8 mb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-white/10 text-white/80 text-xs font-medium mb-3">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                    v1 &middot; OpenAPI 3.0
                </div>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-2">
                    API Documentation
                </h1>
                <p class="text-blue-100 max-w-xl text-sm sm:text-base">
                    The API <strong class="text-white">is</strong> the game. Build your own client, configure strategies, and compete through HTTP requests.
                </p>
            </div>
            <div class="flex gap-3 shrink-0">
                <a href="#quick-start" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white text-blue-700 font-medium text-sm hover:bg-blue-50 transition-colors">
                    Quick Start
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </a>
                <a href="/openapi/v1.json" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-white/30 text-white hover:bg-white/10 font-medium text-sm transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    OpenAPI Spec
                </a>
            </div>
        </div>
        @* Stats bar *@
        <div class="flex flex-wrap gap-6 mt-6 pt-6 border-t border-white/20 text-sm text-blue-100">
            <span>@Model.TagGroups.Count endpoint groups</span>
            <span>@Model.TagGroups.Sum(g => g.Endpoints.Count) endpoints</span>
            <span>@Model.Schemas.Count models</span>
            <span>JWT Bearer auth</span>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    @* ==================== QUICK START ==================== *@
    <div id="quick-start" class="py-16 border-b border-gray-200 dark:border-gray-700 scroll-mt-20">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white text-center mb-2">Quick Start</h2>
        <p class="text-center text-gray-500 dark:text-gray-400 mb-10">Go from zero to your first battle in 6 API calls.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @{
                var steps = new[] {
                    ("1", "Register", "POST /api/v1/auth/register", "Create an account with username, email, and password. Get your JWT token.", "#3b82f6"),
                    ("2", "Browse Units", "GET /api/v1/player/roster/available", "Explore the unit shop. Five classes, each with unique abilities.", "#8b5cf6"),
                    ("3", "Unlock Units", "POST /api/v1/player/roster/unlock", "Spend your starting 1000 currency to recruit combatants.", "#06b6d4"),
                    ("4", "Build a Team", "POST /api/v1/team/configure", "Assemble up to 5 units with a declarative battle strategy.", "#10b981"),
                    ("5", "Enter Battle", "POST /api/v1/battle/queue", "Queue for matchmaking. The system pairs you by Elo rating.", "#ef4444"),
                    ("6", "Check Results", "GET /api/v1/battle/results/{id}", "Get the full turn-by-turn combat log and rewards.", "#f59e0b")
                };
            }
            @foreach (var (num, title, endpoint, desc, color) in steps)
            {
                <div class="relative bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition-shadow">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white" style="background-color: @color;">@num</span>
                        <h3 class="font-semibold text-gray-900 dark:text-white">@title</h3>
                    </div>
                    <code class="text-xs font-mono block mb-2 text-gray-500 dark:text-gray-400">@endpoint</code>
                    <p class="text-sm text-gray-600 dark:text-gray-400">@desc</p>
                </div>
            }
        </div>
    </div>

    @* ==================== AUTHENTICATION ==================== *@
    <div id="authentication" class="py-16 border-b border-gray-200 dark:border-gray-700 scroll-mt-20">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Authentication</h2>
        <p class="text-gray-500 dark:text-gray-400 mb-6">Most endpoints require a JWT Bearer token. Here's how it works:</p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">1</span>
                    <div>
                        <p class="font-medium text-gray-900 dark:text-white">Register or Login</p>
                        <p class="text-sm text-gray-500 dark:text-gray-400">POST to <code class="text-xs bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded">/api/v1/auth/register</code> or <code class="text-xs bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded">/api/v1/auth/login</code></p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">2</span>
                    <div>
                        <p class="font-medium text-gray-900 dark:text-white">Save Your Token</p>
                        <p class="text-sm text-gray-500 dark:text-gray-400">The response includes a JWT <code class="text-xs bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded">token</code> valid for 60 minutes.</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">3</span>
                    <div>
                        <p class="font-medium text-gray-900 dark:text-white">Include in All Requests</p>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Add the header <code class="text-xs bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded">Authorization: Bearer &lt;token&gt;</code></p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">4</span>
                    <div>
                        <p class="font-medium text-gray-900 dark:text-white">Refresh Before Expiry</p>
                        <p class="text-sm text-gray-500 dark:text-gray-400">POST to <code class="text-xs bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded">/api/v1/auth/refresh</code> for a new token.</p>
                    </div>
                </div>
            </div>
            <div class="relative group/code">
                <span class="absolute top-2 left-3 text-xs font-medium text-gray-400 uppercase tracking-wide">Example</span>
                <button onclick="copyToClipboard(document.getElementById('auth-example').textContent, this)"
                        class="absolute top-2 right-2 p-1.5 rounded-md bg-gray-700/50 text-gray-400 hover:text-white hover:bg-gray-600/50 opacity-0 group-hover/code:opacity-100 transition-all"
                        title="Copy to clipboard">
                    <svg class="w-4 h-4 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    <svg class="w-4 h-4 check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </button>
                <pre id="auth-example" class="bg-gray-900 dark:bg-gray-950 rounded-lg p-4 pt-8 overflow-x-auto text-sm"><code class="text-gray-100"><span class="text-gray-400"># Register</span>
curl -X POST /api/v1/auth/register \
  -H "Content-Type: application/json" \
  -d '{"username":"ShadowBlade","email":"me@example.com","password":"str0ngP@ss"}'

<span class="text-gray-400"># Use the returned token</span>
curl /api/v1/player/profile \
  -H "Authorization: Bearer eyJhbGciOiJIUzI1NiIs..."</code></pre>
            </div>
        </div>
    </div>

    @* ==================== MAIN CONTENT: TOC + API REFERENCE ==================== *@
    <div id="api-reference" class="py-16 scroll-mt-20">
        <div class="flex gap-8">

            @* Sticky Table of Contents sidebar *@
            <nav class="hidden lg:block w-56 shrink-0">
                <div class="sticky top-24 space-y-1">
                    <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-3">API Reference</p>

                    @* Search filter *@
                    <div class="relative mb-4">
                        <svg class="absolute left-2.5 top-2.5 w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        <input type="text" id="endpoint-search" placeholder="Filter endpoints..."
                               class="w-full pl-8 pr-3 py-2 text-xs rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-blue-500" />
                    </div>

                    @foreach (var group in Model.TagGroups)
                    {
                        var anchorId = group.Name.ToLower().Replace(" ", "-");
                        <a href="#@anchorId"
                           class="toc-link block px-3 py-1.5 text-sm rounded-md border-l-2 border-transparent text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
                           data-section="@anchorId">
                            @group.Name
                            <span class="text-xs text-gray-400">(@group.Endpoints.Count)</span>
                        </a>
                    }

                    <div class="pt-4 border-t border-gray-200 dark:border-gray-700 mt-4">
                        <a href="#schemas" class="toc-link block px-3 py-1.5 text-sm rounded-md border-l-2 border-transparent text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors" data-section="schemas">
                            Models
                        </a>
                    </div>
                </div>
            </nav>

            @* API Reference content *@
            <div class="flex-1 min-w-0 space-y-16">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Endpoints</h2>
                    <div class="flex gap-2">
                        <button onclick="document.querySelectorAll('#api-reference details').forEach(d => d.open = true)" class="text-xs px-3 py-1.5 rounded-md border border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                            Expand All
                        </button>
                        <button onclick="document.querySelectorAll('#api-reference details').forEach(d => d.open = false)" class="text-xs px-3 py-1.5 rounded-md border border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                            Collapse All
                        </button>
                    </div>
                </div>

                @foreach (var group in Model.TagGroups)
                {
                    <partial name="ApiDocs/_EndpointGroup" model="group" />
                }

                @* ==================== MODELS/SCHEMAS ==================== *@
                @if (Model.Schemas.Any())
                {
                    <section id="schemas" class="scroll-mt-24">
                        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Models</h2>
                        <div class="space-y-4">
                            @foreach (var (name, schema) in Model.Schemas.Where(s => s.Value.Properties.Any()))
                            {
                                <details class="group bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
                                    <summary class="flex items-center gap-3 px-5 py-3 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                                        <span class="text-xs px-2 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400 font-mono">object</span>
                                        <span class="font-mono text-sm font-semibold text-gray-900 dark:text-white">@name</span>
                                        <span class="text-xs text-gray-400">@schema.Properties.Count properties</span>
                                        <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180 ml-auto shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                        </svg>
                                    </summary>
                                    <div class="px-5 pb-4 border-t border-gray-100 dark:border-gray-700 pt-3">
                                        @if (!string.IsNullOrEmpty(schema.Description))
                                        {
                                            <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">@schema.Description</p>
                                        }
                                        <partial name="ApiDocs/_SchemaTable" model="schema" />
                                    </div>
                                </details>
                            }

                            @* Enums *@
                            @foreach (var (name, schema) in Model.Schemas.Where(s => s.Value.EnumValues?.Any() == true))
                            {
                                <details class="group bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
                                    <summary class="flex items-center gap-3 px-5 py-3 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                                        <span class="text-xs px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 font-mono">enum</span>
                                        <span class="font-mono text-sm font-semibold text-gray-900 dark:text-white">@name</span>
                                        <span class="text-xs text-gray-400">@schema.EnumValues!.Count values</span>
                                        <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180 ml-auto shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                        </svg>
                                    </summary>
                                    <div class="px-5 pb-4 border-t border-gray-100 dark:border-gray-700 pt-3">
                                        <div class="flex flex-wrap gap-2">
                                            @foreach (var val in schema.EnumValues!)
                                            {
                                                <span class="text-sm px-2.5 py-1 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-mono">@val</span>
                                            }
                                        </div>
                                    </div>
                                </details>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // TOC scroll tracking
        (function() {
            const sections = document.querySelectorAll('section[id], div[id]');
            const tocLinks = document.querySelectorAll('.toc-link');

            function updateActiveToc() {
                let current = '';
                sections.forEach(section => {
                    const rect = section.getBoundingClientRect();
                    if (rect.top <= 150) current = section.id;
                });
                tocLinks.forEach(link => {
                    link.classList.toggle('active', link.dataset.section === current);
                });
            }

            window.addEventListener('scroll', updateActiveToc, { passive: true });
            updateActiveToc();
        })();

        // Endpoint search/filter
        (function() {
            const searchInput = document.getElementById('endpoint-search');
            if (!searchInput) return;

            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                document.querySelectorAll('#api-reference details').forEach(detail => {
                    const summary = detail.querySelector('summary');
                    if (!summary) return;
                    const text = summary.textContent.toLowerCase();
                    detail.style.display = !query || text.includes(query) ? '' : 'none';
                });
                // Show/hide empty sections
                document.querySelectorAll('#api-reference section').forEach(section => {
                    const visibleEndpoints = section.querySelectorAll('details:not([style*="display: none"])');
                    const isSchemas = section.id === 'schemas';
                    if (!isSchemas) {
                        section.style.display = !query || visibleEndpoints.length > 0 ? '' : 'none';
                    }
                });
            });
        })();

        // Enhanced copy button with visual feedback
        function copyToClipboard(text, button) {
            navigator.clipboard.writeText(text.trim()).then(() => {
                button.classList.add('copy-done');
                setTimeout(() => button.classList.remove('copy-done'), 2000);
            });
        }
    </script>
}
