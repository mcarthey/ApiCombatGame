@page "/api-docs/v1"
@model ApiCombatGame.Pages.ApiDocsModel
@{
    ViewData["Title"] = "API Documentation";
    ViewData["Description"] = "Complete API reference for API Combat Game. Browse endpoints, view request/response examples, and learn how to build your own game client.";
}

<style>
    /* Smooth scroll for anchor links */
    html { scroll-behavior: smooth; }
    /* Animate details open/close */
    details[open] > summary ~ * { animation: slideDown 0.15s ease-out; }
    @@keyframes slideDown { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
    /* TOC active state */
    .toc-link.active { color: var(--md-sys-color-primary); border-left-color: var(--md-sys-color-primary); }
    /* Copy button feedback */
    .copy-done .copy-icon { display: none; }
    .copy-done .check-icon { display: block !important; }
</style>

@* ==================== FULL-WIDTH DOCS BANNER ==================== *@
<div style="background: linear-gradient(135deg, #1e40af, #0f766e);" class="-mt-8 mb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <div class="inline-flex items-center gap-2 px-2.5 py-0.5" style="border-radius: var(--md-sys-shape-corner-large); background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.8); font-size: 0.75rem; font-weight: 500;">
                    <span class="material-symbols-outlined" style="font-size: 14px; width: 14px; height: 14px; color: inherit;">code</span>
                    v1 &middot; OpenAPI 3.0
                </div>
                <h1 class="text-3xl sm:text-4xl font-extrabold mb-2" style="color: #ffffff;">
                    API Documentation
                </h1>
                <p class="max-w-xl text-sm sm:text-base" style="color: rgba(255,255,255,0.85);">
                    The API <strong style="color: #ffffff;">is</strong> the game. Build your own client, configure strategies, and compete through HTTP requests.
                </p>
            </div>
            <div class="flex gap-3 shrink-0">
                <a href="#try-it-now" class="md3-btn-filled" style="text-decoration: none;">
                    <span class="material-symbols-outlined">arrow_downward</span>
                    Try It Now
                </a>
                <a href="/openapi/v1.json" target="_blank" class="md3-btn-outlined" style="text-decoration: none; border-color: rgba(255,255,255,0.4); color: #ffffff;">
                    <span class="material-symbols-outlined">download</span>
                    OpenAPI Spec
                </a>
            </div>
        </div>
        @* Stats bar *@
        <div class="flex flex-wrap gap-6 mt-6 pt-6 text-sm" style="border-top: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.85);">
            <span>@Model.TagGroups.Count endpoint groups</span>
            <span>@Model.TagGroups.Sum(g => g.Endpoints.Count) endpoints</span>
            <span>@Model.Schemas.Count models</span>
            <span>JWT Bearer auth</span>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    @* ==================== NEW TO APIS? ==================== *@
    <div id="new-to-apis" class="pt-16 pb-8 scroll-mt-20">
        <div class="p-6 rounded-2xl" style="background: color-mix(in srgb, var(--md-sys-color-primary) 5%, var(--md-sys-color-surface-container-low)); border: 1px solid color-mix(in srgb, var(--md-sys-color-primary) 15%, var(--md-sys-color-outline-variant));">
            <div class="flex items-start gap-4">
                <span class="material-symbols-outlined shrink-0 mt-0.5" style="color: var(--md-sys-color-primary); font-size: 28px;">school</span>
                <div>
                    <h3 class="text-lg font-bold mb-2" style="color: var(--md-sys-color-on-surface);">New to APIs?</h3>
                    <p class="text-sm mb-3" style="color: var(--md-sys-color-on-surface-variant); line-height: 1.7;">
                        An <strong>API</strong> (Application Programming Interface) is how programs talk to each other over the internet.
                        Instead of clicking buttons in a browser, you send <strong>HTTP requests</strong> (like <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: 4px;">GET</code>,
                        <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: 4px;">POST</code>) to URLs and receive
                        <strong>JSON</strong> responses — structured data your code can read.
                    </p>
                    <p class="text-sm mb-3" style="color: var(--md-sys-color-on-surface-variant); line-height: 1.7;">
                        In this game, <strong>every action is an API call</strong>. You'll use a tool like
                        <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: 4px;">curl</code>, Postman, or your own code
                        to register, build teams, and battle other players. A <strong>JWT token</strong> is like a temporary password — you get one when you log in
                        and include it with every request so the server knows who you are.
                    </p>
                    <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant); line-height: 1.7;">
                        Don't worry about memorizing endpoints. Every response includes <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: 4px;">_links</code>
                        that tell you where to go next — just follow them.
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* ==================== TRY IT NOW ==================== *@
    <div id="try-it-now" class="py-16 scroll-mt-20" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h2 class="text-2xl font-bold text-center mb-2" style="color: var(--md-sys-color-on-surface);">Try It Now</h2>
        <p class="text-center mb-10" style="color: var(--md-sys-color-on-surface-variant);">No account needed. Copy any command below into your terminal and hit enter.</p>

        <div class="space-y-6 max-w-3xl mx-auto">
            @{
                var tryBaseUrl = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}";
                var tryItCommands = new[] {
                    ("trophy", "See the Leaderboard", $"curl {tryBaseUrl}/api/v1/leaderboard?limit=5", "Real players, real rankings. This is live data.", "try-leaderboard"),
                    ("monitoring", "Check Game Status", $"curl {tryBaseUrl}/api/v1/sdk/status", "Player count, active seasons, total battles — proof the game is alive.", "try-status"),
                    ("store", "Browse Strategies", $"curl {tryBaseUrl}/api/v1/strategies/browse?limit=3", "Community-created battle strategies with win rates and ratings.", "try-strategies")
                };
            }
            @foreach (var (icon, title, command, desc, codeId) in tryItCommands)
            {
                <div class="md3-card p-5 stat-card">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); font-size: 22px;">@icon</span>
                        <h3 class="font-semibold" style="color: var(--md-sys-color-on-surface);">@title</h3>
                    </div>
                    <div class="relative group/code">
                        <button class="md3-btn-icon absolute top-1 right-1 opacity-0 group-hover/code:opacity-100 transition-all"
                                onclick="copyToClipboard(document.getElementById('@codeId').textContent, this)"
                                title="Copy to clipboard">
                            <span class="material-symbols-outlined copy-icon">content_copy</span>
                            <span class="material-symbols-outlined check-icon hidden">check</span>
                        </button>
                        <pre id="@codeId" class="p-4 overflow-x-auto text-sm" style="background: var(--md-sys-color-inverse-surface); color: var(--md-sys-color-inverse-on-surface); border-radius: var(--md-sys-shape-corner-large);"><code>@command</code></pre>
                    </div>
                    <p class="text-sm mt-2" style="color: var(--md-sys-color-on-surface-variant);">@desc</p>
                </div>
            }
        </div>

        <p class="text-center mt-8 text-sm" style="color: var(--md-sys-color-on-surface-variant);">
            Like what you see? <a href="#quick-start" style="color: var(--md-sys-color-primary);">Register below</a> to start battling.
        </p>
    </div>

    @* ==================== QUICK START ==================== *@
    <div id="quick-start" class="py-16 scroll-mt-20" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h2 class="text-2xl font-bold text-center mb-2" style="color: var(--md-sys-color-on-surface);">Quick Start</h2>
        <p class="text-center mb-10" style="color: var(--md-sys-color-on-surface-variant);">Go from zero to your first battle in 6 API calls.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @{
                var steps = new[] {
                    ("1", "Register", "POST /api/v1/auth/register", "Create an account with username, email, and password. Get your JWT token.", "#3b82f6"),
                    ("2", "Browse Units", "GET /api/v1/player/roster/available", "Explore the unit shop. You start with 3 free units across five classes.", "#8b5cf6"),
                    ("3", "Unlock Units", "POST /api/v1/player/roster/unlock", "Spend your starting 1000 currency to add to your roster.", "#06b6d4"),
                    ("4", "Build a Team", "POST /api/v1/team/configure", "Assemble up to 5 units with a declarative battle strategy.", "#10b981"),
                    ("5", "Enter Battle", "POST /api/v1/battle/queue", "Queue for matchmaking. The system pairs you by API rating.", "#ef4444"),
                    ("6", "Check Results", "GET /api/v1/battle/results/{id}", "Get the full turn-by-turn combat log and rewards.", "#f59e0b")
                };
            }
            @foreach (var (num, title, endpoint, desc, color) in steps)
            {
                <div class="md3-card relative p-5 stat-card">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="w-7 h-7 flex items-center justify-center text-xs font-bold" style="border-radius: 50%; background-color: @color; color: #fff;">@num</span>
                        <h3 class="font-semibold" style="color: var(--md-sys-color-on-surface);">@title</h3>
                    </div>
                    <code class="text-xs font-mono block mb-2" style="color: var(--md-sys-color-on-surface-variant);">@endpoint</code>
                    <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">@desc</p>
                </div>
            }
        </div>
    </div>

    @* ==================== AUTHENTICATION ==================== *@
    <div id="authentication" class="py-16 scroll-mt-20" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h2 class="text-2xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">Authentication</h2>
        <p class="mb-6" style="color: var(--md-sys-color-on-surface-variant);">Most endpoints require a JWT Bearer token. Here's how it works:</p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" style="border-radius: 50%; background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container);">1</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Register or Login</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">POST to <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">/api/v1/auth/register</code> or <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">/api/v1/auth/login</code></p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" style="border-radius: 50%; background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container);">2</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Save Your Token</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">The response includes a JWT <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">token</code> valid for 60 minutes.</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" style="border-radius: 50%; background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container);">3</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Include in All Requests</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Add the header <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">Authorization: Bearer &lt;token&gt;</code></p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" style="border-radius: 50%; background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container);">4</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Refresh Before Expiry</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">POST to <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">/api/v1/auth/refresh</code> for a new token.</p>
                    </div>
                </div>
            </div>
            <div class="relative group/code">
                <span class="absolute top-2 left-3 text-xs font-medium uppercase tracking-wide" style="color: var(--md-sys-color-on-surface-variant);">Example</span>
                <button class="md3-btn-icon absolute top-1 right-1 opacity-0 group-hover/code:opacity-100 transition-all"
                        onclick="copyToClipboard(document.getElementById('auth-example').textContent, this)"
                        title="Copy to clipboard">
                    <span class="material-symbols-outlined copy-icon">content_copy</span>
                    <span class="material-symbols-outlined check-icon hidden">check</span>
                </button>
                <pre id="auth-example" class="p-4 pt-8 overflow-x-auto text-sm" style="background: var(--md-sys-color-inverse-surface); color: var(--md-sys-color-inverse-on-surface); border-radius: var(--md-sys-shape-corner-large);"><code><span style="color: var(--md-sys-color-on-surface-variant);"># Register</span>
curl -X POST /api/v1/auth/register \
  -H "Content-Type: application/json" \
  -d '{"username":"ShadowBlade","email":"me@@example.com","password":"str0ngP@@ss"}'

<span style="color: var(--md-sys-color-on-surface-variant);"># Use the returned token</span>
curl /api/v1/player/profile \
  -H "Authorization: Bearer eyJhbGciOiJIUzI1NiIs..."</code></pre>
            </div>
        </div>
    </div>

    @* ==================== FOLLOWING THE LINKS ==================== *@
    <div id="links" class="py-16 scroll-mt-20" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h2 class="text-2xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">Following the Links</h2>
        <p class="mb-6" style="color: var(--md-sys-color-on-surface-variant);">Every response includes <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">_links</code> — related endpoints you can follow without memorizing URLs.</p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined shrink-0 mt-0.5" style="color: var(--md-sys-color-primary); font-size: 20px;">link</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Self-Discoverable</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">After a battle, the result links to the replay, both players' profiles, and a shortcut to queue again. No docs lookup required.</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined shrink-0 mt-0.5" style="color: var(--md-sys-color-primary); font-size: 20px;">explore</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Navigate Naturally</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Your profile links to your roster, teams, achievements, and the leaderboard. Each team links to the battle queue. Just follow the chain.</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined shrink-0 mt-0.5" style="color: var(--md-sys-color-primary); font-size: 20px;">code</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Method Included</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Each link includes <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: 4px;">method</code> (GET, POST, etc.) so your client knows exactly how to call it.</p>
                    </div>
                </div>
            </div>
            <div class="relative group/code">
                <span class="absolute top-2 left-3 text-xs font-medium uppercase tracking-wide" style="color: var(--md-sys-color-on-surface-variant);">Example Response</span>
                <pre class="p-4 pt-8 overflow-x-auto text-sm" style="background: var(--md-sys-color-inverse-surface); color: var(--md-sys-color-inverse-on-surface); border-radius: var(--md-sys-shape-corner-large);"><code>{
  "battleId": "f47ac10b-...",
  "winnerId": "a1b2c3d4-...",
  "rewards": { "currency": 150, "ratingChange": 24 },
  <span style="color: #60a5fa;">"_links"</span>: {
    <span style="color: #60a5fa;">"self"</span>:        { "href": "/api/v1/battle/results/f47ac...", "method": "GET" },
    <span style="color: #60a5fa;">"replay"</span>:      { "href": "/api/v1/replays/f47ac...", "method": "GET" },
    <span style="color: #60a5fa;">"queue_again"</span>: { "href": "/api/v1/battle/queue", "method": "POST" }
  }
}</code></pre>
            </div>
        </div>
    </div>

    @* ==================== STRATEGY GUIDE ==================== *@
    <div id="strategy-guide" class="py-16 scroll-mt-20" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h2 class="text-2xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">Strategy Guide</h2>
        <p class="mb-8" style="color: var(--md-sys-color-on-surface-variant);">The <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">strategy</code> field on your team is <strong>optional</strong>. Without one, units use default AI. With one, you control exactly how they fight.</p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="space-y-6">
                @* Formations *@
                <div>
                    <h3 class="font-semibold mb-3 flex items-center gap-2" style="color: var(--md-sys-color-on-surface);">
                        <span class="material-symbols-outlined" style="font-size: 20px; color: #10b981;">shield</span>
                        Formations
                    </h3>
                    <div class="overflow-hidden" style="border-radius: var(--md-sys-shape-corner-medium);">
                        <table class="md3-table w-full text-sm">
                            <thead>
                                <tr>
                                    <th class="px-4 py-2 text-left text-xs font-medium uppercase">Value</th>
                                    <th class="px-4 py-2 text-left text-xs font-medium uppercase">Effect</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (val, desc) in Model.FormationValues)
                                {
                                    <tr><td class="px-4 py-2.5 font-mono text-xs">@val</td><td class="px-4 py-2.5 text-xs" style="color: var(--md-sys-color-on-surface-variant);">@desc</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Target Priority *@
                <div>
                    <h3 class="font-semibold mb-3 flex items-center gap-2" style="color: var(--md-sys-color-on-surface);">
                        <span class="material-symbols-outlined" style="font-size: 20px; color: #ef4444;">target</span>
                        Target Priority
                    </h3>
                    <p class="text-sm mb-3" style="color: var(--md-sys-color-on-surface-variant);">An ordered array evaluated top-to-bottom. Units attack the first matching target.</p>
                    <div class="overflow-hidden" style="border-radius: var(--md-sys-shape-corner-medium);">
                        <table class="md3-table w-full text-sm">
                            <thead>
                                <tr>
                                    <th class="px-4 py-2 text-left text-xs font-medium uppercase">Value</th>
                                    <th class="px-4 py-2 text-left text-xs font-medium uppercase">Targets</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (val, desc) in Model.TargetPriorityValues)
                                {
                                    <tr><td class="px-4 py-2.5 font-mono text-xs">@val</td><td class="px-4 py-2.5 text-xs" style="color: var(--md-sys-color-on-surface-variant);">@desc</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Ability Conditions *@
                <div>
                    <h3 class="font-semibold mb-3 flex items-center gap-2" style="color: var(--md-sys-color-on-surface);">
                        <span class="material-symbols-outlined" style="font-size: 20px; color: #8b5cf6;">bolt</span>
                        Ability Rules
                    </h3>
                    <p class="text-sm mb-3" style="color: var(--md-sys-color-on-surface-variant);">A dictionary keyed by ability name. Each rule has a <code class="text-xs px-1 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">when</code> condition and a <code class="text-xs px-1 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">target</code>.</p>
                    <div class="overflow-hidden mb-3" style="border-radius: var(--md-sys-shape-corner-medium);">
                        <table class="md3-table w-full text-sm">
                            <thead><tr><th class="px-4 py-2 text-left text-xs font-medium uppercase">when</th><th class="px-4 py-2 text-left text-xs font-medium uppercase">Fires if...</th></tr></thead>
                            <tbody>
                                @foreach (var (val, desc) in Model.WhenConditionValues)
                                {
                                    <tr><td class="px-4 py-2.5 font-mono text-xs">@val</td><td class="px-4 py-2.5 text-xs" style="color: var(--md-sys-color-on-surface-variant);">@desc</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="overflow-hidden" style="border-radius: var(--md-sys-shape-corner-medium);">
                        <table class="md3-table w-full text-sm">
                            <thead><tr><th class="px-4 py-2 text-left text-xs font-medium uppercase">target</th><th class="px-4 py-2 text-left text-xs font-medium uppercase">Hits...</th></tr></thead>
                            <tbody>
                                @foreach (var (val, desc) in Model.TargetModeValues)
                                {
                                    <tr><td class="px-4 py-2.5 font-mono text-xs">@val</td><td class="px-4 py-2.5 text-xs" style="color: var(--md-sys-color-on-surface-variant);">@desc</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* Full example *@
            <div>
                <h3 class="font-semibold mb-3 flex items-center gap-2" style="color: var(--md-sys-color-on-surface);">
                    <span class="material-symbols-outlined" style="font-size: 20px; color: #f59e0b;">code</span>
                    Full Example
                </h3>
                <div class="relative group/code">
                    <button class="md3-btn-icon absolute top-1 right-1 opacity-0 group-hover/code:opacity-100 transition-all"
                            onclick="copyToClipboard(document.getElementById('strategy-example').textContent, this)"
                            title="Copy to clipboard">
                        <span class="material-symbols-outlined copy-icon">content_copy</span>
                        <span class="material-symbols-outlined check-icon hidden">check</span>
                    </button>
                    <pre id="strategy-example" class="p-4 overflow-x-auto text-sm" style="background: var(--md-sys-color-inverse-surface); color: var(--md-sys-color-inverse-on-surface); border-radius: var(--md-sys-shape-corner-large);"><code>{
  "name": "404 Fighters",
  "unitIds": ["unit-id-1", "unit-id-2", "..."],
  "strategy": {
    "formation": "balanced",
    "targetPriority": ["healers", "lowest_hp"],
    "abilities": {
      "Fireball": {
        "when": "always",
        "target": "priority"
      },
      "Meteor Storm": {
        "when": "enemy_count_gte_2",
        "target": "all_enemies"
      },
      "Fortify": {
        "when": "ally_hp_below_50",
        "target": "self"
      }
    }
  }
}</code></pre>
                </div>
                <div class="mt-4 p-4 md3-card" style="border: 1px solid var(--md-sys-color-outline-variant);">
                    <p class="text-sm font-medium mb-2" style="color: var(--md-sys-color-on-surface);">What this does:</p>
                    <ul class="text-sm space-y-1" style="color: var(--md-sys-color-on-surface-variant);">
                        <li class="flex items-start gap-2"><span style="color: #10b981;">&#8226;</span> Balanced formation &mdash; no stat bonuses, no penalties</li>
                        <li class="flex items-start gap-2"><span style="color: #ef4444;">&#8226;</span> Kill enemy healers first, then focus lowest HP</li>
                        <li class="flex items-start gap-2"><span style="color: #8b5cf6;">&#8226;</span> Fireball fires every turn at the priority target</li>
                        <li class="flex items-start gap-2"><span style="color: #f59e0b;">&#8226;</span> Meteor Storm (AoE) only fires when 2+ enemies remain</li>
                        <li class="flex items-start gap-2"><span style="color: #3b82f6;">&#8226;</span> Fortify self-heals when any ally drops below 50% HP</li>
                    </ul>
                </div>
                <p class="mt-4 text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                    <strong>Tip:</strong> Start simple &mdash; just <code class="text-xs px-1 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">formation</code> and <code class="text-xs px-1 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">targetPriority</code> go a long way. Add ability rules later once you see how battles play out.
                </p>
            </div>
        </div>
    </div>

    @* ==================== WHAT'S NEXT? ==================== *@
    <div id="whats-next" class="py-16 scroll-mt-20" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h2 class="text-2xl font-bold text-center mb-2" style="color: var(--md-sys-color-on-surface);">What's Next After Your First Battle?</h2>
        <p class="text-center mb-10" style="color: var(--md-sys-color-on-surface-variant);">You've got the basics. Here's where the game really opens up.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="md3-card p-5 stat-card">
                <span class="material-symbols-outlined mb-3" style="color: #f97316; font-size: 28px;">flag</span>
                <h3 class="font-semibold mb-1" style="color: var(--md-sys-color-on-surface);">Daily Challenges</h3>
                <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Complete daily objectives for bonus gold and XP. New challenges every 24 hours.</p>
                <code class="text-xs mt-2 block" style="color: var(--md-sys-color-on-surface-variant);">GET /api/v1/challenges/daily</code>
            </div>
            <div class="md3-card p-5 stat-card">
                <span class="material-symbols-outlined mb-3" style="color: #f59e0b; font-size: 28px;">groups</span>
                <h3 class="font-semibold mb-1" style="color: var(--md-sys-color-on-surface);">Join a Guild</h3>
                <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Team up with other players to tackle cooperative boss raids and earn shared rewards.</p>
                <code class="text-xs mt-2 block" style="color: var(--md-sys-color-on-surface-variant);">POST /api/v1/guild/create</code>
            </div>
            <div class="md3-card p-5 stat-card">
                <span class="material-symbols-outlined mb-3" style="color: #a855f7; font-size: 28px;">star</span>
                <h3 class="font-semibold mb-1" style="color: var(--md-sys-color-on-surface);">Unit Mastery</h3>
                <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">The more you battle with a unit, the stronger your bond. Track mastery across all classes.</p>
                <code class="text-xs mt-2 block" style="color: var(--md-sys-color-on-surface-variant);">GET /api/v1/mastery/progress</code>
            </div>
            <div class="md3-card p-5 stat-card">
                <span class="material-symbols-outlined mb-3" style="color: #ef4444; font-size: 28px;">trophy</span>
                <h3 class="font-semibold mb-1" style="color: var(--md-sys-color-on-surface);">Climb the Ranks</h3>
                <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Climb the API leaderboard from Rubber Duck to "I Use Arch btw." Can you reach the top?</p>
                <code class="text-xs mt-2 block" style="color: var(--md-sys-color-on-surface-variant);">GET /api/v1/leaderboard</code>
            </div>
        </div>
    </div>

    @* ==================== MAIN CONTENT: TOC + API REFERENCE ==================== *@
    <div id="api-reference" class="py-16 scroll-mt-20">
        <div class="flex gap-8">

            @* Sticky Table of Contents sidebar *@
            <nav class="hidden lg:block w-56 shrink-0">
                <div class="sticky top-24 space-y-1 overflow-y-auto" style="max-height: calc(100vh - 7rem);">
                    <p class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--md-sys-color-on-surface-variant);">API Reference</p>

                    @* Search filter *@
                    <div class="mb-4">
                        <div class="md3-input-wrapper" style="width: 100%;">
                            <label for="endpoint-search">Filter endpoints...</label>
                            <input class="md3-input" id="endpoint-search" type="text" placeholder="Filter endpoints..." />
                        </div>
                    </div>

                    @foreach (var group in Model.TagGroups)
                    {
                        var anchorId = group.Name.ToLower().Replace(" ", "-");
                        <a href="#@anchorId"
                           class="toc-link block px-3 py-1.5 text-sm transition-colors"
                           style="border-left: 2px solid transparent; color: var(--md-sys-color-on-surface-variant); border-radius: 0 var(--md-sys-shape-corner-small) var(--md-sys-shape-corner-small) 0;"
                           data-section="@anchorId">
                            @group.Name
                            <span class="text-xs" style="color: var(--md-sys-color-outline);">(@group.Endpoints.Count)</span>
                        </a>
                    }

                    <div class="pt-4 mt-4" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
                        <a href="#schemas" class="toc-link block px-3 py-1.5 text-sm transition-colors"
                           style="border-left: 2px solid transparent; color: var(--md-sys-color-on-surface-variant); border-radius: 0 var(--md-sys-shape-corner-small) var(--md-sys-shape-corner-small) 0;"
                           data-section="schemas">
                            Models
                        </a>
                    </div>
                </div>
            </nav>

            @* API Reference content *@
            <div class="flex-1 min-w-0 space-y-16">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">Endpoints</h2>
                    <div class="flex gap-2">
                        <button class="md3-btn-outlined" onclick="document.querySelectorAll('#api-reference details').forEach(d => d.open = true)">
                            Expand All
                        </button>
                        <button class="md3-btn-outlined" onclick="document.querySelectorAll('#api-reference details').forEach(d => d.open = false)">
                            Collapse All
                        </button>
                    </div>
                </div>

                @foreach (var group in Model.TagGroups)
                {
                    <partial name="ApiDocs/_EndpointGroup" model="group" />
                }

                @* ==================== MODELS/SCHEMAS ==================== *@
                @if (Model.Schemas.Any())
                {
                    <section id="schemas" class="scroll-mt-24">
                        <h2 class="text-2xl font-bold mb-6" style="color: var(--md-sys-color-on-surface);">Models</h2>
                        <div class="space-y-4">
                            @foreach (var (name, schema) in Model.Schemas.Where(s => s.Value.Properties.Any()))
                            {
                                <details id="schema-@name" class="group md3-card overflow-hidden scroll-mt-24">
                                    <summary class="flex items-center gap-3 px-5 py-3 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                                        <span class="md3-badge-tertiary font-mono text-xs">object</span>
                                        <span class="font-mono text-sm font-semibold" style="color: var(--md-sys-color-on-surface);">@name</span>
                                        <span class="text-xs" style="color: var(--md-sys-color-outline);">@schema.Properties.Count properties</span>
                                        <span class="material-symbols-outlined ml-auto shrink-0 transition-transform group-open:rotate-180" style="color: var(--md-sys-color-on-surface-variant); font-size: 18px;">expand_more</span>
                                    </summary>
                                    <div class="px-5 pb-4 pt-3" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
                                        @if (!string.IsNullOrEmpty(schema.Description))
                                        {
                                            <p class="text-sm mb-3" style="color: var(--md-sys-color-on-surface-variant);">@schema.Description</p>
                                        }
                                        <partial name="ApiDocs/_SchemaTable" model="schema" />
                                    </div>
                                </details>
                            }

                            @* Enums *@
                            @foreach (var (name, schema) in Model.Schemas.Where(s => s.Value.EnumValues?.Any() == true))
                            {
                                <details id="schema-@name" class="group md3-card overflow-hidden scroll-mt-24">
                                    <summary class="flex items-center gap-3 px-5 py-3 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                                        <span class="text-xs px-2 py-0.5 font-mono" style="background: var(--md-sys-color-tertiary-container); color: var(--md-sys-color-on-tertiary-container); border-radius: var(--md-sys-shape-corner-small);">enum</span>
                                        <span class="font-mono text-sm font-semibold" style="color: var(--md-sys-color-on-surface);">@name</span>
                                        <span class="text-xs" style="color: var(--md-sys-color-outline);">@schema.EnumValues!.Count values</span>
                                        <span class="material-symbols-outlined ml-auto shrink-0 transition-transform group-open:rotate-180" style="color: var(--md-sys-color-on-surface-variant); font-size: 18px;">expand_more</span>
                                    </summary>
                                    <div class="px-5 pb-4 pt-3" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
                                        <div class="flex flex-wrap gap-2">
                                            @foreach (var val in schema.EnumValues!)
                                            {
                                                <span class="text-sm px-2.5 py-1 font-mono" style="background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface); border-radius: var(--md-sys-shape-corner-small);">@val</span>
                                            }
                                        </div>
                                    </div>
                                </details>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // TOC scroll tracking
        (function() {
            const sections = document.querySelectorAll('section[id], div[id]');
            const tocLinks = document.querySelectorAll('.toc-link');

            function updateActiveToc() {
                let current = '';
                sections.forEach(section => {
                    const rect = section.getBoundingClientRect();
                    if (rect.top <= 150) current = section.id;
                });
                tocLinks.forEach(link => {
                    link.classList.toggle('active', link.dataset.section === current);
                });
            }

            window.addEventListener('scroll', updateActiveToc, { passive: true });
            updateActiveToc();
        })();

        // Endpoint search/filter
        (function() {
            const searchInput = document.getElementById('endpoint-search');
            if (!searchInput) return;

            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                document.querySelectorAll('#api-reference details').forEach(detail => {
                    const summary = detail.querySelector('summary');
                    if (!summary) return;
                    const text = summary.textContent.toLowerCase();
                    detail.style.display = !query || text.includes(query) ? '' : 'none';
                });
                // Show/hide empty sections
                document.querySelectorAll('#api-reference section').forEach(section => {
                    const visibleEndpoints = section.querySelectorAll('details:not([style*="display: none"])');
                    const isSchemas = section.id === 'schemas';
                    if (!isSchemas) {
                        section.style.display = !query || visibleEndpoints.length > 0 ? '' : 'none';
                    }
                });
            });
        })();

        // Open a schema details element and scroll to it
        function openSchemaDetails(anchorId) {
            const el = document.getElementById(anchorId);
            if (el && el.tagName === 'DETAILS') {
                el.open = true;
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // Enhanced copy button with visual feedback
        function copyToClipboard(text, button) {
            navigator.clipboard.writeText(text.trim()).then(() => {
                button.classList.add('copy-done');
                setTimeout(() => button.classList.remove('copy-done'), 2000);
            });
        }
    </script>
}
