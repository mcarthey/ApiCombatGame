@page "/api-docs/v1"
@model ApiCombatGame.Pages.ApiDocsModel
@{
    ViewData["Title"] = "API Documentation";
}

<style>
    /* Smooth scroll for anchor links */
    html { scroll-behavior: smooth; }
    /* Animate details open/close */
    details[open] > summary ~ * { animation: slideDown 0.15s ease-out; }
    @@keyframes slideDown { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
    /* TOC active state */
    .toc-link.active { color: var(--md-sys-color-primary); border-left-color: var(--md-sys-color-primary); }
    /* Copy button feedback */
    .copy-done .copy-icon { display: none; }
    .copy-done .check-icon { display: block !important; }
</style>

@* ==================== FULL-WIDTH DOCS BANNER ==================== *@
<div style="background: linear-gradient(135deg, var(--md-sys-color-primary), var(--md-sys-color-tertiary-container));" class="-mt-8 mb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <div class="inline-flex items-center gap-2 px-2.5 py-0.5" style="border-radius: var(--md-sys-shape-corner-large); background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.8); font-size: 0.75rem; font-weight: 500;">
                    <span class="material-symbols-outlined" style="font-size: 14px; width: 14px; height: 14px; color: inherit;">code</span>
                    v1 &middot; OpenAPI 3.0
                </div>
                <h1 class="text-3xl sm:text-4xl font-extrabold mb-2" style="color: var(--md-sys-color-on-primary);">
                    API Documentation
                </h1>
                <p class="max-w-xl text-sm sm:text-base" style="color: rgba(255,255,255,0.85);">
                    The API <strong style="color: var(--md-sys-color-on-primary);">is</strong> the game. Build your own client, configure strategies, and compete through HTTP requests.
                </p>
            </div>
            <div class="flex gap-3 shrink-0">
                <a href="#quick-start" class="md3-btn-filled" style="text-decoration: none;">
                    <span class="material-symbols-outlined">arrow_downward</span>
                    Quick Start
                </a>
                <a href="/openapi/v1.json" target="_blank" class="md3-btn-outlined" style="text-decoration: none; border-color: rgba(255,255,255,0.4); color: var(--md-sys-color-on-primary);">
                    <span class="material-symbols-outlined">download</span>
                    OpenAPI Spec
                </a>
            </div>
        </div>
        @* Stats bar *@
        <div class="flex flex-wrap gap-6 mt-6 pt-6 text-sm" style="border-top: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.85);">
            <span>@Model.TagGroups.Count endpoint groups</span>
            <span>@Model.TagGroups.Sum(g => g.Endpoints.Count) endpoints</span>
            <span>@Model.Schemas.Count models</span>
            <span>JWT Bearer auth</span>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    @* ==================== QUICK START ==================== *@
    <div id="quick-start" class="py-16 scroll-mt-20" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h2 class="text-2xl font-bold text-center mb-2" style="color: var(--md-sys-color-on-surface);">Quick Start</h2>
        <p class="text-center mb-10" style="color: var(--md-sys-color-on-surface-variant);">Go from zero to your first battle in 6 API calls.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @{
                var steps = new[] {
                    ("1", "Register", "POST /api/v1/auth/register", "Create an account with username, email, and password. Get your JWT token.", "#3b82f6"),
                    ("2", "Browse Units", "GET /api/v1/player/roster/available", "Explore the unit shop. Five classes, each with unique abilities.", "#8b5cf6"),
                    ("3", "Unlock Units", "POST /api/v1/player/roster/unlock", "Spend your starting 1000 currency to recruit combatants.", "#06b6d4"),
                    ("4", "Build a Team", "POST /api/v1/team/configure", "Assemble up to 5 units with a declarative battle strategy.", "#10b981"),
                    ("5", "Enter Battle", "POST /api/v1/battle/queue", "Queue for matchmaking. The system pairs you by Elo rating.", "#ef4444"),
                    ("6", "Check Results", "GET /api/v1/battle/results/{id}", "Get the full turn-by-turn combat log and rewards.", "#f59e0b")
                };
            }
            @foreach (var (num, title, endpoint, desc, color) in steps)
            {
                <div class="md3-card relative p-5 stat-card">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="w-7 h-7 flex items-center justify-center text-xs font-bold" style="border-radius: 50%; background-color: @color; color: #fff;">@num</span>
                        <h3 class="font-semibold" style="color: var(--md-sys-color-on-surface);">@title</h3>
                    </div>
                    <code class="text-xs font-mono block mb-2" style="color: var(--md-sys-color-on-surface-variant);">@endpoint</code>
                    <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">@desc</p>
                </div>
            }
        </div>
    </div>

    @* ==================== AUTHENTICATION ==================== *@
    <div id="authentication" class="py-16 scroll-mt-20" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h2 class="text-2xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">Authentication</h2>
        <p class="mb-6" style="color: var(--md-sys-color-on-surface-variant);">Most endpoints require a JWT Bearer token. Here's how it works:</p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" style="border-radius: 50%; background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container);">1</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Register or Login</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">POST to <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">/api/v1/auth/register</code> or <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">/api/v1/auth/login</code></p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" style="border-radius: 50%; background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container);">2</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Save Your Token</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">The response includes a JWT <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">token</code> valid for 60 minutes.</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" style="border-radius: 50%; background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container);">3</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Include in All Requests</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Add the header <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">Authorization: Bearer &lt;token&gt;</code></p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" style="border-radius: 50%; background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container);">4</span>
                    <div>
                        <p class="font-medium" style="color: var(--md-sys-color-on-surface);">Refresh Before Expiry</p>
                        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">POST to <code class="text-xs px-1.5 py-0.5" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-small);">/api/v1/auth/refresh</code> for a new token.</p>
                    </div>
                </div>
            </div>
            <div class="relative group/code">
                <span class="absolute top-2 left-3 text-xs font-medium uppercase tracking-wide" style="color: var(--md-sys-color-on-surface-variant);">Example</span>
                <button class="md3-btn-icon absolute top-1 right-1 opacity-0 group-hover/code:opacity-100 transition-all"
                        onclick="copyToClipboard(document.getElementById('auth-example').textContent, this)"
                        title="Copy to clipboard">
                    <span class="material-symbols-outlined copy-icon">content_copy</span>
                    <span class="material-symbols-outlined check-icon hidden">check</span>
                </button>
                <pre id="auth-example" class="p-4 pt-8 overflow-x-auto text-sm" style="background: var(--md-sys-color-inverse-surface); color: var(--md-sys-color-inverse-on-surface); border-radius: var(--md-sys-shape-corner-large);"><code><span style="color: var(--md-sys-color-on-surface-variant);"># Register</span>
curl -X POST /api/v1/auth/register \
  -H "Content-Type: application/json" \
  -d '{"username":"ShadowBlade","email":"me@@example.com","password":"str0ngP@@ss"}'

<span style="color: var(--md-sys-color-on-surface-variant);"># Use the returned token</span>
curl /api/v1/player/profile \
  -H "Authorization: Bearer eyJhbGciOiJIUzI1NiIs..."</code></pre>
            </div>
        </div>
    </div>

    @* ==================== MAIN CONTENT: TOC + API REFERENCE ==================== *@
    <div id="api-reference" class="py-16 scroll-mt-20">
        <div class="flex gap-8">

            @* Sticky Table of Contents sidebar *@
            <nav class="hidden lg:block w-56 shrink-0">
                <div class="sticky top-24 space-y-1">
                    <p class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--md-sys-color-on-surface-variant);">API Reference</p>

                    @* Search filter *@
                    <div class="mb-4">
                        <div class="md3-input-wrapper" style="width: 100%;">
                            <label for="endpoint-search">Filter endpoints...</label>
                            <input class="md3-input" id="endpoint-search" type="text" placeholder="Filter endpoints..." />
                        </div>
                    </div>

                    @foreach (var group in Model.TagGroups)
                    {
                        var anchorId = group.Name.ToLower().Replace(" ", "-");
                        <a href="#@anchorId"
                           class="toc-link block px-3 py-1.5 text-sm transition-colors"
                           style="border-left: 2px solid transparent; color: var(--md-sys-color-on-surface-variant); border-radius: 0 var(--md-sys-shape-corner-small) var(--md-sys-shape-corner-small) 0;"
                           data-section="@anchorId">
                            @group.Name
                            <span class="text-xs" style="color: var(--md-sys-color-outline);">(@group.Endpoints.Count)</span>
                        </a>
                    }

                    <div class="pt-4 mt-4" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
                        <a href="#schemas" class="toc-link block px-3 py-1.5 text-sm transition-colors"
                           style="border-left: 2px solid transparent; color: var(--md-sys-color-on-surface-variant); border-radius: 0 var(--md-sys-shape-corner-small) var(--md-sys-shape-corner-small) 0;"
                           data-section="schemas">
                            Models
                        </a>
                    </div>
                </div>
            </nav>

            @* API Reference content *@
            <div class="flex-1 min-w-0 space-y-16">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">Endpoints</h2>
                    <div class="flex gap-2">
                        <button class="md3-btn-outlined" onclick="document.querySelectorAll('#api-reference details').forEach(d => d.open = true)">
                            Expand All
                        </button>
                        <button class="md3-btn-outlined" onclick="document.querySelectorAll('#api-reference details').forEach(d => d.open = false)">
                            Collapse All
                        </button>
                    </div>
                </div>

                @foreach (var group in Model.TagGroups)
                {
                    <partial name="ApiDocs/_EndpointGroup" model="group" />
                }

                @* ==================== MODELS/SCHEMAS ==================== *@
                @if (Model.Schemas.Any())
                {
                    <section id="schemas" class="scroll-mt-24">
                        <h2 class="text-2xl font-bold mb-6" style="color: var(--md-sys-color-on-surface);">Models</h2>
                        <div class="space-y-4">
                            @foreach (var (name, schema) in Model.Schemas.Where(s => s.Value.Properties.Any()))
                            {
                                <details class="group md3-card overflow-hidden">
                                    <summary class="flex items-center gap-3 px-5 py-3 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                                        <span class="md3-badge-tertiary font-mono text-xs">object</span>
                                        <span class="font-mono text-sm font-semibold" style="color: var(--md-sys-color-on-surface);">@name</span>
                                        <span class="text-xs" style="color: var(--md-sys-color-outline);">@schema.Properties.Count properties</span>
                                        <span class="material-symbols-outlined ml-auto shrink-0 transition-transform group-open:rotate-180" style="color: var(--md-sys-color-on-surface-variant); font-size: 18px;">expand_more</span>
                                    </summary>
                                    <div class="px-5 pb-4 pt-3" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
                                        @if (!string.IsNullOrEmpty(schema.Description))
                                        {
                                            <p class="text-sm mb-3" style="color: var(--md-sys-color-on-surface-variant);">@schema.Description</p>
                                        }
                                        <partial name="ApiDocs/_SchemaTable" model="schema" />
                                    </div>
                                </details>
                            }

                            @* Enums *@
                            @foreach (var (name, schema) in Model.Schemas.Where(s => s.Value.EnumValues?.Any() == true))
                            {
                                <details class="group md3-card overflow-hidden">
                                    <summary class="flex items-center gap-3 px-5 py-3 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                                        <span class="text-xs px-2 py-0.5 font-mono" style="background: var(--md-sys-color-tertiary-container); color: var(--md-sys-color-on-tertiary-container); border-radius: var(--md-sys-shape-corner-small);">enum</span>
                                        <span class="font-mono text-sm font-semibold" style="color: var(--md-sys-color-on-surface);">@name</span>
                                        <span class="text-xs" style="color: var(--md-sys-color-outline);">@schema.EnumValues!.Count values</span>
                                        <span class="material-symbols-outlined ml-auto shrink-0 transition-transform group-open:rotate-180" style="color: var(--md-sys-color-on-surface-variant); font-size: 18px;">expand_more</span>
                                    </summary>
                                    <div class="px-5 pb-4 pt-3" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
                                        <div class="flex flex-wrap gap-2">
                                            @foreach (var val in schema.EnumValues!)
                                            {
                                                <span class="text-sm px-2.5 py-1 font-mono" style="background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface); border-radius: var(--md-sys-shape-corner-small);">@val</span>
                                            }
                                        </div>
                                    </div>
                                </details>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // TOC scroll tracking
        (function() {
            const sections = document.querySelectorAll('section[id], div[id]');
            const tocLinks = document.querySelectorAll('.toc-link');

            function updateActiveToc() {
                let current = '';
                sections.forEach(section => {
                    const rect = section.getBoundingClientRect();
                    if (rect.top <= 150) current = section.id;
                });
                tocLinks.forEach(link => {
                    link.classList.toggle('active', link.dataset.section === current);
                });
            }

            window.addEventListener('scroll', updateActiveToc, { passive: true });
            updateActiveToc();
        })();

        // Endpoint search/filter
        (function() {
            const searchInput = document.getElementById('endpoint-search');
            if (!searchInput) return;

            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                document.querySelectorAll('#api-reference details').forEach(detail => {
                    const summary = detail.querySelector('summary');
                    if (!summary) return;
                    const text = summary.textContent.toLowerCase();
                    detail.style.display = !query || text.includes(query) ? '' : 'none';
                });
                // Show/hide empty sections
                document.querySelectorAll('#api-reference section').forEach(section => {
                    const visibleEndpoints = section.querySelectorAll('details:not([style*="display: none"])');
                    const isSchemas = section.id === 'schemas';
                    if (!isSchemas) {
                        section.style.display = !query || visibleEndpoints.length > 0 ? '' : 'none';
                    }
                });
            });
        })();

        // Enhanced copy button with visual feedback
        function copyToClipboard(text, button) {
            navigator.clipboard.writeText(text.trim()).then(() => {
                button.classList.add('copy-done');
                setTimeout(() => button.classList.remove('copy-done'), 2000);
            });
        }
    </script>
}
