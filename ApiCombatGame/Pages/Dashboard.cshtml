@page
@model ApiCombatGame.Pages.DashboardPageModel
@{
    ViewData["Title"] = "Dashboard";
}

@functions {
    string GetClassColor(string className) => className switch
    {
        "Warrior" => "hero-warrior",
        "Mage" => "hero-mage",
        "Ranger" => "hero-ranger",
        "Healer" => "hero-healer",
        "Tank" => "hero-tank",
        "Assassin" => "hero-assassin",
        _ => "hero-default"
    };

    string GetClassIcon(string className) => className switch
    {
        "Warrior" => "swords",
        "Mage" => "bolt",
        "Ranger" => "target",
        "Healer" => "healing",
        "Tank" => "shield",
        "Assassin" => "visibility_off",
        _ => "person"
    };

    string GetCategoryIcon(string category) => category switch
    {
        "Combat" => "swords",
        "Collection" => "collections_bookmark",
        "Social" => "group",
        "Progression" => "trending_up",
        _ => "emoji_events"
    };
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

    @* ============================================================ *@
    @* SECTION 1: Welcome Banner + Login Streak                      *@
    @* ============================================================ *@
    <div class="p-6 mb-8"
         style="background: linear-gradient(135deg, #1e40af, #6d28d9); border-radius: var(--md-sys-shape-corner-large); box-shadow: var(--md-sys-elevation-2); color: #ffffff;">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold">Welcome back, @Model.Dashboard.Username!</h1>
                <p class="mt-1" style="opacity: 0.85;">
                    Level @Model.Dashboard.Level
                    <span class="mx-2">&middot;</span>
                    @Model.Dashboard.Tier Tier
                    @if (Model.Dashboard.UnreadNotifications > 0)
                    {
                        <span class="ml-2 md3-badge-error" style="font-size: 0.75rem;">
                            @Model.Dashboard.UnreadNotifications unread
                        </span>
                    }
                </p>
            </div>
            @if (Model.Dashboard.TodayRewardClaimed)
            {
                <div class="mt-4 md:mt-0 px-4 py-2 text-center"
                     style="background: rgba(255,255,255,0.2); backdrop-filter: blur(8px); border-radius: var(--md-sys-shape-corner-medium);">
                    <div class="text-sm" style="opacity: 0.85;">Daily Streak Bonus</div>
                    <div class="text-2xl font-bold" style="color: #facc15;">+@(Model.Dashboard.TodayRewardAmount)g</div>
                    <div class="text-xs" style="opacity: 0.7;">Day @Model.Dashboard.LoginStreak of 7</div>
                </div>
            }
        </div>

        @* Streak Calendar *@
        <div class="mt-6 flex items-center justify-between gap-2">
            @foreach (var day in Model.Dashboard.StreakDays)
            {
                <div class="flex-1 text-center">
                    <div class="w-10 h-10 mx-auto flex items-center justify-center text-sm font-bold"
                         style="border-radius: 9999px;
                                @(day.IsToday
                                    ? "background: #facc15; color: #713f12; box-shadow: 0 0 0 2px #fde047, 0 0 0 4px rgba(255,255,255,0.3);"
                                    : day.IsClaimed
                                        ? "background: rgba(255,255,255,0.3); color: white;"
                                        : "background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.6);")">
                        @day.Day
                    </div>
                    <div class="text-xs mt-1 @(day.IsClaimed ? "font-semibold" : "")"
                         style="color: @(day.IsClaimed ? "#facc15" : "rgba(255,255,255,0.6)");">
                        @(day.RewardAmount)g
                    </div>
                </div>
            }
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 2: Player Status Cards                                *@
    @* ============================================================ *@
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="md3-card stat-card stat-card-xp">
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Level @Model.Dashboard.Level</div>
            <div class="md3-progress" style="margin-top: 0.5rem;"><div class="md3-progress-bar" style="width: @(Model.Dashboard.XpProgressPercent)%;"></div></div>
            <div class="text-xs mt-1" style="color: var(--md-sys-color-outline);">
                @Model.Dashboard.ExperiencePoints / @Model.Dashboard.XpToNextLevel XP
            </div>
        </div>
        <div class="md3-card stat-card stat-card-currency">
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Currency</div>
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-tertiary);">@Model.Dashboard.Currency.ToString("N0")g</div>
        </div>
        <div class="md3-card stat-card stat-card-rating">
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Rating</div>
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Dashboard.Rating</div>
        </div>
        <div class="md3-card stat-card stat-card-achievement">
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Achievement Points</div>
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-secondary);">@Model.Dashboard.AchievementPoints</div>
            <div class="text-xs mt-1" style="color: var(--md-sys-color-outline);">
                @Model.Dashboard.AchievementsUnlocked / @Model.Dashboard.TotalAchievements unlocked
            </div>
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 3: Achievement Showcase                               *@
    @* ============================================================ *@
    <div class="md3-card mb-8" style="padding: 0;">
        <div class="px-6 py-4 flex items-center justify-between"
             style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
            <h2 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Achievements</h2>
            <a href="/api-docs/v1#player"
               class="text-sm" style="color: var(--md-sys-color-primary);">
                API: GET /api/v1/player/achievements &rarr;
            </a>
        </div>
        <div class="p-6">
            @if (Model.Dashboard.RecentAchievements.Any())
            {
                <div class="mb-4">
                    <h3 class="text-sm font-medium mb-3" style="color: var(--md-sys-color-on-surface-variant);">Recent Unlocks</h3>
                    <div class="flex flex-wrap gap-3">
                        @foreach (var achievement in Model.Dashboard.RecentAchievements)
                        {
                            <div class="md3-badge-primary flex items-center px-4 py-3"
                                 style="border-radius: var(--md-sys-shape-corner-medium);">
                                <div class="w-8 h-8 flex items-center justify-center mr-3"
                                     style="background: var(--md-sys-color-primary); border-radius: 9999px;">
                                    <span class="material-symbols-outlined" style="color: var(--md-sys-color-on-primary); font-size: 16px;">@GetCategoryIcon(achievement.Category)</span>
                                </div>
                                <div>
                                    <div class="font-medium text-sm">@achievement.Name</div>
                                    <div class="text-xs" style="opacity: 0.7;">+@achievement.Points pts</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (Model.Dashboard.NextAchievement != null)
            {
                var next = Model.Dashboard.NextAchievement;
                <div class="p-4" style="background: var(--md-sys-color-surface-container); border-radius: var(--md-sys-shape-corner-medium);">
                    <div class="flex items-center justify-between mb-2">
                        <div>
                            <span class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">Next Up: @next.Name</span>
                            <span class="ml-2 text-xs" style="color: var(--md-sys-color-on-surface-variant);">@next.Description</span>
                        </div>
                        <span class="text-sm font-bold" style="color: var(--md-sys-color-primary);">@next.ProgressPercent%</span>
                    </div>
                    <div class="md3-progress"><div class="md3-progress-bar" style="width: @(next.ProgressPercent)%;"></div></div>
                    <div class="text-xs mt-1" style="color: var(--md-sys-color-outline);">@next.Progress / @next.RequiredProgress</div>
                </div>
            }
            @if (!Model.Dashboard.RecentAchievements.Any() && Model.Dashboard.NextAchievement == null)
            {
                <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                    Start battling and exploring to earn achievements! Check the API for ways to progress.
                </p>
            }
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 4: Hero Roster                                        *@
    @* ============================================================ *@
    <div class="md3-card mb-8" style="padding: 0;">
        <div class="px-6 py-4 flex items-center justify-between"
             style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
            <h2 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">
                Your Heroes
                <span class="text-sm font-normal ml-2" style="color: var(--md-sys-color-on-surface-variant);">
                    @Model.Dashboard.Heroes.Count of @Model.Dashboard.TotalUnitsAvailable
                </span>
            </h2>
            <a href="/api-docs/v1#player"
               class="text-sm" style="color: var(--md-sys-color-primary);">
                API: GET /api/v1/player/roster &rarr;
            </a>
        </div>
        <div class="p-6">
            @if (Model.Dashboard.Heroes.Any())
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                    @foreach (var hero in Model.Dashboard.Heroes)
                    {
                        var heroClass = GetClassColor(hero.ClassName);
                        <div class="relative p-4 text-center @heroClass"
                             style="background: var(--hero-bg); border-left: 3px solid var(--hero-accent); border-radius: var(--md-sys-shape-corner-medium);
                                    @(hero.IsHighestMastery ? "box-shadow: 0 0 0 2px #facc15;" : "")">
                            @if (hero.IsHighestMastery)
                            {
                                <div class="absolute flex items-center justify-center text-xs"
                                     style="top: -8px; right: -8px; width: 24px; height: 24px; background: #facc15; border-radius: 9999px;">
                                    <span class="material-symbols-outlined" style="font-size: 14px; color: #713f12;">star</span>
                                </div>
                            }
                            <div class="w-12 h-12 mx-auto flex items-center justify-center mb-2"
                                 style="border-radius: 9999px; background: rgba(0,0,0,0.06);">
                                <span class="material-symbols-outlined" style="color: var(--hero-accent); font-size: 24px;">@GetClassIcon(hero.ClassName)</span>
                            </div>
                            <div class="font-medium text-sm truncate" style="color: var(--md-sys-color-on-surface);">@hero.Name</div>
                            <span class="md3-chip md3-chip-sm" style="margin-top: 0.25rem;">@hero.ClassName</span>
                            @if (hero.MasteryLevel > 0)
                            {
                                <div class="mt-1 text-xs font-semibold" style="color: var(--hero-accent);">
                                    Mastery @hero.MasteryLevel
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-center py-4" style="color: var(--md-sys-color-on-surface-variant);">
                    Your roster is empty! Unlock your first hero to get started.
                </p>
            }

            @if (Model.Dashboard.AffordableUnlockCount > 0)
            {
                <div class="mt-4 md3-alert md3-alert-warning p-3 text-center">
                    <span class="text-sm">
                        <strong>@Model.Dashboard.AffordableUnlockCount hero(es)</strong> you can afford to unlock right now!
                    </span>
                    <a href="/api-docs/v1#player"
                       class="ml-2 text-sm font-medium" style="color: var(--md-sys-color-primary);">
                        Unlock via API &rarr;
                    </a>
                </div>
            }
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 5: Daily Challenges                                   *@
    @* ============================================================ *@
    <div class="md3-card mb-8" style="padding: 0;">
        <div class="px-6 py-4 flex items-center justify-between"
             style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
            <h2 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Daily Challenges</h2>
            <a href="/api-docs/v1#challenges"
               class="text-sm" style="color: var(--md-sys-color-primary);">
                API: GET /api/v1/challenges/daily &rarr;
            </a>
        </div>
        <div>
            @if (Model.Dashboard.Challenges.Any())
            {
                @foreach (var challenge in Model.Dashboard.Challenges)
                {
                    <div class="px-6 py-4" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center">
                                @if (challenge.IsCompleted)
                                {
                                    <span class="material-symbols-outlined" style="color: #22c55e; font-size: 20px; margin-right: 0.5rem;">check_circle</span>
                                }
                                <div>
                                    <span class="font-medium text-sm" style="color: var(--md-sys-color-on-surface);">@challenge.Name</span>
                                    <span class="text-xs ml-2" style="color: var(--md-sys-color-on-surface-variant);">@challenge.Description</span>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0 ml-4">
                                <div class="text-xs" style="color: var(--md-sys-color-outline);">@challenge.TimeRemaining</div>
                                <div class="text-xs">
                                    <span style="color: var(--md-sys-color-tertiary);">@(challenge.RewardCurrency)g</span>
                                    <span class="mx-1" style="color: var(--md-sys-color-outline);">+</span>
                                    <span style="color: var(--md-sys-color-primary);">@(challenge.RewardXp) XP</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="flex-1">
                                <div class="md3-progress"><div class="md3-progress-bar" style="width: @(challenge.ProgressPercent)%;@(challenge.IsCompleted ? " background: #22c55e;" : "")"></div></div>
                            </div>
                            <span class="text-xs w-16 text-right" style="color: var(--md-sys-color-on-surface-variant);">
                                @challenge.Progress / @challenge.RequiredProgress
                            </span>
                        </div>
                        @if (challenge.IsCompleted)
                        {
                            <div class="mt-2">
                                <a href="/api-docs/v1#challenges"
                                   class="text-xs font-medium" style="color: #22c55e;">
                                    Claim reward via API: POST /api/v1/challenges/claim &rarr;
                                </a>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="px-6 py-8 text-center text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                    New challenges are on the way! Check back soon.
                </div>
            }
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 6: Guild Hub                                          *@
    @* ============================================================ *@
    <div class="md3-card mb-8" style="padding: 0;">
        <div class="px-6 py-4" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
            <h2 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Guild</h2>
        </div>
        <div class="p-6">
            @if (Model.Dashboard.Guild != null)
            {
                var guild = Model.Dashboard.Guild;
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center">
                        <div class="w-12 h-12 flex items-center justify-center mr-4"
                             style="border-radius: var(--md-sys-shape-corner-medium); background: var(--md-sys-color-secondary-container);">
                            <span class="text-lg font-bold" style="color: var(--md-sys-color-on-secondary-container);">@guild.Tag</span>
                        </div>
                        <div>
                            <div class="font-semibold" style="color: var(--md-sys-color-on-surface);">@guild.Name</div>
                            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                                <span class="md3-badge md3-badge-secondary mr-2">
                                    @guild.Role
                                </span>
                                @guild.MemberCount members
                            </div>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Contribution</div>
                        <div class="font-bold text-lg" style="color: var(--md-sys-color-on-surface);">@guild.ContributionPoints.ToString("N0")</div>
                    </div>
                </div>

                @if (Model.Dashboard.GuildBoss != null)
                {
                    var boss = Model.Dashboard.GuildBoss;
                    <div class="md3-alert md3-alert-error p-4">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center">
                                <span class="material-symbols-outlined" style="color: var(--md-sys-color-error); font-size: 20px; margin-right: 0.5rem;">warning</span>
                                <span class="font-medium">@boss.Name</span>
                            </div>
                            <span class="text-sm font-bold" style="color: var(--md-sys-color-error);">@boss.HpPercent% HP</span>
                        </div>
                        <div class="md3-progress"><div class="md3-progress-bar" style="width: @(boss.HpPercent)%; background: var(--md-sys-color-error);"></div></div>
                        <div class="mt-2 text-right">
                            <a href="/api-docs/v1#guild-boss"
                               class="text-xs font-medium" style="color: var(--md-sys-color-error);">
                                Attack via API: POST /api/v1/guild/boss/attempt &rarr;
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4">
                    <span class="material-symbols-outlined" style="font-size: 48px; color: var(--md-sys-color-outline); display: block; margin: 0 auto 0.75rem;">groups</span>
                    <h3 class="font-medium mb-1" style="color: var(--md-sys-color-on-surface);">Join a Guild</h3>
                    <p class="text-sm mb-3 max-w-md mx-auto" style="color: var(--md-sys-color-on-surface-variant);">
                        Guilds unlock boss battles, shared treasury, team strategies, and guild chat!
                    </p>
                    @if (Model.Dashboard.Tier == "Free")
                    {
                        <a class="md3-btn-filled" href="/Account/Subscription" style="text-decoration: none;">
                            Upgrade to Premium to Create a Guild
                        </a>
                    }
                    else
                    {
                        <a href="/api-docs/v1#guild"
                           class="text-sm" style="color: var(--md-sys-color-primary);">
                            API: POST /api/v1/guild/create &rarr;
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 7: Battle Status                                      *@
    @* ============================================================ *@
    <div class="md3-card mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-6">
                <div>
                    <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Battles Today</div>
                    <div class="text-xl font-bold" style="color: var(--md-sys-color-on-surface);">
                        @Model.Dashboard.BattlesToday / @(Model.Dashboard.DailyBattleLimit == -1 ? "Unlimited" : Model.Dashboard.DailyBattleLimit.ToString())
                    </div>
                </div>
                @if (Model.Dashboard.WinStreak > 0)
                {
                    <div>
                        <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Win Streak</div>
                        <div class="text-xl font-bold" style="color: var(--md-sys-color-error);">
                            @for (int i = 0; i < Math.Min(Model.Dashboard.WinStreak, 5); i++)
                            {
                                <span class="material-symbols-outlined" style="font-size: 20px; color: @(i < 3 ? "var(--md-sys-color-tertiary)" : "var(--md-sys-color-error)");">local_fire_department</span>
                            }
                            @if (Model.Dashboard.WinStreak > 5)
                            {
                                <span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">+@(Model.Dashboard.WinStreak - 5)</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="flex items-center gap-4">
                @if (!Model.Dashboard.HasBattledToday)
                {
                    <span class="text-sm font-medium" style="color: var(--md-sys-color-tertiary);">
                        First battle bonus: +100g!
                    </span>
                }
                @if (Model.Dashboard.Tier == "Free")
                {
                    <a asp-page="/Account/Subscription" class="text-xs" style="color: var(--md-sys-color-primary);">
                        Upgrade for unlimited battles
                    </a>
                }
                <a class="md3-btn-tonal" href="/api-docs/v1#battle" style="text-decoration: none;">
                    <span class="material-symbols-outlined">swords</span>
                    Queue Battle
                </a>
            </div>
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 8: Suggested Actions                                  *@
    @* ============================================================ *@
    @if (Model.Dashboard.SuggestedActions.Any())
    {
        <div class="mb-8">
            <h2 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">What's Next?</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var action in Model.Dashboard.SuggestedActions)
                {
                    var accentColor = action.IconType switch {
                        "sword" => "var(--md-sys-color-error)",
                        "trophy" => "var(--md-sys-color-tertiary)",
                        "star" => "var(--md-sys-color-secondary)",
                        "guild" => "var(--md-sys-color-primary)",
                        "coin" => "#22c55e",
                        "shield" => "var(--md-sys-color-primary)",
                        _ => "var(--md-sys-color-outline)"
                    };
                    var iconName = action.IconType switch {
                        "sword" => "swords",
                        "trophy" => "emoji_events",
                        "star" => "star",
                        "guild" => "groups",
                        "coin" => "monetization_on",
                        "shield" => "shield",
                        _ => "arrow_forward"
                    };
                    <a href="@action.LinkUrl"
                       class="md3-card stat-card block"
                       style="border-left: 4px solid @accentColor;">
                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined" style="color: @accentColor; font-size: 24px;">@iconName</span>
                            <div>
                                <div class="font-medium mb-1" style="color: var(--md-sys-color-on-surface);">@action.Title</div>
                                <p class="text-sm mb-2" style="color: var(--md-sys-color-on-surface-variant);">@action.Description</p>
                                <span class="text-xs font-mono" style="color: var(--md-sys-color-primary);">@action.LinkText</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    }

</div>
