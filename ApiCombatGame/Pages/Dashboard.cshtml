@page
@model ApiCombatGame.Pages.DashboardPageModel
@using ApiCombatGame.Helpers
@{
    ViewData["Title"] = "Dashboard";
    var (apiTierName, apiTierFlavor, apiTierCss) = RatingTierHelper.GetTier(Model.Dashboard.Rating);
}

@functions {
    string GetClassColor(string className) => className switch
    {
        "Warrior" => "hero-warrior",
        "Mage" => "hero-mage",
        "Ranger" => "hero-ranger",
        "Healer" => "hero-healer",
        "Tank" => "hero-tank",
        "Assassin" => "hero-assassin",
        _ => "hero-default"
    };

    string GetClassIcon(string className) => className switch
    {
        "Warrior" => "swords",
        "Mage" => "bolt",
        "Ranger" => "target",
        "Healer" => "healing",
        "Tank" => "shield",
        "Assassin" => "visibility_off",
        _ => "person"
    };

    string GetCategoryIcon(string category) => category switch
    {
        "Combat" => "swords",
        "Collection" => "collections_bookmark",
        "Social" => "group",
        "Progression" => "trending_up",
        _ => "emoji_events"
    };

    string TierClass(string tier) => tier switch
    {
        "Premium" => "dash-tier-premium",
        "PremiumPlus" => "dash-tier-premiumplus",
        _ => "dash-tier-free"
    };
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    @* ═══════════════════════════════════════════════ *@
    @* PLAYER STATUS BAR                               *@
    @* ═══════════════════════════════════════════════ *@
    <div class="dash-status-bar mb-4">
        <div class="dash-avatar">
            @Model.Dashboard.Username[..1].ToUpper()
        </div>
        <div class="dash-player-info">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="dash-player-name">@Model.Dashboard.Username</span>
                <span class="dash-tier-badge @TierClass(Model.Dashboard.Tier)">
                    @(Model.Dashboard.Tier == "PremiumPlus" ? "Premium+" : Model.Dashboard.Tier)
                </span>
                @if (Model.Dashboard.UnreadNotifications > 0)
                {
                    <a asp-page="/Account/Notifications" class="feature-badge" style="font-size: 0.625rem; text-decoration: none;">
                        <span class="material-symbols-outlined" style="font-size: 12px;">mail</span>
                        @Model.Dashboard.UnreadNotifications new
                    </a>
                }
            </div>
            <div class="dash-player-meta">Level @Model.Dashboard.Level &middot; @Model.Dashboard.ExperiencePoints / @Model.Dashboard.XpToNextLevel XP</div>
            <div class="dash-xp-bar">
                <div class="dash-xp-fill" style="width: @(Model.Dashboard.XpProgressPercent)%;"></div>
            </div>
        </div>
        <div class="dash-stats-row">
            <div class="dash-stat">
                <div class="dash-stat-value">@Model.Dashboard.Rating</div>
                <div class="dash-stat-label">API</div>
            </div>
            <div class="dash-stat">
                <div class="api-tier-badge @apiTierCss" title="@apiTierFlavor">@apiTierName</div>
            </div>
            <div class="dash-stat">
                <div class="dash-stat-value">@Model.Dashboard.Currency.ToString("N0")</div>
                <div class="dash-stat-label" style="color: #d4a017;">Gold</div>
            </div>
            <div class="dash-stat">
                <div class="dash-stat-value">@Model.Dashboard.AchievementPoints</div>
                <div class="dash-stat-label">Ach. Pts</div>
            </div>
        </div>
    </div>

    @* ═══════════════════════════════════════════════ *@
    @* MAIN 2-COLUMN GRID                              *@
    @* ═══════════════════════════════════════════════ *@
    <div class="dash-grid">

        @* ──────────── LEFT COLUMN ──────────── *@
        <div class="flex flex-col gap-4">

            @* BATTLE HUB *@
            <div class="dash-panel battle-hub">
                <div class="dash-panel-header">
                    <span class="dash-panel-title">Battle Hub</span>
                    @if (Model.Dashboard.WinStreak > 0)
                    {
                        <div class="fire-streak">
                            @for (int i = 0; i < Math.Min(Model.Dashboard.WinStreak, 5); i++)
                            {
                                <span class="material-symbols-outlined fire-icon @(i < 3 ? "warm" : "hot")">local_fire_department</span>
                            }
                            <span class="fire-streak-label">@Model.Dashboard.WinStreak Win Streak</span>
                        </div>
                    }
                </div>
                <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <a class="battle-btn" href="/api-docs/v1#battle" style="text-decoration: none;">
                            <span class="material-symbols-outlined" style="font-size: 22px;">swords</span>
                            Queue Battle
                        </a>
                    </div>
                    <div class="flex items-center gap-6">
                        <div>
                            <div class="text-xs font-medium" style="color: var(--md-sys-color-on-surface-variant);">Today</div>
                            <div class="text-lg font-bold" style="color: var(--md-sys-color-on-surface);">
                                @Model.Dashboard.BattlesToday<span class="text-sm font-normal" style="color: var(--md-sys-color-on-surface-variant);">/@(Model.Dashboard.DailyBattleLimit == -1 ? "∞" : Model.Dashboard.DailyBattleLimit.ToString())</span>
                            </div>
                        </div>
                        @if (!Model.Dashboard.HasBattledToday)
                        {
                            <div class="px-3 py-1.5 rounded-lg text-xs font-semibold" style="background: color-mix(in srgb, #facc15 12%, transparent); color: #a16207;">
                                +100g first battle!
                            </div>
                        }
                    </div>
                </div>
                @if (Model.Dashboard.Tier == "Free")
                {
                    <div class="mt-3 flex items-center gap-2 text-xs" style="color: var(--md-sys-color-on-surface-variant);">
                        <a asp-page="/Account/Subscription" class="dash-empty-cta" style="margin-top: 0;">
                            <span class="material-symbols-outlined" style="font-size: 14px;">upgrade</span>
                            Upgrade
                            <span class="material-symbols-outlined" style="font-size: 14px; opacity: 0.7;">arrow_forward</span>
                        </a>
                        <span>for unlimited battles</span>
                    </div>
                }
            </div>

            @* DAILY CHALLENGES *@
            <div class="dash-panel">
                <div class="dash-panel-header">
                    <span class="dash-panel-title">Daily Challenges</span>
                    @if (Model.Dashboard.Challenges.Any(c => c.IsCompleted))
                    {
                        <span class="text-xs font-semibold" style="color: #22c55e;">
                            @Model.Dashboard.Challenges.Count(c => c.IsCompleted) claimable
                        </span>
                    }
                </div>
                @if (Model.Dashboard.Challenges.Any())
                {
                    @foreach (var challenge in Model.Dashboard.Challenges)
                    {
                        <div class="challenge-row">
                            <div class="challenge-status">
                                @if (challenge.IsCompleted)
                                {
                                    <span class="material-symbols-outlined" style="color: #22c55e; font-size: 20px;">check_circle</span>
                                }
                                else
                                {
                                    <span class="text-xs font-bold" style="color: var(--md-sys-color-on-surface-variant);">@challenge.ProgressPercent%</span>
                                }
                            </div>
                            <div class="challenge-info">
                                <div class="challenge-name">@challenge.Name</div>
                                <div class="challenge-progress-bar">
                                    <div class="challenge-progress-fill @(challenge.IsCompleted ? "complete" : "")" style="width: @(challenge.ProgressPercent)%;"></div>
                                </div>
                            </div>
                            <div class="challenge-reward">
                                <span class="challenge-reward-text"><span style="color: #d4a017;">@(challenge.RewardCurrency)g</span> · <span style="color: var(--md-sys-color-primary);">@(challenge.RewardXp)xp</span></span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="dash-empty">
                        <div class="dash-empty-icon">
                            <span class="material-symbols-outlined" style="font-size: 24px;">flag</span>
                        </div>
                        <div class="dash-empty-title">No active challenges</div>
                        <div class="dash-empty-desc">Challenges refresh daily. Battle to complete them and earn gold + XP rewards.</div>
                    </div>
                }
            </div>

            @* HERO ROSTER *@
            <div class="dash-panel">
                <div class="dash-panel-header">
                    <span class="dash-panel-title">Heroes</span>
                    <span class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">
                        @Model.Dashboard.Heroes.Count / @Model.Dashboard.TotalUnitsAvailable
                    </span>
                </div>
                @if (Model.Dashboard.Heroes.Any())
                {
                    <div class="hero-mini-grid" id="hero-grid">
                        @{ var displayHeroes = Model.Dashboard.Heroes.Take(6).ToList(); }
                        @foreach (var hero in displayHeroes)
                        {
                            var heroClass = GetClassColor(hero.ClassName);
                            <div class="hero-mini-card @heroClass">
                                <div class="hero-mini-icon">
                                    <span class="material-symbols-outlined" style="color: var(--hero-accent); font-size: 18px;">@GetClassIcon(hero.ClassName)</span>
                                </div>
                                <div style="min-width: 0;">
                                    <div class="hero-mini-name">@hero.Name</div>
                                    <div class="hero-mini-class">@hero.ClassName</div>
                                    @if (hero.MasteryLevel > 0)
                                    {
                                        <div class="hero-mini-mastery">M@hero.MasteryLevel</div>
                                    }
                                </div>
                                @if (hero.IsHighestMastery)
                                {
                                    <span class="material-symbols-outlined" style="color: #facc15; font-size: 14px; margin-left: auto; flex-shrink: 0;">star</span>
                                }
                            </div>
                        }
                    </div>
                    @if (Model.Dashboard.Heroes.Count > 6)
                    {
                        <div class="hero-mini-grid mt-2 hidden" id="hero-grid-extra">
                            @foreach (var hero in Model.Dashboard.Heroes.Skip(6))
                            {
                                var heroClass = GetClassColor(hero.ClassName);
                                <div class="hero-mini-card @heroClass">
                                    <div class="hero-mini-icon">
                                        <span class="material-symbols-outlined" style="color: var(--hero-accent); font-size: 18px;">@GetClassIcon(hero.ClassName)</span>
                                    </div>
                                    <div style="min-width: 0;">
                                        <div class="hero-mini-name">@hero.Name</div>
                                        <div class="hero-mini-class">@hero.ClassName</div>
                                        @if (hero.MasteryLevel > 0)
                                        {
                                            <div class="hero-mini-mastery">M@hero.MasteryLevel</div>
                                        }
                                    </div>
                                    @if (hero.IsHighestMastery)
                                    {
                                        <span class="material-symbols-outlined" style="color: #facc15; font-size: 14px; margin-left: auto; flex-shrink: 0;">star</span>
                                    }
                                </div>
                            }
                        </div>
                        <button class="mt-2 text-xs font-medium w-full text-center py-1" style="color: var(--md-sys-color-primary); background: none; border: none; cursor: pointer;"
                                onclick="document.getElementById('hero-grid-extra').classList.toggle('hidden'); this.textContent = this.textContent.includes('Show') ? 'Show less' : 'Show all @Model.Dashboard.Heroes.Count heroes';">
                            Show all @Model.Dashboard.Heroes.Count heroes
                        </button>
                    }
                    @if (Model.Dashboard.AffordableUnlockCount > 0)
                    {
                        <a href="/api-docs/v1#player" class="dash-affordable-banner">
                            <span class="material-symbols-outlined" style="font-size: 16px; color: #d4a017;">shopping_cart</span>
                            <span><strong>@Model.Dashboard.AffordableUnlockCount</strong> hero(es) you can afford!</span>
                            <span class="material-symbols-outlined" style="font-size: 16px; margin-left: auto; opacity: 0.6;">arrow_forward</span>
                        </a>
                    }
                }
                else
                {
                    <div class="dash-empty">
                        <div class="dash-empty-icon">
                            <span class="material-symbols-outlined" style="font-size: 24px;">person_add</span>
                        </div>
                        <div class="dash-empty-title">No heroes yet</div>
                        <div class="dash-empty-desc">Unlock your first unit from 6 classes — Warriors, Mages, Rangers, Healers, Tanks &amp; Assassins.</div>
                        <a href="/api-docs/v1#player" class="dash-empty-cta">
                            <span class="material-symbols-outlined" style="font-size: 14px;">lock_open</span>
                            Unlock via API
                            <span class="material-symbols-outlined" style="font-size: 14px; opacity: 0.7;">arrow_forward</span>
                        </a>
                    </div>
                }
            </div>
        </div>

        @* ──────────── RIGHT COLUMN ──────────── *@
        <div class="flex flex-col gap-4">

            @* LOGIN STREAK *@
            <div class="dash-panel dash-panel-secondary">
                <div class="dash-panel-header">
                    <span class="dash-panel-title">Login Streak</span>
                    @if (Model.Dashboard.TodayRewardClaimed)
                    {
                        <span class="text-xs font-bold" style="color: #facc15;">+@(Model.Dashboard.TodayRewardAmount)g claimed</span>
                    }
                </div>
                <div class="streak-strip">
                    @foreach (var day in Model.Dashboard.StreakDays)
                    {
                        var dayClass = day.IsToday ? "streak-day streak-day-today"
                            : day.IsClaimed ? "streak-day streak-day-claimed"
                            : "streak-day streak-day-unclaimed";
                        <div class="@dayClass">
                            <div class="streak-day-num">@day.Day</div>
                            <div class="streak-day-reward">@(day.RewardAmount)g</div>
                        </div>
                    }
                </div>
            </div>

            @* GUILD HUB *@
            <div class="dash-panel dash-panel-secondary">
                <div class="dash-panel-header">
                    <span class="dash-panel-title">Guild</span>
                </div>
                @if (Model.Dashboard.Guild != null)
                {
                    var guild = Model.Dashboard.Guild;
                    <div class="flex items-center gap-3 mb-3">
                        <div class="guild-tag-badge">@guild.Tag</div>
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-semibold" style="color: var(--md-sys-color-on-surface);">@guild.Name</div>
                            <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">
                                @guild.Role &middot; @guild.MemberCount members &middot; @guild.ContributionPoints.ToString("N0") CP
                            </div>
                        </div>
                    </div>

                    @if (Model.Dashboard.GuildBoss != null)
                    {
                        var boss = Model.Dashboard.GuildBoss;
                        <div class="p-3 rounded-xl" style="background: color-mix(in srgb, var(--md-sys-color-error) 6%, transparent); border: 1px solid color-mix(in srgb, var(--md-sys-color-error) 15%, transparent);">
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined" style="color: var(--md-sys-color-error); font-size: 16px;">warning</span>
                                    <span class="text-xs font-bold" style="color: var(--md-sys-color-on-surface);">@boss.Name</span>
                                </div>
                                <span class="text-xs font-bold" style="color: var(--md-sys-color-error);">@boss.HpPercent% HP</span>
                            </div>
                            <div class="boss-hp-bar">
                                <div class="boss-hp-fill" style="width: @(boss.HpPercent)%;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="dash-empty">
                        <div class="dash-empty-icon">
                            <span class="material-symbols-outlined" style="font-size: 24px;">castle</span>
                        </div>
                        <div class="dash-empty-title">No guild yet</div>
                        <div class="dash-empty-desc">Guilds unlock boss battles, shared treasury &amp; cooperative play.</div>
                        @if (Model.Dashboard.Tier == "Free")
                        {
                            <a href="/Account/Subscription" class="dash-empty-cta">
                                <span class="material-symbols-outlined" style="font-size: 14px;">workspace_premium</span>
                                Premium required
                                <span class="material-symbols-outlined" style="font-size: 14px; opacity: 0.7;">arrow_forward</span>
                            </a>
                        }
                        else
                        {
                            <a href="/api-docs/v1#guild" class="dash-empty-cta">
                                <span class="material-symbols-outlined" style="font-size: 14px;">add</span>
                                Create guild
                                <span class="material-symbols-outlined" style="font-size: 14px; opacity: 0.7;">arrow_forward</span>
                            </a>
                        }
                    </div>
                }
            </div>

            @* ACHIEVEMENTS *@
            <div class="dash-panel dash-panel-secondary">
                <div class="dash-panel-header">
                    <span class="dash-panel-title">Achievements</span>
                    <span class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">
                        @Model.Dashboard.AchievementsUnlocked / @Model.Dashboard.TotalAchievements
                    </span>
                </div>

                @if (Model.Dashboard.NextAchievement != null)
                {
                    var next = Model.Dashboard.NextAchievement;
                    <div class="mb-3">
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-xs font-semibold" style="color: var(--md-sys-color-on-surface);">@next.Name</span>
                            <span class="text-xs font-bold" style="color: var(--md-sys-color-primary);">@next.ProgressPercent%</span>
                        </div>
                        <div class="challenge-progress-bar">
                            <div class="challenge-progress-fill" style="width: @(next.ProgressPercent)%;"></div>
                        </div>
                        <div class="text-xs mt-1" style="color: var(--md-sys-color-outline);">@next.Description</div>
                    </div>
                }

                @if (Model.Dashboard.RecentAchievements.Any())
                {
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var achievement in Model.Dashboard.RecentAchievements)
                        {
                            <div class="achievement-pill">
                                <span class="material-symbols-outlined" style="font-size: 12px;">@GetCategoryIcon(achievement.Category)</span>
                                @achievement.Name
                            </div>
                        }
                    </div>
                }

                @if (!Model.Dashboard.RecentAchievements.Any() && Model.Dashboard.NextAchievement == null)
                {
                    <div class="dash-empty">
                        <div class="dash-empty-icon">
                            <span class="material-symbols-outlined" style="font-size: 24px;">emoji_events</span>
                        </div>
                        <div class="dash-empty-title">Start earning</div>
                        <div class="dash-empty-desc">Battle, unlock heroes, and join a guild to unlock achievements.</div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ═══════════════════════════════════════════════ *@
    @* QUICK ACTIONS                                    *@
    @* ═══════════════════════════════════════════════ *@
    @if (Model.Dashboard.SuggestedActions.Any())
    {
        <div class="dash-panel mt-4">
            <div class="dash-panel-header">
                <span class="dash-panel-title">What's Next</span>
            </div>
            <div class="quick-actions">
                @foreach (var action in Model.Dashboard.SuggestedActions)
                {
                    var iconName = action.IconType switch {
                        "sword" => "swords",
                        "trophy" => "emoji_events",
                        "star" => "star",
                        "guild" => "groups",
                        "coin" => "monetization_on",
                        "shield" => "shield",
                        _ => "arrow_forward"
                    };
                    <a href="@action.LinkUrl" class="quick-action">
                        <span class="material-symbols-outlined" style="font-size: 18px;">@iconName</span>
                        @action.Title
                        <span class="material-symbols-outlined" style="font-size: 16px; opacity: 0.7;">arrow_forward</span>
                    </a>
                }
            </div>
        </div>
    }
</div>
