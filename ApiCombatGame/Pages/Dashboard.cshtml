@page
@model ApiCombatGame.Pages.DashboardPageModel
@{
    ViewData["Title"] = "Dashboard";
}

@functions {
    string GetClassColor(string className) => className switch
    {
        "Warrior" => "red",
        "Mage" => "purple",
        "Ranger" => "green",
        "Healer" => "emerald",
        "Tank" => "blue",
        _ => "gray"
    };

    string GetClassIcon(string className) => className switch
    {
        "Warrior" => "M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5",
        "Mage" => "M13 10V3L4 14h7v7l9-11h-7z",
        "Ranger" => "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z",
        "Healer" => "M12 4v16m-8-8h16",
        "Tank" => "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
        _ => "M12 2L2 7l10 5 10-5-10-5z"
    };

    string GetCategoryColor(string category) => category switch
    {
        "Combat" => "red",
        "Collection" => "blue",
        "Social" => "purple",
        "Progression" => "amber",
        _ => "gray"
    };
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

    @* ============================================================ *@
    @* SECTION 1: Welcome Banner + Login Streak                      *@
    @* ============================================================ *@
    <div class="bg-gradient-to-r from-blue-600 to-indigo-700 dark:from-blue-800 dark:to-indigo-900 rounded-xl shadow-lg p-6 mb-8 text-white">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold">Welcome back, @Model.Dashboard.Username!</h1>
                <p class="text-blue-100 mt-1">
                    Level @Model.Dashboard.Level
                    <span class="mx-2">&middot;</span>
                    @Model.Dashboard.Tier Tier
                    @if (Model.Dashboard.UnreadNotifications > 0)
                    {
                        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-500 text-white">
                            @Model.Dashboard.UnreadNotifications unread
                        </span>
                    }
                </p>
            </div>
            @if (Model.Dashboard.TodayRewardClaimed)
            {
                <div class="mt-4 md:mt-0 bg-white/20 backdrop-blur-sm rounded-lg px-4 py-2 text-center">
                    <div class="text-sm text-blue-100">Daily Streak Bonus</div>
                    <div class="text-2xl font-bold text-yellow-300">+@(Model.Dashboard.TodayRewardAmount)g</div>
                    <div class="text-xs text-blue-200">Day @Model.Dashboard.LoginStreak of 7</div>
                </div>
            }
        </div>

        @* Streak Calendar *@
        <div class="mt-6 flex items-center justify-between gap-2">
            @foreach (var day in Model.Dashboard.StreakDays)
            {
                <div class="flex-1 text-center">
                    <div class="w-10 h-10 mx-auto rounded-full flex items-center justify-center text-sm font-bold
                        @(day.IsToday ? "bg-yellow-400 text-yellow-900 ring-2 ring-yellow-300 ring-offset-2 ring-offset-blue-700" :
                          day.IsClaimed ? "bg-white/30 text-white" :
                          "bg-white/10 text-blue-300")">
                        @day.Day
                    </div>
                    <div class="text-xs mt-1 @(day.IsClaimed ? "text-yellow-300 font-semibold" : "text-blue-300")">
                        @(day.RewardAmount)g
                    </div>
                </div>
            }
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 2: Player Status Cards                                *@
    @* ============================================================ *@
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5">
            <div class="text-sm text-gray-500 dark:text-gray-400">Level @Model.Dashboard.Level</div>
            <div class="mt-2 w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
                <div class="bg-blue-600 h-2.5 rounded-full" style="width: @(Model.Dashboard.XpProgressPercent)%"></div>
            </div>
            <div class="text-xs text-gray-400 dark:text-gray-500 mt-1">
                @Model.Dashboard.ExperiencePoints / @Model.Dashboard.XpToNextLevel XP
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5">
            <div class="text-sm text-gray-500 dark:text-gray-400">Currency</div>
            <div class="text-2xl font-bold text-yellow-600 dark:text-yellow-400">@Model.Dashboard.Currency.ToString("N0")g</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5">
            <div class="text-sm text-gray-500 dark:text-gray-400">Rating</div>
            <div class="text-2xl font-bold">@Model.Dashboard.Rating</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5">
            <div class="text-sm text-gray-500 dark:text-gray-400">Achievement Points</div>
            <div class="text-2xl font-bold text-purple-600 dark:text-purple-400">@Model.Dashboard.AchievementPoints</div>
            <div class="text-xs text-gray-400 dark:text-gray-500 mt-1">
                @Model.Dashboard.AchievementsUnlocked / @Model.Dashboard.TotalAchievements unlocked
            </div>
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 3: Achievement Showcase                               *@
    @* ============================================================ *@
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow mb-8">
        <div class="px-6 py-4 border-b dark:border-gray-700 flex items-center justify-between">
            <h2 class="text-lg font-semibold">Achievements</h2>
            <a href="/swagger/index.html#/Player/get_api_v1_player_achievements"
               class="text-sm text-blue-500 hover:underline">
                API: GET /api/v1/player/achievements &rarr;
            </a>
        </div>
        <div class="p-6">
            @if (Model.Dashboard.RecentAchievements.Any())
            {
                <div class="mb-4">
                    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">Recent Unlocks</h3>
                    <div class="flex flex-wrap gap-3">
                        @foreach (var achievement in Model.Dashboard.RecentAchievements)
                        {
                            var color = GetCategoryColor(achievement.Category);
                            <div class="flex items-center bg-@(color)-50 dark:bg-@(color)-900/20 border border-@(color)-200 dark:border-@(color)-800 rounded-lg px-4 py-3">
                                <div class="w-8 h-8 rounded-full bg-@(color)-100 dark:bg-@(color)-800 flex items-center justify-center mr-3">
                                    <svg class="w-4 h-4 text-@(color)-600 dark:text-@(color)-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path d="M5 3l14 9-14 9V3z" />
                                    </svg>
                                </div>
                                <div>
                                    <div class="font-medium text-sm">@achievement.Name</div>
                                    <div class="text-xs text-gray-500 dark:text-gray-400">+@achievement.Points pts</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (Model.Dashboard.NextAchievement != null)
            {
                var next = Model.Dashboard.NextAchievement;
                <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                    <div class="flex items-center justify-between mb-2">
                        <div>
                            <span class="text-sm font-medium">Next Up: @next.Name</span>
                            <span class="ml-2 text-xs text-gray-500 dark:text-gray-400">@next.Description</span>
                        </div>
                        <span class="text-sm font-bold text-blue-600 dark:text-blue-400">@next.ProgressPercent%</span>
                    </div>
                    <div class="w-full bg-gray-200 dark:bg-gray-600 rounded-full h-2">
                        <div class="bg-blue-600 h-2 rounded-full" style="width: @(next.ProgressPercent)%"></div>
                    </div>
                    <div class="text-xs text-gray-400 dark:text-gray-500 mt-1">@next.Progress / @next.RequiredProgress</div>
                </div>
            }
            @if (!Model.Dashboard.RecentAchievements.Any() && Model.Dashboard.NextAchievement == null)
            {
                <p class="text-gray-500 dark:text-gray-400 text-sm">
                    Start battling and exploring to earn achievements! Check the API for ways to progress.
                </p>
            }
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 4: Hero Roster                                        *@
    @* ============================================================ *@
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow mb-8">
        <div class="px-6 py-4 border-b dark:border-gray-700 flex items-center justify-between">
            <h2 class="text-lg font-semibold">
                Your Heroes
                <span class="text-sm font-normal text-gray-500 dark:text-gray-400 ml-2">
                    @Model.Dashboard.Heroes.Count of @Model.Dashboard.TotalUnitsAvailable
                </span>
            </h2>
            <a href="/swagger/index.html#/Player/get_api_v1_player_roster"
               class="text-sm text-blue-500 hover:underline">
                API: GET /api/v1/player/roster &rarr;
            </a>
        </div>
        <div class="p-6">
            @if (Model.Dashboard.Heroes.Any())
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                    @foreach (var hero in Model.Dashboard.Heroes)
                    {
                        var color = GetClassColor(hero.ClassName);
                        <div class="relative bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4 text-center
                            @(hero.IsHighestMastery ? $"ring-2 ring-yellow-400 dark:ring-yellow-500" : "")">
                            @if (hero.IsHighestMastery)
                            {
                                <div class="absolute -top-2 -right-2 w-6 h-6 bg-yellow-400 rounded-full flex items-center justify-center text-xs">
                                    <svg class="w-3.5 h-3.5 text-yellow-800" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                    </svg>
                                </div>
                            }
                            <div class="w-12 h-12 mx-auto rounded-full bg-@(color)-100 dark:bg-@(color)-900/30 flex items-center justify-center mb-2">
                                <svg class="w-6 h-6 text-@(color)-600 dark:text-@(color)-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path d="@GetClassIcon(hero.ClassName)" />
                                </svg>
                            </div>
                            <div class="font-medium text-sm truncate">@hero.Name</div>
                            <span class="inline-block mt-1 px-2 py-0.5 text-xs rounded-full bg-@(color)-100 dark:bg-@(color)-900/30 text-@(color)-700 dark:text-@(color)-300">
                                @hero.ClassName
                            </span>
                            @if (hero.MasteryLevel > 0)
                            {
                                <div class="mt-1 text-xs text-yellow-600 dark:text-yellow-400 font-semibold">
                                    Mastery @hero.MasteryLevel
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-gray-500 dark:text-gray-400 text-sm text-center py-4">
                    Your roster is empty! Unlock your first hero to get started.
                </p>
            }

            @if (Model.Dashboard.AffordableUnlockCount > 0)
            {
                <div class="mt-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-3 text-center">
                    <span class="text-sm text-yellow-800 dark:text-yellow-200">
                        <strong>@Model.Dashboard.AffordableUnlockCount hero(es)</strong> you can afford to unlock right now!
                    </span>
                    <a href="/swagger/index.html#/Player/post_api_v1_player_roster_unlock"
                       class="ml-2 text-sm text-yellow-600 dark:text-yellow-400 hover:underline font-medium">
                        Unlock via API &rarr;
                    </a>
                </div>
            }
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 5: Daily Challenges                                   *@
    @* ============================================================ *@
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow mb-8">
        <div class="px-6 py-4 border-b dark:border-gray-700 flex items-center justify-between">
            <h2 class="text-lg font-semibold">Daily Challenges</h2>
            <a href="/swagger/index.html#/Challenges/get_api_v1_challenges_daily"
               class="text-sm text-blue-500 hover:underline">
                API: GET /api/v1/challenges/daily &rarr;
            </a>
        </div>
        <div class="divide-y dark:divide-gray-700">
            @if (Model.Dashboard.Challenges.Any())
            {
                @foreach (var challenge in Model.Dashboard.Challenges)
                {
                    <div class="px-6 py-4">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center">
                                @if (challenge.IsCompleted)
                                {
                                    <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                    </svg>
                                }
                                <div>
                                    <span class="font-medium text-sm">@challenge.Name</span>
                                    <span class="text-xs text-gray-500 dark:text-gray-400 ml-2">@challenge.Description</span>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0 ml-4">
                                <div class="text-xs text-gray-400 dark:text-gray-500">@challenge.TimeRemaining</div>
                                <div class="text-xs">
                                    <span class="text-yellow-600 dark:text-yellow-400">@(challenge.RewardCurrency)g</span>
                                    <span class="text-gray-400 mx-1">+</span>
                                    <span class="text-blue-600 dark:text-blue-400">@(challenge.RewardXp) XP</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="flex-1 bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                                <div class="@(challenge.IsCompleted ? "bg-green-500" : "bg-blue-600") h-2 rounded-full"
                                     style="width: @(challenge.ProgressPercent)%"></div>
                            </div>
                            <span class="text-xs text-gray-500 dark:text-gray-400 w-16 text-right">
                                @challenge.Progress / @challenge.RequiredProgress
                            </span>
                        </div>
                        @if (challenge.IsCompleted)
                        {
                            <div class="mt-2">
                                <a href="/swagger/index.html#/Challenges/post_api_v1_challenges_claim"
                                   class="text-xs text-green-600 dark:text-green-400 hover:underline font-medium">
                                    Claim reward via API: POST /api/v1/challenges/claim &rarr;
                                </a>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="px-6 py-8 text-center text-gray-500 dark:text-gray-400 text-sm">
                    New challenges are on the way! Check back soon.
                </div>
            }
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 6: Guild Hub                                          *@
    @* ============================================================ *@
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow mb-8">
        <div class="px-6 py-4 border-b dark:border-gray-700">
            <h2 class="text-lg font-semibold">Guild</h2>
        </div>
        <div class="p-6">
            @if (Model.Dashboard.Guild != null)
            {
                var guild = Model.Dashboard.Guild;
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center">
                        <div class="w-12 h-12 rounded-lg bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center mr-4">
                            <span class="text-lg font-bold text-indigo-600 dark:text-indigo-400">@guild.Tag</span>
                        </div>
                        <div>
                            <div class="font-semibold">@guild.Name</div>
                            <div class="text-sm text-gray-500 dark:text-gray-400">
                                <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 mr-2">
                                    @guild.Role
                                </span>
                                @guild.MemberCount members
                            </div>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-sm text-gray-500 dark:text-gray-400">Contribution</div>
                        <div class="font-bold text-lg">@guild.ContributionPoints.ToString("N0")</div>
                    </div>
                </div>

                @if (Model.Dashboard.GuildBoss != null)
                {
                    var boss = Model.Dashboard.GuildBoss;
                    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center">
                                <svg class="w-5 h-5 text-red-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path d="M12 9v2m0 4h.01M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
                                </svg>
                                <span class="font-medium text-red-800 dark:text-red-200">@boss.Name</span>
                            </div>
                            <span class="text-sm font-bold text-red-600 dark:text-red-400">@boss.HpPercent% HP</span>
                        </div>
                        <div class="w-full bg-red-200 dark:bg-red-900 rounded-full h-3">
                            <div class="bg-gradient-to-r from-red-600 to-red-400 h-3 rounded-full transition-all"
                                 style="width: @(boss.HpPercent)%"></div>
                        </div>
                        <div class="mt-2 text-right">
                            <a href="/swagger/index.html#/GuildBoss/post_api_v1_guild_boss_attempt"
                               class="text-xs text-red-600 dark:text-red-400 hover:underline font-medium">
                                Attack via API: POST /api/v1/guild/boss/attempt &rarr;
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4">
                    <svg class="w-12 h-12 mx-auto text-gray-300 dark:text-gray-600 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                        <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    <h3 class="font-medium text-gray-700 dark:text-gray-300 mb-1">Join a Guild</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 max-w-md mx-auto">
                        Guilds unlock boss battles, shared treasury, team strategies, and guild chat!
                    </p>
                    @if (Model.Dashboard.Tier == "Free")
                    {
                        <a asp-page="/Account/Subscription" class="inline-block px-4 py-2 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition">
                            Upgrade to Premium to Create a Guild
                        </a>
                    }
                    else
                    {
                        <a href="/swagger/index.html#/Guild/post_api_v1_guild_create"
                           class="text-sm text-blue-500 hover:underline">
                            API: POST /api/v1/guild/create &rarr;
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 7: Battle Status                                      *@
    @* ============================================================ *@
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow mb-8">
        <div class="px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-6">
                <div>
                    <div class="text-sm text-gray-500 dark:text-gray-400">Battles Today</div>
                    <div class="text-xl font-bold">
                        @Model.Dashboard.BattlesToday / @(Model.Dashboard.DailyBattleLimit == -1 ? "Unlimited" : Model.Dashboard.DailyBattleLimit.ToString())
                    </div>
                </div>
                @if (Model.Dashboard.WinStreak > 0)
                {
                    <div>
                        <div class="text-sm text-gray-500 dark:text-gray-400">Win Streak</div>
                        <div class="text-xl font-bold text-orange-500">
                            @for (int i = 0; i < Math.Min(Model.Dashboard.WinStreak, 5); i++)
                            {
                                <span class="@(i < 3 ? "text-orange-400" : "text-red-500")">&#128293;</span>
                            }
                            @if (Model.Dashboard.WinStreak > 5)
                            {
                                <span class="text-sm text-gray-500">+@(Model.Dashboard.WinStreak - 5)</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="flex items-center gap-4">
                @if (!Model.Dashboard.HasBattledToday)
                {
                    <span class="text-sm text-amber-600 dark:text-amber-400 font-medium">
                        First battle bonus: +100g!
                    </span>
                }
                @if (Model.Dashboard.Tier == "Free")
                {
                    <a asp-page="/Account/Subscription" class="text-xs text-blue-500 hover:underline">
                        Upgrade for unlimited battles
                    </a>
                }
                <a href="/swagger/index.html#/Battle/post_api_v1_battle_queue"
                   class="inline-block px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700 transition">
                    Queue Battle &rarr;
                </a>
            </div>
        </div>
    </div>

    @* ============================================================ *@
    @* SECTION 8: Suggested Actions                                  *@
    @* ============================================================ *@
    @if (Model.Dashboard.SuggestedActions.Any())
    {
        <div class="mb-8">
            <h2 class="text-lg font-semibold mb-4">What's Next?</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var action in Model.Dashboard.SuggestedActions)
                {
                    <a href="@action.LinkUrl"
                       class="block bg-white dark:bg-gray-800 rounded-lg shadow p-5 hover:shadow-md transition border-l-4
                           @(action.IconType switch {
                               "sword" => "border-red-500",
                               "trophy" => "border-yellow-500",
                               "star" => "border-purple-500",
                               "guild" => "border-indigo-500",
                               "coin" => "border-green-500",
                               "shield" => "border-blue-500",
                               _ => "border-gray-500"
                           })">
                        <div class="font-medium mb-1">@action.Title</div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">@action.Description</p>
                        <span class="text-xs text-blue-500 font-mono">@action.LinkText</span>
                    </a>
                }
