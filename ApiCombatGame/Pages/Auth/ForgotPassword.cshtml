@page
@model ApiCombatGame.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    ViewData["Description"] = "Reset your API Combat Game password. Enter your email to receive a password reset link.";
}

<div class="auth-backdrop">
    <div class="auth-card">
        <div class="text-center mb-8">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mx-auto mb-4" style="background: color-mix(in srgb, var(--md-sys-color-primary) 12%, transparent);">
                <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); font-size: 24px;">lock_reset</span>
            </div>
            <h1 class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface); letter-spacing: -0.02em;">Reset your password</h1>
            <p class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">We'll send you a link to get back in</p>
        </div>

        @if (Model.Submitted)
        {
            <div class="md3-alert md3-alert-success mb-6">
                <p class="text-sm">If an account exists with that email, you'll receive a password reset link shortly. Check your inbox (and spam folder).</p>
            </div>
            <p class="text-center text-sm mt-6" style="color: var(--md-sys-color-on-surface-variant);">
                <a asp-page="/Auth/Login" class="font-semibold link-underline" style="color: var(--md-sys-color-primary);">Back to login</a>
            </p>
        }
        else
        {
            <form method="post">
                <div class="mb-6">
                    <div class="md3-input-wrapper">
                        <label for="Input_Email">Email</label>
                        <input class="md3-input" id="Input_Email" name="Input.Email" type="email" required value="@Model.Input?.Email" placeholder="Enter your email address" />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn-glow w-full">
                    Send Reset Link
                </button>
            </form>

            <p class="text-center text-sm mt-6" style="color: var(--md-sys-color-on-surface-variant);">
                Remember your password?
                <a asp-page="/Auth/Login" class="font-semibold link-underline" style="color: var(--md-sys-color-primary);">Sign in</a>
            </p>
        }
    </div>
</div>
