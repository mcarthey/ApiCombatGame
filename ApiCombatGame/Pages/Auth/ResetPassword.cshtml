@page
@model ApiCombatGame.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    ViewData["Description"] = "Choose a new password for your API Combat Game account.";
}

<div class="auth-backdrop">
    <div class="auth-card">
        <div class="text-center mb-8">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mx-auto mb-4" style="background: color-mix(in srgb, var(--md-sys-color-primary) 12%, transparent);">
                <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); font-size: 24px;">lock_reset</span>
            </div>
            <h1 class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface); letter-spacing: -0.02em;">Choose a new password</h1>
            <p class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Make it strong — at least 8 characters</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="md3-alert md3-alert-error mb-6">
                <p class="text-sm">@Model.ErrorMessage</p>
            </div>
            @if (Model.ErrorMessage.Contains("expired"))
            {
                <p class="text-center text-sm mt-4" style="color: var(--md-sys-color-on-surface-variant);">
                    <a asp-page="/Auth/ForgotPassword" class="font-semibold link-underline" style="color: var(--md-sys-color-primary);">Request a new reset link</a>
                </p>
            }
        }

        @if (!string.IsNullOrEmpty(Model.Token))
        {
            <form method="post">
                <input type="hidden" name="Token" value="@Model.Token" />

                <div class="mb-5">
                    <div class="md3-input-wrapper">
                        <label for="Input_Password">New Password</label>
                        <input class="md3-input" id="Input_Password" name="Input.Password" type="password" required placeholder="Minimum 8 characters" />
                    </div>
                    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                </div>

                <div class="mb-6">
                    <div class="md3-input-wrapper">
                        <label for="Input_ConfirmPassword">Confirm Password</label>
                        <input class="md3-input" id="Input_ConfirmPassword" name="Input.ConfirmPassword" type="password" required placeholder="Repeat your password" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn-glow w-full">
                    Reset Password
                </button>
            </form>
        }

        <p class="text-center text-sm mt-6" style="color: var(--md-sys-color-on-surface-variant);">
            <a asp-page="/Auth/Login" class="font-semibold link-underline" style="color: var(--md-sys-color-primary);">Back to login</a>
        </p>
    </div>
</div>
