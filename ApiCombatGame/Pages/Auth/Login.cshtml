@page
@model ApiCombatGame.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="max-w-md mx-auto px-4">
    <div class="md3-card p-8">
        <h1 class="text-2xl font-bold text-center mb-6" style="color: var(--md-sys-color-on-surface);">Login</h1>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="md3-alert md3-alert-error mb-6">
                <p class="text-sm">@Model.ErrorMessage</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="md3-alert md3-alert-success mb-6">
                <p class="text-sm">@Model.SuccessMessage</p>
            </div>
        }

        <form method="post">
            <div class="mb-4">
                <md-outlined-text-field
                    label="Username"
                    name="Input.Username"
                    id="Input_Username"
                    required
                    value="@Model.Input?.Username"
                    placeholder="Enter your username"
                    class="w-full">
                </md-outlined-text-field>
                <span asp-validation-for="Input.Username" class="field-validation-error"></span>
            </div>

            <div class="mb-6">
                <md-outlined-text-field
                    label="Password"
                    type="password"
                    name="Input.Password"
                    id="Input_Password"
                    required
                    placeholder="Enter your password"
                    class="w-full">
                </md-outlined-text-field>
                <span asp-validation-for="Input.Password" class="field-validation-error"></span>
            </div>

            <div class="mb-4">
                <label class="flex items-center gap-3">
                    <md-checkbox name="Input.RememberMe" value="true"
                                 touch-target="wrapper"
                                 @(Model.Input?.RememberMe == true ? "checked" : "")>
                    </md-checkbox>
                    <span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Remember me</span>
                </label>
            </div>

            <md-filled-button type="submit" class="w-full">
                Login
            </md-filled-button>
        </form>

        <p class="text-center text-sm mt-6" style="color: var(--md-sys-color-on-surface-variant);">
            Don't have an account?
            <a asp-page="/Auth/Register" class="font-medium" style="color: var(--md-sys-color-primary);">Sign up</a>
        </p>
    </div>
</div>
