@page
@model ApiCombatGame.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Login";
    ViewData["Description"] = "Log in to API Combat Game to manage your roster, queue battles, and track your Arena Power Index ranking.";
}

<div class="auth-backdrop">
    <div class="auth-card">
        <div class="text-center mb-8">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mx-auto mb-4" style="background: color-mix(in srgb, var(--md-sys-color-primary) 12%, transparent);">
                <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); font-size: 24px;">shield_person</span>
            </div>
            <h1 class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface); letter-spacing: -0.02em;">Welcome back</h1>
            <p class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Sign in to your account</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="md3-alert md3-alert-error mb-6">
                <p class="text-sm">@Model.ErrorMessage</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="md3-alert md3-alert-success mb-6">
                <p class="text-sm">@Model.SuccessMessage</p>
            </div>
        }

        <form method="post" id="loginForm">
            <div class="mb-5">
                <div class="md3-input-wrapper">
                    <label for="Input_Email">Email</label>
                    <input class="md3-input" id="Input_Email" name="Input.Email" type="email" required value="@Model.Input?.Email" placeholder="Enter your email address" />
                </div>
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </div>

            <div class="mb-6">
                <div class="md3-input-wrapper">
                    <label for="Input_Password">Password</label>
                    <input class="md3-input" id="Input_Password" name="Input.Password" type="password" required placeholder="Enter your password" />
                </div>
                <span asp-validation-for="Input.Password" class="field-validation-error"></span>
            </div>

            <div class="mb-6 flex items-center justify-between">
                <label class="flex items-center gap-3">
                    <input type="checkbox" class="md3-checkbox" name="Input.RememberMe" value="true"
                                 @(Model.Input?.RememberMe == true ? "checked" : "") />
                    <span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Remember me</span>
                </label>
                <a asp-page="/Auth/ForgotPassword" class="text-sm link-underline" style="color: var(--md-sys-color-primary);">Forgot password?</a>
            </div>

            <input type="hidden" id="recaptchaToken" name="Input.RecaptchaToken" />

            <button type="submit" class="btn-glow w-full">
                Sign In
            </button>
        </form>

        <p class="text-center text-sm mt-6" style="color: var(--md-sys-color-on-surface-variant);">
            Don't have an account?
            <a asp-page="/Auth/Register" class="font-semibold link-underline" style="color: var(--md-sys-color-primary);">Create one</a>
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.RecaptchaSiteKey))
{
    <script src="https://www.google.com/recaptcha/api.js?render=@Model.RecaptchaSiteKey"></script>
    <script>
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();
            grecaptcha.ready(function() {
                grecaptcha.execute('@Model.RecaptchaSiteKey', {action: 'login'}).then(function(token) {
                    document.getElementById('recaptchaToken').value = token;
                    document.getElementById('loginForm').submit();
                });
            });
        });
    </script>
}
