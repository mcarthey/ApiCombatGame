@page
@model ApiCombatGame.Pages.Account.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-3xl font-bold" style="color: var(--md-sys-color-on-surface);">Notifications</h1>
            @if (Model.UnreadCount > 0)
            {
                <p class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">@Model.UnreadCount unread</p>
            }
        </div>
        <div class="flex items-center space-x-3">
            @if (Model.UnreadCount > 0)
            {
                <form method="post" asp-page-handler="MarkAllRead">
                    <md-text-button type="submit">
                        <md-icon slot="icon">done_all</md-icon>
                        Mark all as read
                    </md-text-button>
                </form>
            }
            <a asp-page="/Account/Settings" style="text-decoration: none;">
                <md-text-button>
                    <md-icon slot="icon">settings</md-icon>
                    Preferences
                </md-text-button>
            </a>
        </div>
    </div>

    <!-- Filter -->
    <div class="mb-4 flex space-x-2">
        <a asp-page="/Account/Notifications" asp-route-unreadOnly="false" style="text-decoration: none;">
            @if (!Model.UnreadOnly)
            {
                <md-filled-tonal-button>All</md-filled-tonal-button>
            }
            else
            {
                <md-outlined-button>All</md-outlined-button>
            }
        </a>
        <a asp-page="/Account/Notifications" asp-route-unreadOnly="true" style="text-decoration: none;">
            @if (Model.UnreadOnly)
            {
                <md-filled-tonal-button>Unread</md-filled-tonal-button>
            }
            else
            {
                <md-outlined-button>Unread</md-outlined-button>
            }
        </a>
    </div>

    @if (Model.NotificationList.Count == 0)
    {
        <div class="md3-card p-12 text-center">
            <md-icon style="font-size: 4rem; color: var(--md-sys-color-on-surface-variant); display: block; margin: 0 auto 16px;">notifications_none</md-icon>
            <p style="color: var(--md-sys-color-on-surface-variant);">No notifications yet.</p>
        </div>
    }
    else
    {
        <div class="space-y-2">
            @foreach (var n in Model.NotificationList)
            {
                var badgeClass = n.Category switch {
                    ApiCombatGame.Models.Enums.NotificationCategory.Battle => "md3-badge-error",
                    ApiCombatGame.Models.Enums.NotificationCategory.Guild => "md3-badge-tertiary",
                    ApiCombatGame.Models.Enums.NotificationCategory.Progression => "md3-badge-primary",
                    ApiCombatGame.Models.Enums.NotificationCategory.Marketplace => "md3-badge-secondary",
                    ApiCombatGame.Models.Enums.NotificationCategory.Security => "md3-badge-error",
                    _ => "md3-badge-secondary"
                };

                <div class="md3-card p-4 flex items-start justify-between"
                     style="@(!n.IsRead ? "border-left: 3px solid var(--md-sys-color-primary);" : "")">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center space-x-2 mb-1">
                            <span class="@badgeClass text-xs font-medium">@n.Category</span>
                            @if (!n.IsRead)
                            {
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--md-sys-color-primary); display: inline-block;"></span>
                            }
                        </div>
                        <h3 class="text-sm font-semibold" style="color: var(--md-sys-color-on-surface);">@n.Title</h3>
                        <p class="text-sm mt-0.5" style="color: var(--md-sys-color-on-surface-variant);">@n.Message</p>
                        <p class="text-xs mt-1" style="color: var(--md-sys-color-outline);">@n.CreatedAt.ToString("MMM dd, yyyy h:mm tt") UTC</p>
                    </div>
                    @if (!n.IsRead)
                    {
                        <form method="post" asp-page-handler="MarkRead" class="ml-3 flex-shrink-0">
                            <input type="hidden" name="notificationId" value="@n.Id" />
                            <md-icon-button type="submit" title="Mark as read">
                                <md-icon>check</md-icon>
                            </md-icon-button>
                        </form>
                    }
                </div>
            }
        </div>

        <!-- Pagination -->
        <div class="flex justify-between items-center mt-6">
            @if (Model.Page > 1)
            {
                <a asp-page="/Account/Notifications" asp-route-page="@(Model.Page - 1)" asp-route-unreadOnly="@Model.UnreadOnly"
                   style="text-decoration: none;">
                    <md-text-button>
                        <md-icon slot="icon">chevron_left</md-icon>
                        Previous
                    </md-text-button>
                </a>
            }
            else
            {
                <span></span>
            }
            <span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Page @Model.Page</span>
            @if (Model.NotificationList.Count == 20)
            {
                <a asp-page="/Account/Notifications" asp-route-page="@(Model.Page + 1)" asp-route-unreadOnly="@Model.UnreadOnly"
                   style="text-decoration: none;">
                    <md-text-button>
                        Next
                        <md-icon slot="icon">chevron_right</md-icon>
                    </md-text-button>
                </a>
            }
            else
            {
                <span></span>
            }
        </div>
    }
</div>
