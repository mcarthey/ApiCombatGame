@page
@model ApiCombatGame.Pages.Account.SettingsModel
@{
    ViewData["Title"] = "Account Settings";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold mb-8">Account Settings</h1>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-green-50 dark:bg-green-900/20 border-l-4 border-green-400 p-4 mb-6">
            <p class="text-sm text-green-700 dark:text-green-400">@Model.SuccessMessage</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-400 p-4 mb-6">
            <p class="text-sm text-red-700 dark:text-red-400">@Model.ErrorMessage</p>
        </div>
    }

    <!-- Account Info -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4">Account Information</h2>
        <div class="space-y-3 text-sm">
            <div class="flex justify-between">
                <span class="text-gray-600 dark:text-gray-400">Username</span>
                <span class="font-medium">@Model.CurrentUsername</span>
            </div>
            <div class="flex justify-between">
                <span class="text-gray-600 dark:text-gray-400">Member since</span>
                <span class="font-medium">@Model.MemberSince.ToString("MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Update Email -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4">Email Address</h2>
        <form method="post" asp-page-handler="UpdateEmail">
            <div class="mb-4">
                <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email</label>
                <input type="email" id="email" asp-for="Input.Email" required
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                Update Email
            </button>
        </form>
    </div>

    <!-- Change Password -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4">Change Password</h2>
        <form method="post" asp-page-handler="ChangePassword">
            <div class="mb-4">
                <label for="currentPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Current Password</label>
                <input type="password" id="currentPassword" asp-for="Input.CurrentPassword" required
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="mb-4">
                <label for="newPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">New Password</label>
                <input type="password" id="newPassword" asp-for="Input.NewPassword" required
                       placeholder="Minimum 8 characters"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                Change Password
            </button>
        </form>
    </div>

    <!-- Notification Preferences -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold">Notification Preferences</h2>
            <a asp-page="/Account/Notifications" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">View notifications</a>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Choose which notifications you want to receive. System and Security notifications are always enabled.</p>
        <form method="post" asp-page-handler="UpdateNotificationPreferences">
            <div class="space-y-3">
                <label class="flex items-center justify-between">
                    <div>
                        <span class="text-sm font-medium">Battle</span>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Results, win streaks, rating milestones</p>
                    </div>
                    <input type="checkbox" name="battle" value="true" @(Model.NotifPrefs.Battle ? "checked" : "")
                           class="h-4 w-4 text-blue-600 rounded border-gray-300 dark:border-gray-600" />
                </label>
                <label class="flex items-center justify-between">
                    <div>
                        <span class="text-sm font-medium">Guild</span>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Invites, promotions, boss events, chat mentions</p>
                    </div>
                    <input type="checkbox" name="guild" value="true" @(Model.NotifPrefs.Guild ? "checked" : "")
                           class="h-4 w-4 text-blue-600 rounded border-gray-300 dark:border-gray-600" />
                </label>
                <label class="flex items-center justify-between">
                    <div>
                        <span class="text-sm font-medium">Progression</span>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Level ups, achievements, mastery, daily challenges</p>
                    </div>
                    <input type="checkbox" name="progression" value="true" @(Model.NotifPrefs.Progression ? "checked" : "")
                           class="h-4 w-4 text-blue-600 rounded border-gray-300 dark:border-gray-600" />
                </label>
                <label class="flex items-center justify-between">
                    <div>
                        <span class="text-sm font-medium">Marketplace</span>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Strategy ratings and download milestones</p>
                    </div>
                    <input type="checkbox" name="marketplace" value="true" @(Model.NotifPrefs.Marketplace ? "checked" : "")
                           class="h-4 w-4 text-blue-600 rounded border-gray-300 dark:border-gray-600" />
                </label>
                <div class="flex items-center justify-between opacity-60">
                    <div>
                        <span class="text-sm font-medium">System</span>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Modifier rotations, announcements</p>
                    </div>
                    <input type="checkbox" checked disabled class="h-4 w-4 text-blue-600 rounded border-gray-300 dark:border-gray-600" />
                </div>
                <div class="flex items-center justify-between opacity-60">
                    <div>
                        <span class="text-sm font-medium">Security</span>
                        <p class="text-xs text-gray-500 dark:text-gray-400">API key alerts, password changes, admin actions</p>
                    </div>
                    <input type="checkbox" checked disabled class="h-4 w-4 text-blue-600 rounded border-gray-300 dark:border-gray-600" />
                </div>
            </div>
            <button type="submit" class="mt-4 bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                Save Preferences
            </button>
        </form>
    </div>
</div>
