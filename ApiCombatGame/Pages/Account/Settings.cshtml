@page
@model ApiCombatGame.Pages.Account.SettingsModel
@{
    ViewData["Title"] = "Account Settings";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold mb-8" style="color: var(--md-sys-color-on-surface);">Account Settings</h1>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="md3-alert-success p-4 mb-6">
            <div class="flex items-center">
                <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 12px;">check_circle</span>
                <p class="text-sm" style="color: var(--md-sys-color-on-surface);">@Model.SuccessMessage</p>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="md3-alert-error p-4 mb-6">
            <div class="flex items-center">
                <span class="material-symbols-outlined" style="color: var(--md-sys-color-error); margin-right: 12px;">error</span>
                <p class="text-sm" style="color: var(--md-sys-color-on-error-container);">@Model.ErrorMessage</p>
            </div>
        </div>
    }

    <!-- Account Info -->
    <div class="md3-card p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Account Information</h2>
        <div class="space-y-3 text-sm">
            <div class="flex justify-between">
                <span style="color: var(--md-sys-color-on-surface-variant);">Username</span>
                <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@Model.CurrentUsername</span>
            </div>
            <hr class="md3-divider" />
            <div class="flex justify-between">
                <span style="color: var(--md-sys-color-on-surface-variant);">Member since</span>
                <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@Model.MemberSince.ToString("MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Update Email -->
    <div class="md3-card p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Email Address</h2>
        <form method="post" asp-page-handler="UpdateEmail">
            <div class="mb-4">
                <div class="md3-input-wrapper">
                    <label for="email">Email</label>
                    <input class="md3-input" id="email" name="Input.Email" type="email" value="@Model.Input.Email" required />
                </div>
            </div>
            <button type="submit" class="md3-btn-filled">Update Email</button>
        </form>
    </div>

    <!-- Change Password -->
    <div class="md3-card p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Change Password</h2>
        <form method="post" asp-page-handler="ChangePassword">
            <div class="mb-4">
                <div class="md3-input-wrapper">
                    <label for="currentPassword">Current Password</label>
                    <input class="md3-input" id="currentPassword" name="Input.CurrentPassword" type="password" required />
                </div>
            </div>
            <div class="mb-4">
                <div class="md3-input-wrapper">
                    <label for="newPassword">New Password</label>
                    <input class="md3-input" id="newPassword" name="Input.NewPassword" type="password" required placeholder="Minimum 8 characters" />
                </div>
            </div>
            <button type="submit" class="md3-btn-filled">Change Password</button>
        </form>
    </div>

    <!-- Notification Preferences -->
    <div class="md3-card p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Notification Preferences</h2>
            <a asp-page="/Account/Notifications" class="md3-btn-text" style="text-decoration: none;">View notifications</a>
        </div>
        <p class="text-sm mb-4" style="color: var(--md-sys-color-on-surface-variant);">Choose which notifications you want to receive. System and Security notifications are always enabled.</p>
        <form method="post" asp-page-handler="UpdateNotificationPreferences">
            <div class="space-y-4">
                <label class="flex items-center justify-between">
                    <div>
                        <span class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">Battle</span>
                        <p class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Results, win streaks, rating milestones</p>
                    </div>
                    <input type="checkbox" class="md3-checkbox" name="battle" value="true" @(Model.NotifPrefs.Battle ? "checked" : "") />
                </label>
                <hr class="md3-divider" />
                <label class="flex items-center justify-between">
                    <div>
                        <span class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">Guild</span>
                        <p class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Invites, promotions, boss events, chat mentions</p>
                    </div>
                    <input type="checkbox" class="md3-checkbox" name="guild" value="true" @(Model.NotifPrefs.Guild ? "checked" : "") />
                </label>
                <hr class="md3-divider" />
                <label class="flex items-center justify-between">
                    <div>
                        <span class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">Progression</span>
                        <p class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Level ups, achievements, mastery, daily challenges</p>
                    </div>
                    <input type="checkbox" class="md3-checkbox" name="progression" value="true" @(Model.NotifPrefs.Progression ? "checked" : "") />
                </label>
                <hr class="md3-divider" />
                <label class="flex items-center justify-between">
                    <div>
                        <span class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">Marketplace</span>
                        <p class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Strategy ratings and download milestones</p>
                    </div>
                    <input type="checkbox" class="md3-checkbox" name="marketplace" value="true" @(Model.NotifPrefs.Marketplace ? "checked" : "") />
                </label>
                <hr class="md3-divider" />
                <div class="flex items-center justify-between" style="opacity: 0.6;">
                    <div>
                        <span class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">System</span>
                        <p class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Modifier rotations, announcements</p>
                    </div>
                    <input type="checkbox" class="md3-checkbox" checked disabled />
                </div>
                <hr class="md3-divider" />
                <div class="flex items-center justify-between" style="opacity: 0.6;">
                    <div>
                        <span class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">Security</span>
                        <p class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">API key alerts, password changes, admin actions</p>
                    </div>
                    <input type="checkbox" class="md3-checkbox" checked disabled />
                </div>
            </div>
            <button type="submit" class="md3-btn-filled" style="margin-top: 16px;">Save Preferences</button>
        </form>
    </div>

    <!-- Danger Zone -->
    <div class="md3-card p-6 mt-6" style="border: 1px solid var(--md-sys-color-error);">
        <div class="flex items-center gap-3 mb-4">
            <span class="material-symbols-outlined" style="color: var(--md-sys-color-error);">warning</span>
            <h2 class="text-lg font-semibold" style="color: var(--md-sys-color-error);">Danger Zone</h2>
        </div>
        <p class="text-sm mb-4" style="color: var(--md-sys-color-on-surface-variant);">
            Permanently delete your account and all associated data. This action cannot be undone.
            Your username and email will be anonymized, and you will be logged out immediately.
        </p>
        <form method="post" asp-page-handler="DeleteAccount" id="deleteAccountForm">
            <div class="mb-4">
                <div class="md3-input-wrapper">
                    <label for="deletePassword">Confirm Password</label>
                    <input class="md3-input" id="deletePassword" name="DeletePassword" type="password" required placeholder="Enter your password to confirm" />
                </div>
            </div>
            <button type="submit" class="md3-btn-filled" style="background: var(--md-sys-color-error); color: var(--md-sys-color-on-error);"
                    onclick="return confirm('Are you sure you want to delete your account? This cannot be undone.');">
                <span class="material-symbols-outlined" style="font-size: 18px; margin-right: 4px;">delete_forever</span>
                Delete My Account
            </button>
        </form>
    </div>
</div>
