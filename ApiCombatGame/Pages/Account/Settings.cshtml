@page
@model ApiCombatGame.Pages.Account.SettingsModel
@{
    ViewData["Title"] = "Account Settings";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold mb-8">Account Settings</h1>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-green-50 border-l-4 border-green-400 p-4 mb-6">
            <p class="text-sm text-green-700">@Model.SuccessMessage</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6">
            <p class="text-sm text-red-700">@Model.ErrorMessage</p>
        </div>
    }

    <!-- Account Info -->
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4">Account Information</h2>
        <div class="space-y-3 text-sm">
            <div class="flex justify-between">
                <span class="text-gray-600">Username</span>
                <span class="font-medium">@Model.CurrentUsername</span>
            </div>
            <div class="flex justify-between">
                <span class="text-gray-600">Member since</span>
                <span class="font-medium">@Model.MemberSince.ToString("MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Update Email -->
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4">Email Address</h2>
        <form method="post" asp-page-handler="UpdateEmail">
            <div class="mb-4">
                <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                <input type="email" id="email" asp-for="Input.Email" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                Update Email
            </button>
        </form>
    </div>

    <!-- Change Password -->
    <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold mb-4">Change Password</h2>
        <form method="post" asp-page-handler="ChangePassword">
            <div class="mb-4">
                <label for="currentPassword" class="block text-sm font-medium text-gray-700 mb-2">Current Password</label>
                <input type="password" id="currentPassword" asp-for="Input.CurrentPassword" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="mb-4">
                <label for="newPassword" class="block text-sm font-medium text-gray-700 mb-2">New Password</label>
                <input type="password" id="newPassword" asp-for="Input.NewPassword" required
                       placeholder="Minimum 8 characters"
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                Change Password
            </button>
        </form>
    </div>
</div>
