@page
@model ApiCombatGame.Pages.Account.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold mb-8" style="color: var(--md-sys-color-on-surface);">Dashboard</h1>

    <!-- Stats Overview -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="md3-card p-6">
            <div class="text-sm mb-1" style="color: var(--md-sys-color-on-surface-variant);">Battles Today</div>
            <div class="text-3xl font-bold" style="color: var(--md-sys-color-on-surface);">
                @Model.Dashboard.BattlesToday / @(Model.Dashboard.DailyLimit == -1 ? "Unlimited" : Model.Dashboard.DailyLimit.ToString())
            </div>
            <div class="text-xs mt-1" style="color: var(--md-sys-color-on-surface-variant);">
                @Model.Dashboard.CurrentTier tier
            </div>
        </div>
        <div class="md3-card p-6">
            <div class="text-sm mb-1" style="color: var(--md-sys-color-on-surface-variant);">Win Rate</div>
            <div class="text-3xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Dashboard.WinRate%</div>
            <div class="text-xs mt-1" style="color: var(--md-sys-color-on-surface-variant);">All time</div>
        </div>
        <div class="md3-card p-6">
            <div class="text-sm mb-1" style="color: var(--md-sys-color-on-surface-variant);">Ranking</div>
            <div class="text-3xl font-bold" style="color: var(--md-sys-color-on-surface);">#@Model.Dashboard.GlobalRank</div>
            <div class="text-xs mt-1" style="color: var(--md-sys-color-on-surface-variant);">Global leaderboard</div>
        </div>
        <div class="md3-card p-6">
            <div class="text-sm mb-1" style="color: var(--md-sys-color-on-surface-variant);">Rating</div>
            <div class="text-3xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Dashboard.Rating</div>
            <div class="text-xs mt-1" style="color: var(--md-sys-color-on-surface-variant);">Currency: @Model.Dashboard.Currency</div>
        </div>
    </div>

    <!-- Upgrade Banner (Free tier only) -->
    @if (Model.Dashboard.CurrentTier == "Free")
    {
        <div class="md3-alert-info p-4 mb-8">
            <div class="flex">
                <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 12px;">info</span>
                <div class="flex-1">
                    <p class="text-sm" style="color: var(--md-sys-color-on-surface);">
                        You've used <strong>@Model.Dashboard.BattlesToday of @Model.Dashboard.DailyLimit</strong> battles today.
                        <a asp-page="/Account/Subscription" style="color: var(--md-sys-color-primary); text-decoration: underline; font-weight: 500;">Upgrade to Premium</a> for unlimited battles.
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <a asp-page="/Account/ApiKeys" class="block md3-card p-6" style="text-decoration: none; transition: box-shadow 0.2s;">
            <div class="text-lg font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 8px; color: var(--md-sys-color-primary);">key</span>
                API Keys
            </div>
            <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Manage your API keys and access tokens</p>
        </a>
        <a asp-page="/Account/Subscription" class="block md3-card p-6" style="text-decoration: none; transition: box-shadow 0.2s;">
            <div class="text-lg font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 8px; color: var(--md-sys-color-primary);">card_membership</span>
                Subscription
            </div>
            <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Upgrade or manage your plan</p>
        </a>
        <a href="/api-docs/v1" class="block md3-card p-6" style="text-decoration: none; transition: box-shadow 0.2s;">
            <div class="text-lg font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 8px; color: var(--md-sys-color-primary);">description</span>
                API Docs
            </div>
            <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">View the complete API reference</p>
        </a>
    </div>

    <!-- Recent Activity -->
    <div class="md3-card">
        <div class="px-6 py-4" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
            <h2 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Recent Battles</h2>
        </div>
        <div>
            @if (Model.Dashboard.RecentBattles.Any())
            {
                @foreach (var battle in Model.Dashboard.RecentBattles)
                {
                    <div class="px-6 py-4 flex items-center justify-between" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                        <div>
                            <div class="font-medium" style="color: var(--md-sys-color-on-surface);">vs @battle.OpponentName</div>
                            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">@battle.CompletedAt.ToString("MMM dd, yyyy HH:mm")</div>
                        </div>
                        <div class="flex items-center space-x-3">
                            @if (battle.RatingChange >= 0)
                            {
                                <span class="text-sm" style="color: var(--md-sys-color-primary);">
                                    +@battle.RatingChange
                                </span>
                            }
                            else
                            {
                                <span class="text-sm" style="color: var(--md-sys-color-error);">
                                    @battle.RatingChange
                                </span>
                            }
                            @if (battle.IsWin)
                            {
                                <span class="md3-badge-primary text-sm font-medium">Won</span>
                            }
                            else
                            {
                                <span class="md3-badge-error text-sm font-medium">Lost</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="px-6 py-8 text-center" style="color: var(--md-sys-color-on-surface-variant);">
                    No battles yet. Queue your first battle via the API!
                </div>
            }
        </div>
    </div>
</div>
