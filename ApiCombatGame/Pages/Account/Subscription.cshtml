@page
@model ApiCombatGame.Pages.Account.SubscriptionModel
@{
    ViewData["Title"] = "Subscription";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold mb-8" style="color: var(--md-sys-color-on-surface);">Subscription Management</h1>

    @if (Model.ShowSuccessMessage)
    {
        <div class="md3-alert-success p-4 mb-8">
            <div class="flex items-center">
                <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 12px;">check_circle</span>
                <p class="text-sm" style="color: var(--md-sys-color-on-surface);">Subscription successfully updated! Your new benefits are active now.</p>
            </div>
        </div>
    }

    @if (Model.ShowCanceledMessage)
    {
        <div class="md3-alert-warning p-4 mb-8">
            <div class="flex items-center">
                <span class="material-symbols-outlined" style="color: var(--md-sys-color-error); margin-right: 12px;">warning</span>
                <p class="text-sm" style="color: var(--md-sys-color-on-surface);">Your subscription has been scheduled for cancellation at the end of the billing period.</p>
            </div>
        </div>
    }

    <!-- Current Plan Status -->
    <div class="md3-card p-6 mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Current Plan</h2>
                <p class="text-3xl font-bold mt-2" style="color: var(--md-sys-color-primary);">@Model.CurrentTier</p>
                @if (Model.NextBillingDate.HasValue)
                {
                    <p class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">
                        Next billing: @Model.NextBillingDate.Value.ToString("MMMM dd, yyyy") ($@Model.MonthlyAmount)
                    </p>
                }
            </div>
            @if (Model.CanCancel)
            {
                <div>
                    <button class="md3-btn-text btn-error"
                                    onclick="if(confirm('Are you sure you want to cancel? Access continues until end of billing period.')){document.getElementById('cancelForm').submit();}">
                        Cancel Subscription
                    </button>
                    <form id="cancelForm" method="post" asp-page-handler="Cancel" class="hidden"></form>
                </div>
            }
        </div>
    </div>

    <!-- Plan Comparison -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Free Tier -->
        <div class="md3-card p-6" style="@(Model.CurrentTier == "Free" ? "border: 2px solid var(--md-sys-color-primary);" : "")">
            @if (Model.CurrentTier == "Free")
            {
                <span class="md3-badge-primary text-xs font-semibold inline-block mb-4">Current Plan</span>
            }
            <h3 class="text-2xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">Free</h3>
            <p class="text-4xl font-bold mb-6" style="color: var(--md-sys-color-on-surface);">$0<span class="text-lg" style="color: var(--md-sys-color-on-surface-variant);">/month</span></p>
            <ul class="space-y-3 mb-6">
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">10 battles per day</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">Basic units</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">Public leaderboards</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">3 team slots</span></li>
            </ul>
            @if (Model.CurrentTier == "Free")
            {
                <button class="md3-btn-tonal w-full" disabled>
                    Current Plan
                </button>
            }
            else
            {
                <form method="post" asp-page-handler="Downgrade">
                    <button type="submit" class="md3-btn-outlined w-full">Downgrade to Free</button>
                </form>
            }
        </div>

        <!-- Premium Tier -->
        <div class="md3-card-elevated p-6 relative" style="@(Model.CurrentTier == "Premium" ? "border: 2px solid var(--md-sys-color-primary);" : "")">
            @if (Model.CurrentTier != "Premium")
            {
                <div class="absolute top-0 right-0 px-3 py-1 text-xs font-semibold"
                     style="background: var(--md-sys-color-tertiary-container); color: var(--md-sys-color-on-tertiary-container); border-radius: 0 var(--md-sys-shape-corner-large) 0 var(--md-sys-shape-corner-small);">
                    POPULAR
                </div>
            }
            @if (Model.CurrentTier == "Premium")
            {
                <span class="md3-badge-primary text-xs font-semibold inline-block mb-4">Current Plan</span>
            }
            <h3 class="text-2xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">Premium</h3>
            <p class="text-4xl font-bold mb-6" style="color: var(--md-sys-color-on-surface);">$5<span class="text-lg" style="color: var(--md-sys-color-on-surface-variant);">/month</span></p>
            <ul class="space-y-3 mb-6">
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span class="font-semibold" style="color: var(--md-sys-color-on-surface);">Unlimited battles</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">50+ units (all rarities)</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">Priority matchmaking</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">10 team slots</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">Advanced statistics</span></li>
            </ul>
            @if (Model.CurrentTier == "Premium")
            {
                <button class="md3-btn-tonal w-full" disabled>
                    Current Plan
                </button>
            }
            else
            {
                <form method="post" asp-page-handler="Upgrade">
                    <input type="hidden" name="tier" value="premium" />
                    <button type="submit" class="md3-btn-filled w-full">Upgrade to Premium</button>
                </form>
            }
        </div>

        <!-- Premium Plus Tier -->
        <div class="md3-card p-6" style="@(Model.CurrentTier == "PremiumPlus" ? "border: 2px solid var(--md-sys-color-primary);" : "")">
            @if (Model.CurrentTier == "PremiumPlus")
            {
                <span class="md3-badge-primary text-xs font-semibold inline-block mb-4">Current Plan</span>
            }
            <h3 class="text-2xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">Premium Plus</h3>
            <p class="text-4xl font-bold mb-6" style="color: var(--md-sys-color-on-surface);">$10<span class="text-lg" style="color: var(--md-sys-color-on-surface-variant);">/month</span></p>
            <ul class="space-y-3 mb-6">
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span class="font-semibold" style="color: var(--md-sys-color-on-surface);">Everything in Premium</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">Scripting engine (Lua)</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">Advanced analytics</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">2x API rate limits</span></li>
                <li class="flex items-start"><span class="material-symbols-outlined" style="color: var(--md-sys-color-primary); margin-right: 8px; font-size: 20px;">check</span><span style="color: var(--md-sys-color-on-surface);">Monthly coaching session</span></li>
            </ul>
            @if (Model.CurrentTier == "PremiumPlus")
            {
                <button class="md3-btn-tonal w-full" disabled>
                    Current Plan
                </button>
            }
            else
            {
                <form method="post" asp-page-handler="Upgrade">
                    <input type="hidden" name="tier" value="premium_plus" />
                    <button type="submit" class="md3-btn-filled w-full">Upgrade to Premium Plus</button>
                </form>
            }
        </div>
    </div>

    <!-- Trust Signals -->
    <div class="md3-card mt-8 p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center text-sm">
            <div>
                <p class="font-semibold" style="color: var(--md-sys-color-on-surface);">
                    <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 4px; font-size: 18px; color: var(--md-sys-color-primary);">lock</span>
                    Secure Payments
                </p>
                <p style="color: var(--md-sys-color-on-surface-variant);">Powered by Stripe</p>
            </div>
            <div>
                <p class="font-semibold" style="color: var(--md-sys-color-on-surface);">
                    <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 4px; font-size: 18px; color: var(--md-sys-color-primary);">cancel</span>
                    Cancel Anytime
                </p>
                <p style="color: var(--md-sys-color-on-surface-variant);">No questions asked</p>
            </div>
            <div>
                <p class="font-semibold" style="color: var(--md-sys-color-on-surface);">
                    <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 4px; font-size: 18px; color: var(--md-sys-color-primary);">verified</span>
                    Money-Back Guarantee
                </p>
                <p style="color: var(--md-sys-color-on-surface-variant);">First 30 days</p>
            </div>
        </div>
    </div>
</div>
