@page
@model ApiCombatGame.Pages.Account.BillingModel
@{
    ViewData["Title"] = "Billing";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold mb-8">Billing</h1>

    <!-- Current Plan Summary -->
    <div class="bg-white rounded-lg shadow p-6 mb-8">
        <h2 class="text-lg font-semibold mb-4">Current Plan</h2>
        <div class="flex items-center justify-between">
            <div>
                <p class="text-2xl font-bold text-blue-600">@Model.Billing.CurrentTier</p>
                @if (Model.Billing.NextBillingDate.HasValue)
                {
                    <p class="text-sm text-gray-600 mt-1">
                        $@Model.Billing.MonthlyAmount/month &middot; Next billing: @Model.Billing.NextBillingDate.Value.ToString("MMMM dd, yyyy")
                    </p>
                }
                else
                {
                    <p class="text-sm text-gray-600 mt-1">Free plan - no billing</p>
                }
            </div>
            <a asp-page="/Account/Subscription" class="text-sm text-blue-600 hover:text-blue-700">Change plan</a>
        </div>
    </div>

    @if (Model.Billing.CurrentTier != "Free")
    {
        <!-- Manage via Stripe Portal -->
        <div class="bg-white rounded-lg shadow p-6 mb-8">
            <h2 class="text-lg font-semibold mb-4">Payment Method</h2>
            <p class="text-gray-600 mb-4">
                Manage your payment methods, view invoices, and update billing information through the Stripe Customer Portal.
            </p>
            <form method="post" asp-page-handler="ManageBilling">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                    Manage Billing
                </button>
            </form>
        </div>
    }

    <!-- Billing Info -->
    <div class="bg-gray-50 rounded-lg p-6">
        <h2 class="text-lg font-semibold mb-4">Billing Information</h2>
        <div class="space-y-3 text-sm text-gray-600">
            <p>All payments are securely processed by <strong>Stripe</strong>.</p>
            <p>We do not store your credit card information on our servers.</p>
            <p>Invoices and receipts are available through the Stripe Customer Portal.</p>
            <p>For billing questions, contact support.</p>
        </div>
    </div>
</div>
