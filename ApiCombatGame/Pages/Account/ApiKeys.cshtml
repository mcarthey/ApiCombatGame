@page
@model ApiCombatGame.Pages.Account.ApiKeysModel
@{
    ViewData["Title"] = "API Keys";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold mb-2" style="color: var(--md-sys-color-on-surface);">API Keys</h1>
    <p class="mb-8" style="color: var(--md-sys-color-on-surface-variant);">Use these keys to authenticate with the Combat API. Keep them secret!</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="md3-alert-error p-4 mb-6">
            <div class="flex items-center">
                <md-icon style="color: var(--md-sys-color-error); margin-right: 12px;">error</md-icon>
                <p class="text-sm" style="color: var(--md-sys-color-on-error-container);">@Model.ErrorMessage</p>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.NewlyCreatedKey))
    {
        <div class="md3-alert-warning p-4 mb-8">
            <div class="flex">
                <md-icon style="color: var(--md-sys-color-error); margin-right: 12px; flex-shrink: 0;">warning</md-icon>
                <div class="flex-1">
                    <p class="text-sm font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">
                        Save this API key now! You won't be able to see it again.
                    </p>
                    <div class="p-3 font-mono text-sm break-all"
                         style="background: var(--md-sys-color-surface-container-highest); border-radius: var(--md-sys-shape-corner-small); border: 1px solid var(--md-sys-color-outline-variant);">
                        @Model.NewlyCreatedKey
                    </div>
                    <md-text-button onclick="copyToClipboard('@Model.NewlyCreatedKey')" style="margin-top: 8px;">
                        <md-icon slot="icon">content_copy</md-icon>
                        Copy to clipboard
                    </md-text-button>
                </div>
            </div>
        </div>
    }

    <!-- API Keys List -->
    <div class="space-y-4 mb-8">
        @foreach (var apiKey in Model.ApiKeys)
        {
            <div class="md3-card p-6">
                <div class="flex items-start justify-between">
                    <div class="flex-1">
                        <h3 class="text-lg font-semibold mb-1" style="color: var(--md-sys-color-on-surface);">@apiKey.Name</h3>
                        <div class="font-mono text-sm mb-2" style="color: var(--md-sys-color-on-surface-variant);">@(apiKey.KeyPrefix)...</div>
                        <div class="text-sm space-y-1" style="color: var(--md-sys-color-on-surface-variant);">
                            <div>Created: @apiKey.CreatedAt.ToString("MMM dd, yyyy")</div>
                            <div>
                                Last used:
                                @if (apiKey.LastUsedAt.HasValue)
                                {
                                    @apiKey.LastUsedAt.Value.ToString("MMM dd, yyyy HH:mm")
                                }
                                else
                                {
                                    <text>Never</text>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="ml-4">
                        <form method="post" asp-page-handler="Revoke" class="inline">
                            <input type="hidden" name="apiKeyId" value="@apiKey.Id" />
                            <md-text-button type="submit"
                                            style="--md-text-button-label-text-color: var(--md-sys-color-error);"
                                            onclick="return confirm('Are you sure you want to revoke this API key? This cannot be undone.')">
                                Revoke
                            </md-text-button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @if (!Model.ApiKeys.Any())
        {
            <div class="md3-card p-8 text-center">
                <md-icon style="font-size: 3rem; color: var(--md-sys-color-on-surface-variant); display: block; margin: 0 auto 12px;">key_off</md-icon>
                <p style="color: var(--md-sys-color-on-surface-variant);">No API keys yet. Create one to get started!</p>
            </div>
        }
    </div>

    <!-- Create New Key -->
    <div class="md3-card p-6">
        <h2 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Create New API Key</h2>
        <form method="post" asp-page-handler="Create">
            <div class="mb-4">
                <md-outlined-text-field
                    label="Key Name"
                    name="keyName"
                    id="keyName"
                    required
                    placeholder="e.g., Production, Development, Testing"
                    class="w-full">
                </md-outlined-text-field>
            </div>
            <md-filled-button type="submit">
                <md-icon slot="icon">add</md-icon>
                Create API Key
            </md-filled-button>
        </form>
    </div>

    <!-- Security Warning -->
    <div class="md3-alert-error mt-8 p-4">
        <div class="flex items-start">
            <md-icon style="color: var(--md-sys-color-error); margin-right: 12px; flex-shrink: 0;">shield</md-icon>
            <p class="text-sm" style="color: var(--md-sys-color-on-error-container);">
                <strong>Security Warning:</strong> Never share your API keys or commit them to version control.
                Treat them like passwords. If a key is compromised, revoke it immediately and create a new one.
            </p>
        </div>
    </div>
</div>
