@{
    var seoDescription = ViewData["Description"] as string
        ?? "A turn-based combat game played entirely through REST API endpoints.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - API Combat Game</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="@seoDescription" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script>var _tw=console.warn;console.warn=function(m){if(typeof m==='string'&&m.includes('cdn.tailwindcss.com'))return;_tw.apply(console,arguments)};</script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script>
        (function() {
            if (localStorage.getItem('theme') === 'dark') {
                document.documentElement.classList.add('dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
</head>
<body class="min-h-screen flex flex-col" style="background: var(--md-sys-color-surface); color: var(--md-sys-color-on-surface);">
    <!-- Minimal header: logo only -->
    <nav style="padding: 16px 24px;">
        <a href="/" style="text-decoration: none; display: inline-flex; align-items: center; gap: 10px;">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: var(--md-sys-color-primary);">
                <span class="material-symbols-outlined" style="color: var(--md-sys-color-on-primary); font-size: 18px;">swords</span>
            </div>
            <span class="text-base font-bold" style="color: var(--md-sys-color-on-surface); letter-spacing: -0.02em;">API Combat</span>
        </a>
    </nav>

    <main class="flex-1">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
