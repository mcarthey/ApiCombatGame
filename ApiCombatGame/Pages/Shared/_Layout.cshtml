@using System.Reflection
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - API Combat Game</title>

    @{
        var seoDescription = ViewData["Description"] as string
            ?? "A turn-based combat game played entirely through REST API endpoints. Build your own client, design battle strategies in JSON, and compete on the leaderboard.";
        var seoImage = ViewData["OgImage"] as string ?? "/images/og-default.jpg";
        var canonicalPath = ViewData["CanonicalPath"] as string ?? Context.Request.Path.Value;
        var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var canonicalUrl = $"{baseUrl}{canonicalPath}";
        var ogType = ViewData["OgType"] as string ?? "website";
    }

    <!-- SEO -->
    <meta name="description" content="@seoDescription" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@ViewData["Title"] - API Combat Game" />
    <meta property="og:description" content="@seoDescription" />
    <meta property="og:image" content="@(baseUrl)@(seoImage)" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:site_name" content="API Combat Game" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - API Combat Game" />
    <meta name="twitter:description" content="@seoDescription" />
    <meta name="twitter:image" content="@(baseUrl)@(seoImage)" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- DNS Prefetch -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />

    <!-- Tailwind (layout utilities only — CDN is intentional for this project) -->
    <script>var _tw=console.warn;console.warn=function(m){if(typeof m==='string'&&m.includes('cdn.tailwindcss.com'))return;_tw.apply(console,arguments)};</script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>

    <!-- Material Symbols -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <!-- M3 Theme Tokens -->
    <style>
        :root {
            /* Light theme — derived from primary #2563eb */
            --md-sys-color-primary: #2563eb;
            --md-sys-color-on-primary: #ffffff;
            --md-sys-color-primary-container: #dbeafe;
            --md-sys-color-on-primary-container: #1e3a5f;
            --md-sys-color-secondary: #565e71;
            --md-sys-color-on-secondary: #ffffff;
            --md-sys-color-secondary-container: #dae2f9;
            --md-sys-color-on-secondary-container: #131c2b;
            --md-sys-color-tertiary: #7d5260;
            --md-sys-color-on-tertiary: #ffffff;
            --md-sys-color-tertiary-container: #ffd8e4;
            --md-sys-color-on-tertiary-container: #31111d;
            --md-sys-color-error: #ba1a1a;
            --md-sys-color-on-error: #ffffff;
            --md-sys-color-error-container: #ffdad6;
            --md-sys-color-on-error-container: #410002;
            --md-sys-color-surface: #f9f9ff;
            --md-sys-color-on-surface: #1a1b21;
            --md-sys-color-surface-variant: #e0e2ec;
            --md-sys-color-on-surface-variant: #44464f;
            --md-sys-color-surface-container-lowest: #ffffff;
            --md-sys-color-surface-container-low: #f3f3fb;
            --md-sys-color-surface-container: #edecf4;
            --md-sys-color-surface-container-high: #e7e6ee;
            --md-sys-color-surface-container-highest: #e1e1e9;
            --md-sys-color-outline: #74777f;
            --md-sys-color-outline-variant: #c4c6d0;
            --md-sys-color-inverse-surface: #2f3036;
            --md-sys-color-inverse-on-surface: #f1f0f7;
            --md-sys-color-inverse-primary: #a5c8ff;
            --md-sys-shape-corner-small: 8px;
            --md-sys-shape-corner-medium: 12px;
            --md-sys-shape-corner-large: 16px;
            --md-sys-shape-corner-extra-large: 28px;
            --md-sys-elevation-1: 0 1px 2px rgba(0,0,0,0.15), 0 1px 3px 1px rgba(0,0,0,0.08);
            --md-sys-elevation-2: 0 1px 2px rgba(0,0,0,0.15), 0 2px 6px 2px rgba(0,0,0,0.08);
            --md-sys-elevation-3: 0 4px 8px 3px rgba(0,0,0,0.08), 0 1px 3px rgba(0,0,0,0.15);
            color-scheme: light;
        }

        .dark {
            --md-sys-color-primary: #a5c8ff;
            --md-sys-color-on-primary: #003062;
            --md-sys-color-primary-container: #1a4c8a;
            --md-sys-color-on-primary-container: #d4e3ff;
            --md-sys-color-secondary: #bec6dc;
            --md-sys-color-on-secondary: #283041;
            --md-sys-color-secondary-container: #3e4759;
            --md-sys-color-on-secondary-container: #dae2f9;
            --md-sys-color-tertiary: #efb8c8;
            --md-sys-color-on-tertiary: #492532;
            --md-sys-color-tertiary-container: #633b48;
            --md-sys-color-on-tertiary-container: #ffd8e4;
            --md-sys-color-error: #ffb4ab;
            --md-sys-color-on-error: #690005;
            --md-sys-color-error-container: #93000a;
            --md-sys-color-on-error-container: #ffdad6;
            --md-sys-color-surface: #111318;
            --md-sys-color-on-surface: #e2e1ec;
            --md-sys-color-surface-variant: #44464f;
            --md-sys-color-on-surface-variant: #c4c6d0;
            --md-sys-color-surface-container-lowest: #0c0d12;
            --md-sys-color-surface-container-low: #1a1c24;
            --md-sys-color-surface-container: #1e212a;
            --md-sys-color-surface-container-high: #292c36;
            --md-sys-color-surface-container-highest: #343742;
            --md-sys-color-outline: #8e9099;
            --md-sys-color-outline-variant: #44464f;
            --md-sys-color-inverse-surface: #e2e1ec;
            --md-sys-color-inverse-on-surface: #2f3036;
            --md-sys-color-inverse-primary: #2563eb;
            color-scheme: dark;
        }
    </style>

    <!-- Dark mode restore (before paint) -->
    <script>
        (function() {
            if (localStorage.getItem('theme') === 'dark') {
                document.documentElement.classList.add('dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebSite",
        "name": "API Combat Game",
        "url": "@(baseUrl)",
        "description": "A turn-based combat game played entirely through REST API endpoints.",
        "potentialAction": {
            "@@type": "SearchAction",
            "target": "@(baseUrl)/api-docs/v1#@("{search_term_string}")",
            "query-input": "required name=search_term_string"
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "API Combat Game",
        "applicationCategory": "GameApplication",
        "operatingSystem": "Any (REST API)",
        "description": "@seoDescription",
        "url": "@(baseUrl)",
        "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        }
    }
    </script>
</head>
<body class="min-h-screen flex flex-col" style="background: var(--md-sys-color-surface); color: var(--md-sys-color-on-surface);">
    <!-- Navigation -->
    <nav class="nav-glass sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <a asp-page="/Index" class="flex items-center gap-2.5" style="text-decoration: none;">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: var(--md-sys-color-primary);">
                                <span class="material-symbols-outlined" style="color: var(--md-sys-color-on-primary); font-size: 18px;">swords</span>
                            </div>
                            <span class="text-base font-bold" style="color: var(--md-sys-color-on-surface); letter-spacing: -0.02em;">
                                API Combat
                            </span>
                        </a>
                    </div>
                    @{
                        var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "/";
                        string NavClass(bool isActive) => isActive
                            ? "nav-link-active inline-flex items-center px-1 pt-1 text-sm font-medium"
                            : "nav-link-inactive inline-flex items-center px-1 pt-1 text-sm font-medium";
                    }
                    <div class="hidden sm:ml-8 sm:flex sm:space-x-6">
                        <a asp-page="/Index" class="@NavClass(currentPath == "/")" style="text-decoration: none;">
                            Home
                        </a>
                        <a href="/api-docs/v1" class="@NavClass(currentPath.StartsWith("/api-docs"))" style="text-decoration: none;">
                            API Docs
                        </a>
                        <a asp-page="/Contact" class="@NavClass(currentPath == "/Contact")" style="text-decoration: none;">
                            Contact
                        </a>
                        <a asp-page="/Leaderboard" class="@NavClass(currentPath == "/Leaderboard")" style="text-decoration: none;">
                            Leaderboard
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-page="/Dashboard" class="@NavClass(currentPath == "/Dashboard")" style="text-decoration: none;">
                                Dashboard
                            </a>
                            <a asp-page="/Account/Index" class="@NavClass(currentPath.StartsWith("/Account"))" style="text-decoration: none;">
                                Account
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/Admin" class="@NavClass(currentPath.StartsWith("/Admin"))" style="text-decoration: none;">
                                    Admin
                                </a>
                            }
                        }
                    </div>
                </div>
                <div class="flex items-center space-x-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/Account/Notifications" class="relative" id="notification-bell" title="Notifications" style="display: inline-flex;">
                            <button class="md3-btn-icon" type="button">
                                <span class="material-symbols-outlined">notifications</span>
                            </button>
                            <span id="notification-badge" class="hidden notification-badge"></span>
                        </a>
                    }
                    <button class="md3-btn-icon" data-theme-toggle aria-label="Toggle dark mode">
                        <span class="material-symbols-outlined icon-light">dark_mode</span>
                        <span class="material-symbols-outlined icon-dark" style="display: none;">light_mode</span>
                    </button>
                    <div class="hidden sm:block">
                        <partial name="_LoginPartial" />
                    </div>
                    <!-- Mobile menu button -->
                    <button class="sm:hidden md3-btn-icon" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
                        <span class="material-symbols-outlined" id="mobile-menu-icon">menu</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Mobile navigation drawer -->
    <div id="mobile-menu" class="sm:hidden fixed inset-0 z-40" style="display: none;">
        <div id="mobile-menu-backdrop" class="absolute inset-0" style="background: rgba(0,0,0,0.5);"></div>
        <div class="absolute top-0 right-0 h-full w-72 shadow-xl" style="background: var(--md-sys-color-surface-container); transform: translateX(100%); transition: transform 0.25s ease;" id="mobile-menu-panel">
            <div class="flex items-center justify-between p-4" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                <span class="text-base font-bold" style="color: var(--md-sys-color-on-surface);">Menu</span>
                <button class="md3-btn-icon" id="mobile-menu-close" aria-label="Close menu">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="flex flex-col py-2">
                @{
                    string MobileNavClass(bool isActive) => isActive
                        ? "flex items-center gap-3 px-5 py-3 text-sm font-medium"
                        : "flex items-center gap-3 px-5 py-3 text-sm font-medium";
                    string MobileNavStyle(bool isActive) => isActive
                        ? "color: var(--md-sys-color-primary); background: var(--md-sys-color-primary-container); text-decoration: none;"
                        : "color: var(--md-sys-color-on-surface-variant); text-decoration: none;";
                }
                <a asp-page="/Index" class="@MobileNavClass(currentPath == "/")" style="@MobileNavStyle(currentPath == "/")">
                    <span class="material-symbols-outlined" style="font-size: 20px;">home</span> Home
                </a>
                <a href="/api-docs/v1" class="@MobileNavClass(currentPath.StartsWith("/api-docs"))" style="@MobileNavStyle(currentPath.StartsWith("/api-docs"))">
                    <span class="material-symbols-outlined" style="font-size: 20px;">description</span> API Docs
                </a>
                <a asp-page="/Leaderboard" class="@MobileNavClass(currentPath == "/Leaderboard")" style="@MobileNavStyle(currentPath == "/Leaderboard")">
                    <span class="material-symbols-outlined" style="font-size: 20px;">leaderboard</span> Leaderboard
                </a>
                <a asp-page="/Contact" class="@MobileNavClass(currentPath == "/Contact")" style="@MobileNavStyle(currentPath == "/Contact")">
                    <span class="material-symbols-outlined" style="font-size: 20px;">mail</span> Contact
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="mx-4 my-2" style="border-top: 1px solid var(--md-sys-color-outline-variant);"></div>
                    <a asp-page="/Dashboard" class="@MobileNavClass(currentPath == "/Dashboard")" style="@MobileNavStyle(currentPath == "/Dashboard")">
                        <span class="material-symbols-outlined" style="font-size: 20px;">dashboard</span> Dashboard
                    </a>
                    <a asp-page="/Account/Index" class="@MobileNavClass(currentPath.StartsWith("/Account"))" style="@MobileNavStyle(currentPath.StartsWith("/Account"))">
                        <span class="material-symbols-outlined" style="font-size: 20px;">person</span> Account
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin" class="@MobileNavClass(currentPath.StartsWith("/Admin"))" style="@MobileNavStyle(currentPath.StartsWith("/Admin"))">
                            <span class="material-symbols-outlined" style="font-size: 20px;">admin_panel_settings</span> Admin
                        </a>
                    }
                    <div class="mx-4 my-2" style="border-top: 1px solid var(--md-sys-color-outline-variant);"></div>
                    <div class="px-5 py-2 text-xs" style="color: var(--md-sys-color-outline);">
                        Signed in as @User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                    </div>
                    <form method="post" asp-page="/Auth/Logout" class="px-5 py-1">
                        <button type="submit" class="md3-btn-text" style="padding-left: 0;">
                            <span class="material-symbols-outlined" style="font-size: 20px; margin-right: 8px;">logout</span> Logout
                        </button>
                    </form>
                }
                else
                {
                    <div class="mx-4 my-2" style="border-top: 1px solid var(--md-sys-color-outline-variant);"></div>
                    <a href="/Auth/Login" class="@MobileNavClass(false)" style="@MobileNavStyle(false)">
                        <span class="material-symbols-outlined" style="font-size: 20px;">login</span> Login
                    </a>
                    <a href="/Auth/Register" class="@MobileNavClass(false)" style="@MobileNavStyle(false)">
                        <span class="material-symbols-outlined" style="font-size: 20px;">person_add</span> Sign Up
                    </a>
                }
            </div>
        </div>
    </div>

    <main class="flex-grow">
        @RenderBody()
    </main>

    <footer class="footer-modern mt-auto">
        <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                <div class="md:col-span-2">
                    <div class="flex items-center gap-2.5 mb-4">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: var(--md-sys-color-primary);">
                            <span class="material-symbols-outlined" style="color: var(--md-sys-color-on-primary); font-size: 18px;">swords</span>
                        </div>
                        <span class="text-base font-bold" style="color: var(--md-sys-color-on-surface); letter-spacing: -0.02em;">
                            API Combat Game
                        </span>
                    </div>
                    <p class="text-sm max-w-sm" style="color: var(--md-sys-color-on-surface-variant); line-height: 1.6;">
                        An API-first strategic combat game built for developers. Build clients, design strategies, and compete on the leaderboard.
                    </p>
                </div>
                <div>
                    <h4 class="text-sm font-semibold mb-3" style="color: var(--md-sys-color-on-surface);">Resources</h4>
                    <div class="space-y-2">
                        <a href="/api-docs/v1" class="block text-sm link-underline" style="color: var(--md-sys-color-on-surface-variant);">API Documentation</a>
                        <a href="/openapi/v1.json" class="block text-sm link-underline" style="color: var(--md-sys-color-on-surface-variant);">OpenAPI Spec</a>
                        <a asp-page="/About" class="block text-sm link-underline" style="color: var(--md-sys-color-on-surface-variant);">About</a>
                        <a href="https://discord.gg/jfSCSfAN49" target="_blank" rel="noopener noreferrer" class="block text-sm link-underline" style="color: var(--md-sys-color-on-surface-variant);">Discord</a>
                        <a href="https://github.com/api-combat-game" target="_blank" rel="noopener noreferrer" class="block text-sm link-underline" style="color: var(--md-sys-color-on-surface-variant);">GitHub</a>
                    </div>
                </div>
                <div>
                    <h4 class="text-sm font-semibold mb-3" style="color: var(--md-sys-color-on-surface);">Legal</h4>
                    <div class="space-y-2">
                        <a asp-page="/Terms" class="block text-sm link-underline" style="color: var(--md-sys-color-on-surface-variant);">Terms of Service</a>
                        <a asp-page="/Privacy" class="block text-sm link-underline" style="color: var(--md-sys-color-on-surface-variant);">Privacy Policy</a>
                        <a asp-page="/Contact" class="block text-sm link-underline" style="color: var(--md-sys-color-on-surface-variant);">Contact</a>
                    </div>
                </div>
            </div>
            <div class="pt-6" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
                <div class="flex flex-col sm:flex-row justify-between gap-2">
                    <p class="text-xs" style="color: var(--md-sys-color-outline);">
                        &copy; @DateTime.UtcNow.Year API Combat Game. Built for developers who think in JSON.
                        <span style="margin-left: 0.25rem;">&mdash;</span>
                        <a href="https://learnedgeek.com" target="_blank" rel="noopener noreferrer"
                           class="link-underline" style="color: var(--md-sys-color-outline);">Built by LearnedGeek</a>
                    </p>
                    <p class="text-xs" style="color: var(--md-sys-color-outline);">
                        v@(System.Reflection.Assembly.GetExecutingAssembly().GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "1.0.0")
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (function () {
                const badge = document.getElementById('notification-badge');
                if (!badge) return;
                async function checkNotifications() {
                    try {
                        const res = await fetch('/api/v1/player/notifications/count');
                        if (res.ok) {
                            const data = await res.json();
                            if (data.unreadCount > 0) {
                                badge.textContent = data.unreadCount > 99 ? '99+' : data.unreadCount;
                                badge.classList.remove('hidden');
                            } else {
                                badge.classList.add('hidden');
                            }
                        }
                    } catch (e) { /* silent */ }
                }
                checkNotifications();
                setInterval(checkNotifications, 60000);
            })();
        </script>
    }
    <script src="~/js/celebrations.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/egg-hunt.js"></script>
    }
    <script src="https://unpkg.com/@@dotlottie/player-component@@2/dist/dotlottie-player.mjs" type="module"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Cookie Consent Banner -->
    <div id="cookieConsent" style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:9999; padding:16px 24px; background:var(--md-sys-color-surface-container-high); border-top:1px solid var(--md-sys-color-outline-variant); box-shadow:0 -2px 8px rgba(0,0,0,0.15);">
        <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
            <p class="text-sm" style="color:var(--md-sys-color-on-surface-variant); margin:0;">
                We use essential cookies only &mdash; for authentication and site functionality. No tracking, no analytics.
                <a asp-page="/Privacy" style="color:var(--md-sys-color-primary);">Learn more</a>
            </p>
            <button onclick="acceptCookies()" class="md3-btn-filled" style="white-space:nowrap;">Got it</button>
        </div>
    </div>
    <script>
        function acceptCookies() {
            localStorage.setItem('cookie_consent', 'acknowledged');
            document.getElementById('cookieConsent').style.display = 'none';
        }
        if (!localStorage.getItem('cookie_consent')) {
            document.getElementById('cookieConsent').style.display = 'block';
        }
    </script>
</body>
</html>
