@model EndpointInfo

@{
    var methodColors = new Dictionary<string, (string bg, string text)>
    {
        ["GET"] = ("var(--md-sys-color-primary-container)", "var(--md-sys-color-on-primary-container)"),
        ["POST"] = ("var(--md-sys-color-secondary-container)", "var(--md-sys-color-on-secondary-container)"),
        ["PUT"] = ("var(--md-sys-color-tertiary-container)", "var(--md-sys-color-on-tertiary-container)"),
        ["DELETE"] = ("var(--md-sys-color-error-container)", "var(--md-sys-color-on-error-container)"),
        ["PATCH"] = ("var(--md-sys-color-tertiary-container)", "var(--md-sys-color-on-tertiary-container)")
    };

    var difficultyConfig = new Dictionary<string, (string label, string color)>
    {
        ["beginner"] = ("Beginner", "var(--md-sys-color-primary)"),
        ["intermediate"] = ("Intermediate", "var(--md-sys-color-tertiary-container)"),
        ["advanced"] = ("Advanced", "var(--md-sys-color-error)")
    };

    var (bg, text) = methodColors.GetValueOrDefault(Model.Method, ("var(--md-sys-color-surface-container-high)", "var(--md-sys-color-on-surface)"));
    var anchorId = $"{Model.Method.ToLower()}-{Model.Path.TrimStart('/').Replace("/", "-").Replace("{", "").Replace("}", "")}";

    // Lightweight markdown→HTML for XML doc comments
    string RenderMarkdown(string md)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(md);
        // **bold**
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        // `code`
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"`([^`]+)`",
            "<code style=\"background:var(--md-sys-color-surface-container-high);padding:1px 4px;border-radius:3px;font-size:0.85em;\">$1</code>");
        // Bullet lines: "- text" → list items
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"(?m)^- (.+)$", "<li>$1</li>");
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"(<li>.*?</li>(\s*<li>.*?</li>)*)", "<ul class=\"list-disc ml-4 space-y-0.5\">$1</ul>");
        // Double newlines → paragraph breaks
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\n\n+", "</p><p>");
        // Single newlines within paragraphs
        encoded = encoded.Replace("\n", "<br/>");
        return $"<p>{encoded}</p>";
    }
}

<details id="@anchorId" class="group md3-card overflow-hidden stat-card">
    <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
        <span class="inline-flex items-center justify-center px-2.5 py-1 text-xs font-bold tracking-wider min-w-[4rem]" style="background: @bg; color: @text; border-radius: var(--md-sys-shape-corner-small);">
            @Model.Method
        </span>
        <code class="text-sm font-mono flex-1" style="color: var(--md-sys-color-on-surface);">@Model.Path</code>

        @if (!string.IsNullOrEmpty(Model.Difficulty) && difficultyConfig.TryGetValue(Model.Difficulty, out var diff))
        {
            <span class="hidden sm:inline-flex items-center gap-1.5 text-xs" style="color: @diff.color;">
                <span class="w-1.5 h-1.5" style="border-radius: 50%; background: @diff.color;"></span>
                @diff.label
            </span>
        }

        @if (Model.RequiresAuth)
        {
            <span class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 text-xs" style="background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface-variant); border-radius: var(--md-sys-shape-corner-small);">
                <span class="material-symbols-outlined" style="font-size: 14px; width: 14px; height: 14px;">lock</span>
                Auth
            </span>
        }
        else
        {
            <span class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 text-xs" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">
                Public
            </span>
        }

        <span class="material-symbols-outlined shrink-0 transition-transform group-open:rotate-180" style="color: var(--md-sys-color-on-surface-variant); font-size: 18px;">expand_more</span>
    </summary>

    <div class="px-5 pb-5 pt-4 space-y-4" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <p style="color: var(--md-sys-color-on-surface);">@Model.Summary</p>
        }

        @if (!string.IsNullOrEmpty(Model.Description) && Model.Description != Model.Summary)
        {
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">@Html.Raw(RenderMarkdown(Model.Description))</div>
        }

        @* Prerequisites *@
        @if (Model.Prerequisites.Any())
        {
            <div class="flex items-start gap-2 text-sm">
                <span class="font-medium shrink-0 mt-0.5" style="color: var(--md-sys-color-on-surface-variant);">Prerequisites:</span>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var prereq in Model.Prerequisites)
                    {
                        <span class="md3-chip">@prereq</span>
                    }
                </div>
            </div>
        }

        @* Parameters *@
        @if (Model.Parameters.Any())
        {
            <div>
                <h4 class="text-sm font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">Parameters</h4>
                <div class="overflow-hidden" style="border-radius: var(--md-sys-shape-corner-medium);">
                    <table class="md3-table w-full text-sm">
                        <thead>
                            <tr>
                                <th class="px-4 py-2 text-left text-xs font-medium uppercase">Name</th>
                                <th class="px-4 py-2 text-left text-xs font-medium uppercase">In</th>
                                <th class="px-4 py-2 text-left text-xs font-medium uppercase">Type</th>
                                <th class="px-4 py-2 text-left text-xs font-medium uppercase">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var param in Model.Parameters)
                            {
                                <tr>
                                    <td class="px-4 py-2 font-mono text-xs">
                                        @param.Name
                                        @if (param.Required)
                                        {
                                            <span style="color: var(--md-sys-color-error);">*</span>
                                        }
                                    </td>
                                    <td class="px-4 py-2 text-xs" style="color: var(--md-sys-color-on-surface-variant);">@param.In</td>
                                    <td class="px-4 py-2">
                                        <span class="text-xs px-1.5 py-0.5 font-mono" style="background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface); border-radius: var(--md-sys-shape-corner-small);">@param.Type</span>
                                    </td>
                                    <td class="px-4 py-2 text-xs" style="color: var(--md-sys-color-on-surface-variant);">
                                        @param.Description
                                        @if (param.Default != null)
                                        {
                                            <span style="color: var(--md-sys-color-outline);">(default: @param.Default)</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* Request Body Schema + Examples side-by-side *@
        @if (Model.RequestBody?.Properties?.Any() == true || Model.Examples.Any())
        {
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                @* Left: Schema + Responses *@
                <div class="space-y-4">
                    @if (Model.RequestBody?.Properties?.Any() == true)
                    {
                        <div>
                            <h4 class="text-sm font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">Request Body</h4>
                            <partial name="ApiDocs/_SchemaTable" model="Model.RequestBody" />
                        </div>
                    }

                    @if (Model.Responses.Any())
                    {
                        <div>
                            <h4 class="text-sm font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">Responses</h4>
                            <div class="space-y-1.5">
                                @foreach (var (code, response) in Model.Responses)
                                {
                                    var codeColor = code.StartsWith("2") ? "var(--md-sys-color-primary)" :
                                                    code.StartsWith("4") ? "var(--md-sys-color-tertiary)" :
                                                    code.StartsWith("5") ? "var(--md-sys-color-error)" : "var(--md-sys-color-on-surface-variant)";
                                    <div class="flex items-start gap-3 text-sm">
                                        <code class="font-mono font-bold min-w-[2.5rem]" style="color: @codeColor;">@code</code>
                                        <span style="color: var(--md-sys-color-on-surface-variant);">@response.Description</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @* Right: Examples *@
                <div>
                    @if (Model.Examples.Any())
                    {
                        <h4 class="text-sm font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">Examples</h4>
                        @foreach (var example in Model.Examples)
                        {
                            <div class="space-y-2">
                                <span class="text-xs font-medium uppercase tracking-wide" style="color: var(--md-sys-color-on-surface-variant);">@example.Name</span>
                                @if (example.Request != null)
                                {
                                    <partial name="ApiDocs/_CodeBlock" model="@(new CodeBlockModel { Label = "Request", Code = example.Request, Language = "json" })" />
                                }
                                @if (example.Response != null)
                                {
                                    <partial name="ApiDocs/_CodeBlock" model="@(new CodeBlockModel { Label = "Response", Code = example.Response, Language = "json" })" />
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
        else if (Model.Responses.Any())
        {
            @* Responses only (no schema or examples) *@
            <div>
                <h4 class="text-sm font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">Responses</h4>
                <div class="space-y-1.5">
                    @foreach (var (code, response) in Model.Responses)
                    {
                        var codeColor = code.StartsWith("2") ? "var(--md-sys-color-primary)" :
                                        code.StartsWith("4") ? "var(--md-sys-color-tertiary)" :
                                        code.StartsWith("5") ? "var(--md-sys-color-error)" : "var(--md-sys-color-on-surface-variant)";
                        <div class="flex items-start gap-3 text-sm">
                            <code class="font-mono font-bold min-w-[2.5rem]" style="color: @codeColor;">@code</code>
                            <span style="color: var(--md-sys-color-on-surface-variant);">@response.Description</span>
                        </div>
                    }
                </div>
            </div>
        }

        @* Game Tips *@
        @if (Model.GameTips.Any())
        {
            <div class="space-y-2">
                @foreach (var tip in Model.GameTips)
                {
                    <div class="md3-alert-info flex gap-3">
                        <span class="material-symbols-outlined shrink-0 mt-0.5" style="font-size: 18px;">tips_and_updates</span>
                        <span class="text-sm">@tip</span>
                    </div>
                }
            </div>
        }
    </div>
</details>
