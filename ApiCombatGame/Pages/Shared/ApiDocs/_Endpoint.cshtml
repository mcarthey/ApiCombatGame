@model EndpointInfo

@{
    var methodColors = new Dictionary<string, (string bg, string text, string darkBg)>
    {
        ["GET"] = ("bg-emerald-100", "text-emerald-700", "dark:bg-emerald-900/30 dark:text-emerald-400"),
        ["POST"] = ("bg-blue-100", "text-blue-700", "dark:bg-blue-900/30 dark:text-blue-400"),
        ["PUT"] = ("bg-amber-100", "text-amber-700", "dark:bg-amber-900/30 dark:text-amber-400"),
        ["DELETE"] = ("bg-red-100", "text-red-700", "dark:bg-red-900/30 dark:text-red-400"),
        ["PATCH"] = ("bg-purple-100", "text-purple-700", "dark:bg-purple-900/30 dark:text-purple-400")
    };

    var difficultyConfig = new Dictionary<string, (string label, string color, string dot)>
    {
        ["beginner"] = ("Beginner", "text-emerald-600 dark:text-emerald-400", "bg-emerald-500"),
        ["intermediate"] = ("Intermediate", "text-amber-600 dark:text-amber-400", "bg-amber-500"),
        ["advanced"] = ("Advanced", "text-red-600 dark:text-red-400", "bg-red-500")
    };

    var (bg, text, darkBg) = methodColors.GetValueOrDefault(Model.Method, ("bg-gray-100", "text-gray-700", "dark:bg-gray-800 dark:text-gray-400"));
    var anchorId = $"{Model.Method.ToLower()}-{Model.Path.TrimStart('/').Replace("/", "-").Replace("{", "").Replace("}", "")}";
}

<details id="@anchorId" class="group bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden transition-shadow hover:shadow-md">
    <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
        <span class="inline-flex items-center justify-center px-2.5 py-1 rounded text-xs font-bold tracking-wider min-w-[4rem] @bg @text @darkBg">
            @Model.Method
        </span>
        <code class="text-sm font-mono text-gray-800 dark:text-gray-200 flex-1">@Model.Path</code>

        @if (!string.IsNullOrEmpty(Model.Difficulty) && difficultyConfig.TryGetValue(Model.Difficulty, out var diff))
        {
            <span class="hidden sm:inline-flex items-center gap-1.5 text-xs @diff.color">
                <span class="w-1.5 h-1.5 rounded-full @diff.dot"></span>
                @diff.label
            </span>
        }

        @if (Model.RequiresAuth)
        {
            <span class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                Auth
            </span>
        }
        else
        {
            <span class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400">
                Public
            </span>
        }

        <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </summary>

    <div class="px-5 pb-5 border-t border-gray-100 dark:border-gray-700 pt-4 space-y-4">
        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <p class="text-gray-700 dark:text-gray-300">@Model.Summary</p>
        }

        @if (!string.IsNullOrEmpty(Model.Description) && Model.Description != Model.Summary)
        {
            <p class="text-sm text-gray-500 dark:text-gray-400">@Model.Description</p>
        }

        @* Prerequisites *@
        @if (Model.Prerequisites.Any())
        {
            <div class="flex items-start gap-2 text-sm">
                <span class="text-gray-500 dark:text-gray-400 font-medium shrink-0 mt-0.5">Prerequisites:</span>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var prereq in Model.Prerequisites)
                    {
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
                            @prereq
                        </span>
                    }
                </div>
            </div>
        }

        @* Parameters *@
        @if (Model.Parameters.Any())
        {
            <div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Parameters</h4>
                <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 dark:bg-gray-900/50">
                            <tr>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Name</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">In</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Type</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Description</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                            @foreach (var param in Model.Parameters)
                            {
                                <tr>
                                    <td class="px-4 py-2 font-mono text-xs text-gray-800 dark:text-gray-200">
                                        @param.Name
                                        @if (param.Required)
                                        {
                                            <span class="text-red-500">*</span>
                                        }
                                    </td>
                                    <td class="px-4 py-2 text-xs text-gray-500 dark:text-gray-400">@param.In</td>
                                    <td class="px-4 py-2">
                                        <span class="text-xs px-1.5 py-0.5 rounded bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 font-mono">@param.Type</span>
                                    </td>
                                    <td class="px-4 py-2 text-xs text-gray-600 dark:text-gray-400">
                                        @param.Description
                                        @if (param.Default != null)
                                        {
                                            <span class="text-gray-400">(default: @param.Default)</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* Request Body Schema *@
        @if (Model.RequestBody?.Properties?.Any() == true)
        {
            <div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Request Body</h4>
                <partial name="ApiDocs/_SchemaTable" model="Model.RequestBody" />
            </div>
        }

        @* Response Codes *@
        @if (Model.Responses.Any())
        {
            <div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Responses</h4>
                <div class="space-y-1.5">
                    @foreach (var (code, response) in Model.Responses)
                    {
                        var codeColor = code.StartsWith("2") ? "text-emerald-600 dark:text-emerald-400" :
                                        code.StartsWith("4") ? "text-amber-600 dark:text-amber-400" :
                                        code.StartsWith("5") ? "text-red-600 dark:text-red-400" : "text-gray-600";
                        <div class="flex items-start gap-3 text-sm">
                            <code class="font-mono font-bold @codeColor min-w-[2.5rem]">@code</code>
                            <span class="text-gray-600 dark:text-gray-400">@response.Description</span>
                        </div>
                    }
                </div>
            </div>
        }

        @* Code Examples *@
        @if (Model.Examples.Any())
        {
            <div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Examples</h4>
                @foreach (var example in Model.Examples)
                {
                    <div class="space-y-2">
                        <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide">@example.Name</span>
                        @if (example.Request != null)
                        {
                            <partial name="ApiDocs/_CodeBlock" model="@(new CodeBlockModel { Label = "Request", Code = example.Request, Language = "json" })" />
                        }
                        @if (example.Response != null)
                        {
                            <partial name="ApiDocs/_CodeBlock" model="@(new CodeBlockModel { Label = "Response", Code = example.Response, Language = "json" })" />
                        }
                    </div>
                }
            </div>
        }

        @* Game Tips *@
        @if (Model.GameTips.Any())
        {
            <div class="space-y-2">
                @foreach (var tip in Model.GameTips)
                {
                    <div class="flex gap-3 p-3 rounded-lg bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800/30">
                        <svg class="w-4 h-4 text-blue-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                        </svg>
                        <span class="text-sm text-blue-800 dark:text-blue-200">@tip</span>
                    </div>
                }
            </div>
        }
    </div>
</details>
