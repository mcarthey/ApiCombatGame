@model TagGroup

@{
    var iconMap = new Dictionary<string, string>
    {
        ["shield"] = "shield",
        ["user"] = "person",
        ["users"] = "groups",
        ["swords"] = "bolt",
        ["trophy"] = "star",
        ["store"] = "store",
        ["target"] = "track_changes",
        ["dragon"] = "local_fire_department",
        ["star"] = "star",
        ["bolt"] = "bolt",
        ["film"] = "movie",
        ["code"] = "code"
    };
    var iconName = iconMap.GetValueOrDefault(Model.Icon, "code");
    var anchorId = Model.Name.ToLower().Replace(" ", "-");
}

<section id="@anchorId" class="scroll-mt-24">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 flex items-center justify-center" style="border-radius: var(--md-sys-shape-corner-medium); background-color: @(Model.Color)20;">
            <span class="material-symbols-outlined" style="color: @Model.Color;">@iconName</span>
        </div>
        <div>
            <h2 class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Name</h2>
            <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">@Model.Description</p>
        </div>
    </div>

    <div class="space-y-4">
        @foreach (var endpoint in Model.Endpoints)
        {
            <partial name="ApiDocs/_Endpoint" model="endpoint" />
        }
    </div>
</section>
