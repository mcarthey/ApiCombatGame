@* Sidebar navigation for account pages *@
@{
    var activePage = ViewContext.RouteData.Values["page"]?.ToString();
    string ItemStyle(string page) => activePage == page
        ? "background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container);"
        : "color: var(--md-sys-color-on-surface-variant);";
}
<nav class="space-y-1">
    <a asp-page="/Account/Index"
       class="flex items-center px-3 py-2 text-sm font-medium rounded-md"
       style="@ItemStyle("/Account/Index") text-decoration: none;">
        <span class="material-symbols-outlined mr-3" style="font-size: 20px;">person</span>
        Account Overview
    </a>
    <a asp-page="/Account/Subscription"
       class="flex items-center px-3 py-2 text-sm font-medium rounded-md"
       style="@ItemStyle("/Account/Subscription") text-decoration: none;">
        <span class="material-symbols-outlined mr-3" style="font-size: 20px;">star</span>
        Subscription
    </a>
    <a asp-page="/Account/Billing"
       class="flex items-center px-3 py-2 text-sm font-medium rounded-md"
       style="@ItemStyle("/Account/Billing") text-decoration: none;">
        <span class="material-symbols-outlined mr-3" style="font-size: 20px;">receipt_long</span>
        Billing
    </a>
    <a asp-page="/Account/ApiKeys"
       class="flex items-center px-3 py-2 text-sm font-medium rounded-md"
       style="@ItemStyle("/Account/ApiKeys") text-decoration: none;">
        <span class="material-symbols-outlined mr-3" style="font-size: 20px;">key</span>
        API Keys
    </a>
    <a asp-page="/Account/Settings"
       class="flex items-center px-3 py-2 text-sm font-medium rounded-md"
       style="@ItemStyle("/Account/Settings") text-decoration: none;">
        <span class="material-symbols-outlined mr-3" style="font-size: 20px;">settings</span>
        Settings
    </a>
</nav>
