@* Sidebar navigation for account pages *@
@{
    var activePage = ViewContext.RouteData.Values["page"]?.ToString();
    string ItemStyle(string page) => activePage == page
        ? "background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container);"
        : "color: var(--md-sys-color-on-surface-variant);";
}
<nav class="space-y-1">
    <a asp-page="/Account/Index"
       class="flex items-center px-3 py-2 text-sm font-medium rounded-md"
       style="@ItemStyle("/Account/Index")">
        <md-icon class="mr-3" style="font-size: 20px;">person</md-icon>
        Account Overview
    </a>
    <a asp-page="/Account/Subscription"
       class="flex items-center px-3 py-2 text-sm font-medium rounded-md"
       style="@ItemStyle("/Account/Subscription")">
        <md-icon class="mr-3" style="font-size: 20px;">star</md-icon>
        Subscription
    </a>
    <a asp-page="/Account/Billing"
       class="flex items-center px-3 py-2 text-sm font-medium rounded-md"
       style="@ItemStyle("/Account/Billing")">
        <md-icon class="mr-3" style="font-size: 20px;">receipt_long</md-icon>
        Billing
    </a>
    <a asp-page="/Account/ApiKeys"
       class="flex items-center px-3 py-2 text-sm font-medium rounded-md"
       style="@ItemStyle("/Account/ApiKeys")">
        <md-icon class="mr-3" style="font-size: 20px;">key</md-icon>
        API Keys
    </a>
    <a asp-page="/Account/Settings"
       class="flex items-center px-3 py-2 text-sm font-medium rounded-md"
       style="@ItemStyle("/Account/Settings")">
        <md-icon class="mr-3" style="font-size: 20px;">settings</md-icon>
        Settings
    </a>
</nav>
