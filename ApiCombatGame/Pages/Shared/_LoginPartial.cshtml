@using System.Security.Claims

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="flex items-center space-x-2">
        <span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
            @User.FindFirstValue(ClaimTypes.Name)
        </span>
        <a href="/Dashboard" class="md3-btn-text" style="text-decoration: none;">Dashboard</a>
        <form method="post" asp-page="/Auth/Logout" class="inline">
            <button type="submit" class="md3-btn-text">Logout</button>
        </form>
    </div>
}
else
{
    <div class="flex items-center space-x-2">
        <a href="/Auth/Login" class="md3-btn-text" style="text-decoration: none;">Login</a>
        <a href="/Auth/Register" class="md3-btn-filled" style="text-decoration: none;">Sign Up</a>
    </div>
}
