@using System.Security.Claims

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="flex items-center space-x-2">
        <span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
            @User.FindFirstValue(ClaimTypes.Name)
        </span>
        <md-text-button href="/Dashboard">Dashboard</md-text-button>
        <form method="post" asp-page="/Auth/Logout" class="inline">
            <md-text-button type="submit">Logout</md-text-button>
        </form>
    </div>
}
else
{
    <div class="flex items-center space-x-2">
        <md-text-button href="/Auth/Login">Login</md-text-button>
        <md-filled-button href="/Auth/Register">Sign Up</md-filled-button>
    </div>
}
