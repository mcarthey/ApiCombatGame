@page
@model ApiCombatGame.Pages.Admin.MetaModel
@{
    ViewData["Title"] = "Meta & Balance";
    Layout = "_AdminLayout";
}

<!-- Time Range Selector -->
<div class="flex gap-2 mb-6">
    <a href="/Admin/Meta?Days=1" class="px-4 py-2 rounded-lg text-sm font-medium @(Model.Days == 1 ? "bg-blue-600 text-white" : "bg-white dark:bg-gray-800 border dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700")">24h</a>
    <a href="/Admin/Meta?Days=7" class="px-4 py-2 rounded-lg text-sm font-medium @(Model.Days == 7 ? "bg-blue-600 text-white" : "bg-white dark:bg-gray-800 border dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700")">7 Days</a>
    <a href="/Admin/Meta?Days=14" class="px-4 py-2 rounded-lg text-sm font-medium @(Model.Days == 14 ? "bg-blue-600 text-white" : "bg-white dark:bg-gray-800 border dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700")">14 Days</a>
    <a href="/Admin/Meta?Days=30" class="px-4 py-2 rounded-lg text-sm font-medium @(Model.Days == 30 ? "bg-blue-600 text-white" : "bg-white dark:bg-gray-800 border dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700")">30 Days</a>
</div>

<!-- Battle Count -->
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700 mb-6">
    <div class="text-sm text-gray-500 dark:text-gray-400">Battles in period</div>
    <div class="text-3xl font-bold">@Model.Data.TotalBattlesInPeriod.ToString("N0")</div>
    <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">Last @Model.Data.Days days</div>
</div>

<!-- Unit Class Win Rates -->
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border dark:border-gray-700 overflow-hidden mb-6">
    <div class="px-6 py-4 border-b dark:border-gray-700">
        <h3 class="text-lg font-semibold">Unit Class Performance</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">Win rates by unit class. Target: 45-55% (balanced)</p>
    </div>
    @if (Model.Data.UnitClassStats.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-900">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Class</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Usage</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Win Rate</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Visual</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @foreach (var stat in Model.Data.UnitClassStats)
                    {
                        var statusColor = stat.Status switch
                        {
                            "OP" => "bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300",
                            "UP" => "bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-300",
                            "Watch" => "bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300",
                            "Balanced" => "bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300",
                            _ => "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300"
                        };
                        var barColor = stat.Status switch
                        {
                            "OP" => "bg-red-500",
                            "UP" => "bg-orange-500",
                            "Watch" => "bg-yellow-500",
                            "Balanced" => "bg-green-500",
                            _ => "bg-gray-400"
                        };
                        <tr>
                            <td class="px-6 py-4 font-medium">@stat.ClassName</td>
                            <td class="px-6 py-4 text-sm">
                                @stat.TimesUsed times (@stat.UsageRate%)
                            </td>
                            <td class="px-6 py-4 font-medium">
                                @stat.WinRate%
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 text-xs font-medium rounded-full @statusColor">@stat.Status</span>
                            </td>
                            <td class="px-6 py-4 w-48">
                                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-3 relative">
                                    <div class="@barColor h-3 rounded-full" style="width: @Math.Min(100, stat.WinRate)%"></div>
                                    <div class="absolute top-0 left-1/2 w-px h-3 bg-gray-400 dark:bg-gray-500" title="50% target"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">No battle data available for this period.</div>
    }
</div>

<!-- Current Modifier -->
@if (Model.Data.CurrentModifier != null)
{
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700 mb-6">
        <h3 class="text-lg font-semibold mb-2">Active Environmental Modifier</h3>
        <div class="flex items-center gap-4">
            <div class="bg-yellow-100 dark:bg-yellow-900/30 p-3 rounded-lg">
                <svg class="w-8 h-8 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div>
                <div class="font-bold text-lg">@Model.Data.CurrentModifier.Name</div>
                <div class="text-gray-600 dark:text-gray-400">@Model.Data.CurrentModifier.Description</div>
                <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                    @Model.Data.CurrentModifier.StartDate.ToString("MMM dd") - @Model.Data.CurrentModifier.EndDate.ToString("MMM dd, yyyy")
                </div>
            </div>
        </div>
    </div>
}

<!-- Top Strategies -->
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 border-b dark:border-gray-700">
        <h3 class="text-lg font-semibold">Top Marketplace Strategies</h3>
    </div>
    @if (Model.Data.TopStrategies.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-900">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Strategy</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Creator</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Downloads</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Rating</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @foreach (var strat in Model.Data.TopStrategies)
                    {
                        <tr>
                            <td class="px-6 py-4 font-medium">@strat.Name</td>
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">@strat.CreatorName</td>
                            <td class="px-6 py-4 text-sm">@strat.Downloads</td>
                            <td class="px-6 py-4 text-sm">@strat.Rating.ToString("F1")/5</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">No marketplace strategies yet.</div>
    }
</div>
