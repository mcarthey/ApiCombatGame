@page
@model ApiCombatGame.Pages.Admin.MetaModel
@{
    ViewData["Title"] = "Meta & Balance";
    Layout = "_AdminLayout";
}

<!-- Time Range Selector -->
<div class="flex gap-2 mb-6">
    @{
        var days = new[] { (1, "24h"), (7, "7 Days"), (14, "14 Days"), (30, "30 Days") };
    }
    @foreach (var (d, label) in days)
    {
        @if (Model.Days == d)
        {
            <a href="/Admin/Meta?Days=@d" class="md3-btn-tonal" style="text-decoration: none;">
                @label
            </a>
        }
        else
        {
            <a href="/Admin/Meta?Days=@d" class="md3-btn-outlined" style="text-decoration: none;">
                @label
            </a>
        }
    }
</div>

<!-- Battle Count -->
<div class="md3-card p-6 mb-6">
    <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Battles in period</div>
    <div class="text-3xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalBattlesInPeriod.ToString("N0")</div>
    <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Last @Model.Data.Days days</div>
</div>

<!-- Unit Class Win Rates -->
<div class="md3-card overflow-hidden mb-6">
    <div class="px-6 py-4" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h3 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Unit Class Performance</h3>
        <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Win rates by unit class. Target: 45-55% (balanced)</p>
    </div>
    @if (Model.Data.UnitClassStats.Any())
    {
        <div class="overflow-x-auto">
            <table class="md3-table min-w-full">
                <thead>
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Class</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Usage</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Win Rate</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Visual</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in Model.Data.UnitClassStats)
                    {
                        var statusBadge = stat.Status switch
                        {
                            "OP" => "md3-badge-error",
                            "UP" => "md3-badge-tertiary",
                            "Watch" => "md3-badge-secondary",
                            "Balanced" => "md3-badge-primary",
                            _ => "md3-badge-secondary"
                        };
                        var barColor = stat.Status switch
                        {
                            "OP" => "var(--md-sys-color-error)",
                            "UP" => "var(--md-sys-color-tertiary-container)",
                            "Watch" => "var(--md-sys-color-secondary-container)",
                            "Balanced" => "var(--md-sys-color-primary)",
                            _ => "var(--md-sys-color-outline)"
                        };
                        <tr>
                            <td class="px-6 py-4 font-medium" style="color: var(--md-sys-color-on-surface);">@stat.ClassName</td>
                            <td class="px-6 py-4 text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                                @stat.TimesUsed times (@stat.UsageRate%)
                            </td>
                            <td class="px-6 py-4 font-medium" style="color: var(--md-sys-color-on-surface);">
                                @stat.WinRate%
                            </td>
                            <td class="px-6 py-4">
                                <span class="@statusBadge">@stat.Status</span>
                            </td>
                            <td class="px-6 py-4 w-48">
                                <div class="relative">
                                    <div class="md3-progress"><div class="md3-progress-bar" style="width: @(Math.Min(100, stat.WinRate))%; background: @barColor;"></div></div>
                                    <div class="absolute top-0 left-1/2 w-px h-full" style="background: var(--md-sys-color-outline);" title="50% target"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-8 text-center" style="color: var(--md-sys-color-on-surface-variant);">No battle data available for this period.</div>
    }
</div>

<!-- Current Modifier -->
@if (Model.Data.CurrentModifier != null)
{
    <div class="md3-card p-6 mb-6">
        <h3 class="text-lg font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">Active Environmental Modifier</h3>
        <div class="flex items-center gap-4">
            <div class="p-3" style="background: var(--md-sys-color-tertiary-container); border-radius: var(--md-sys-shape-corner-medium);">
                <span class="material-symbols-outlined" style="color: var(--md-sys-color-on-tertiary-container); font-size: 32px; width: 32px; height: 32px;">bolt</span>
            </div>
            <div>
                <div class="font-bold text-lg" style="color: var(--md-sys-color-on-surface);">@Model.Data.CurrentModifier.Name</div>
                <div style="color: var(--md-sys-color-on-surface-variant);">@Model.Data.CurrentModifier.Description</div>
                <div class="text-sm mt-1" style="color: var(--md-sys-color-outline);">
                    @Model.Data.CurrentModifier.StartDate.ToString("MMM dd") - @Model.Data.CurrentModifier.EndDate.ToString("MMM dd, yyyy")
                </div>
            </div>
        </div>
    </div>
}

<!-- Top Strategies -->
<div class="md3-card overflow-hidden">
    <div class="px-6 py-4" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h3 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Top Marketplace Strategies</h3>
    </div>
    @if (Model.Data.TopStrategies.Any())
    {
        <div class="overflow-x-auto">
            <table class="md3-table min-w-full">
                <thead>
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Strategy</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Creator</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Downloads</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Rating</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var strat in Model.Data.TopStrategies)
                    {
                        <tr>
                            <td class="px-6 py-4 font-medium" style="color: var(--md-sys-color-on-surface);">@strat.Name</td>
                            <td class="px-6 py-4 text-sm" style="color: var(--md-sys-color-on-surface-variant);">@strat.CreatorName</td>
                            <td class="px-6 py-4 text-sm" style="color: var(--md-sys-color-on-surface);">@strat.Downloads</td>
                            <td class="px-6 py-4 text-sm" style="color: var(--md-sys-color-on-surface);">@strat.Rating.ToString("F1")/5</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-8 text-center" style="color: var(--md-sys-color-on-surface-variant);">No marketplace strategies yet.</div>
    }
</div>
