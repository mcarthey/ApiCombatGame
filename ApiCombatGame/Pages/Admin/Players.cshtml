@page
@model ApiCombatGame.Pages.Admin.PlayersModel
@{
    ViewData["Title"] = "Player Analytics";
    Layout = "_AdminLayout";

    // Helper to build sort link for a column
    string SortUrl(string column)
    {
        var newDesc = Model.SortBy?.Equals(column, StringComparison.OrdinalIgnoreCase) == true ? !Model.SortDesc : true;
        var qs = Model.FilterQuery;
        return $"/Admin/Players?{qs}{(string.IsNullOrEmpty(qs) ? "" : "&")}SortBy={column}&SortDesc={newDesc}";
    }

    string SortIcon(string column)
    {
        if (Model.SortBy?.Equals(column, StringComparison.OrdinalIgnoreCase) != true)
            return "unfold_more";
        return Model.SortDesc ? "arrow_downward" : "arrow_upward";
    }

    string SortColor(string column)
    {
        return Model.SortBy?.Equals(column, StringComparison.OrdinalIgnoreCase) == true
            ? "color: var(--md-sys-color-primary);"
            : "color: var(--md-sys-color-on-surface-variant);";
    }

    // Query string for pagination links (preserves filters + sort)
    var paginationQuery = Model.FilterQuery;
    if (!string.IsNullOrEmpty(Model.SortBy))
        paginationQuery += $"{(string.IsNullOrEmpty(paginationQuery) ? "" : "&")}SortBy={Model.SortBy}&SortDesc={Model.SortDesc}";
}

<style>
    .sort-header {
        cursor: pointer;
        user-select: none;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        gap: 2px;
        transition: color 0.15s;
    }
    .sort-header:hover { color: var(--md-sys-color-primary) !important; }
    .sort-header .material-symbols-outlined { font-size: 16px; }
</style>

<!-- Search & Filters -->
<div class="md3-card p-6 mb-6">
    <form method="get" class="flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
            <div class="md3-input-wrapper" style="width: 100%;">
                <label for="Search">Search</label>
                <input class="md3-input" id="Search" name="Search" value="@Model.Search" placeholder="Username or email..." />
            </div>
        </div>
        <div class="min-w-[150px]">
            <div class="md3-input-wrapper" style="width: 100%;">
                <label for="Tier">Tier</label>
                <select class="md3-select" id="Tier" name="Tier">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Tier))">All Tiers</option>
                    <option value="Free" selected="@(Model.Tier == "Free")">Free</option>
                    <option value="Premium" selected="@(Model.Tier == "Premium")">Premium</option>
                    <option value="PremiumPlus" selected="@(Model.Tier == "PremiumPlus")">Premium+</option>
                </select>
            </div>
        </div>
        <div class="flex items-center" style="padding-bottom: 4px;">
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="md3-checkbox" name="HideBots" value="true"
                       @(Model.HideBots ? "checked" : "") />
                <span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Hide Bots</span>
            </label>
        </div>
        <button class="md3-btn-filled" type="submit">
            <span class="material-symbols-outlined">search</span>
            Search
        </button>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Tier) || Model.HideBots)
        {
            <a href="/Admin/Players" class="md3-btn-outlined" style="text-decoration: none;">
                Clear
            </a>
        }
    </form>
</div>

<!-- Results Summary -->
<div class="flex justify-between items-center mb-4">
    <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
        @if (Model.Data.TotalCount > 0)
        {
            <text>Showing @((Model.Data.Page - 1) * Model.Data.PageSize + 1)-@Math.Min(Model.Data.Page * Model.Data.PageSize, Model.Data.TotalCount) of @Model.Data.TotalCount players</text>
        }
        else
        {
            <text>No players found</text>
        }
    </div>
</div>

<!-- Player Table -->
<div class="md3-card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="md3-table min-w-full">
            <thead>
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                        <a href="@SortUrl("username")" class="sort-header" style="@SortColor("username")">
                            Player
                            <span class="material-symbols-outlined">@SortIcon("username")</span>
                        </a>
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                        <a href="@SortUrl("rating")" class="sort-header" style="@SortColor("rating")">
                            Rating
                            <span class="material-symbols-outlined">@SortIcon("rating")</span>
                        </a>
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Battles</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Win Rate</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                        <a href="@SortUrl("tier")" class="sort-header" style="@SortColor("tier")">
                            Tier
                            <span class="material-symbols-outlined">@SortIcon("tier")</span>
                        </a>
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                        <a href="@SortUrl("joined")" class="sort-header" style="@SortColor("joined")">
                            Joined
                            <span class="material-symbols-outlined">@SortIcon("joined")</span>
                        </a>
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">
                        <a href="@SortUrl("lastactive")" class="sort-header" style="@SortColor("lastactive")">
                            Last Active
                            <span class="material-symbols-outlined">@SortIcon("lastactive")</span>
                        </a>
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in Model.Data.Players)
                {
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <div>
                                    <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">
                                        @player.Username
                                        @if (player.IsAdmin)
                                        {
                                            <span class="md3-badge-error ml-1">Admin</span>
                                        }
                                        @if (player.IsBot)
                                        {
                                            <span class="text-xs font-medium px-2 py-0.5 rounded ml-1" style="background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container);">Bot</span>
                                        }
                                    </div>
                                    <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">@player.Email</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">@player.Rating</div>
                            <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Level @player.Level</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">@player.TotalBattles</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            <span style="color: @(player.WinRate >= 55 ? "var(--md-sys-color-primary)" : player.WinRate <= 45 ? "var(--md-sys-color-error)" : "var(--md-sys-color-on-surface)");">
                                @player.WinRate%
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @{
                                var tierBadge = player.CurrentTier switch
                                {
                                    "Premium" => "md3-badge-primary",
                                    "PremiumPlus" => "md3-badge-tertiary",
                                    _ => "md3-badge-secondary"
                                };
                            }
                            <span class="@tierBadge">@player.CurrentTier</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                            @player.CreatedAt.ToString("MMM d, yyyy")
                            @if ((DateTime.UtcNow - player.CreatedAt).TotalHours < 24)
                            {
                                <span class="text-xs font-medium px-1.5 py-0.5 rounded ml-1" style="background: var(--md-sys-color-tertiary-container); color: var(--md-sys-color-on-tertiary-container);">New</span>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                            @{
                                var timeSince = DateTime.UtcNow - player.LastLoginAt;
                                var lastActive = timeSince.TotalMinutes < 60 ? $"{(int)timeSince.TotalMinutes}m ago"
                                    : timeSince.TotalHours < 24 ? $"{(int)timeSince.TotalHours}h ago"
                                    : $"{(int)timeSince.TotalDays}d ago";
                            }
                            @lastActive
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <a href="/Admin/PlayerDetail?id=@player.Id" class="md3-btn-text" style="text-decoration: none;">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Data.TotalPages > 1)
    {
        <div class="px-6 py-3 flex items-center justify-between" style="border-top: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container);">
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                Page @Model.Data.Page of @Model.Data.TotalPages
            </div>
            <div class="flex space-x-2">
                @if (Model.Data.Page > 1)
                {
                    <a href="/Admin/Players?Page=@(Model.Data.Page - 1)&@paginationQuery" class="md3-btn-outlined" style="text-decoration: none;">
                        Previous
                    </a>
                }
                @for (var i = Math.Max(1, Model.Data.Page - 2); i <= Math.Min(Model.Data.TotalPages, Model.Data.Page + 2); i++)
                {
                    @if (i == Model.Data.Page)
                    {
                        <button class="md3-btn-filled" disabled style="background: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary); opacity: 1;">
                            @i
                        </button>
                    }
                    else
                    {
                        <a href="/Admin/Players?Page=@i&@paginationQuery" class="md3-btn-outlined" style="text-decoration: none;">
                            @i
                        </a>
                    }
                }
                @if (Model.Data.Page < Model.Data.TotalPages)
                {
                    <a href="/Admin/Players?Page=@(Model.Data.Page + 1)&@paginationQuery" class="md3-btn-outlined" style="text-decoration: none;">
                        Next
                    </a>
                }
            </div>
        </div>
    }
</div>
