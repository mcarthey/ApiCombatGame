@page
@model ApiCombatGame.Pages.Admin.PlayersModel
@{
    ViewData["Title"] = "Player Analytics";
    Layout = "_AdminLayout";
}

<!-- Search & Filters -->
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700 mb-6">
    <form method="get" class="flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Search</label>
            <input type="text" name="Search" value="@Model.Search" placeholder="Username or email..."
                   class="w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2" />
        </div>
        <div class="min-w-[150px]">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tier</label>
            <select name="Tier" class="w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white shadow-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2">
                <option value="">All Tiers</option>
                <option value="Free" selected="@(Model.Tier == "Free")">Free</option>
                <option value="Premium" selected="@(Model.Tier == "Premium")">Premium</option>
                <option value="PremiumPlus" selected="@(Model.Tier == "PremiumPlus")">Premium+</option>
            </select>
        </div>
        <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
            Search
        </button>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Tier))
        {
            <a href="/Admin/Players" class="px-6 py-2 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500 transition font-medium">
                Clear
            </a>
        }
    </form>
</div>

<!-- Results Summary -->
<div class="flex justify-between items-center mb-4">
    <div class="text-sm text-gray-600 dark:text-gray-400">
        Showing @((Model.Data.Page - 1) * Model.Data.PageSize + 1)-@Math.Min(Model.Data.Page * Model.Data.PageSize, Model.Data.TotalCount) of @Model.Data.TotalCount players
    </div>
</div>

<!-- Player Table -->
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-900">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Player</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Rating</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Battles</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Win Rate</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Tier</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Last Active</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var player in Model.Data.Players)
                {
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-750">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <div>
                                    <div class="text-sm font-medium">
                                        @player.Username
                                        @if (player.IsAdmin)
                                        {
                                            <span class="ml-1 px-2 py-0.5 bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300 text-xs rounded-full">Admin</span>
                                        }
                                    </div>
                                    <div class="text-sm text-gray-500 dark:text-gray-400">@player.Email</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium">@player.Rating</div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Level @player.Level</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">@player.TotalBattles</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            <span class="@(player.WinRate >= 55 ? "text-green-600 dark:text-green-400" : player.WinRate <= 45 ? "text-red-600 dark:text-red-400" : "")">
                                @player.WinRate%
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @{
                                var tierColor = player.CurrentTier switch
                                {
                                    "Premium" => "bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300",
                                    "PremiumPlus" => "bg-purple-100 dark:bg-purple-900/30 text-purple-800 dark:text-purple-300",
                                    _ => "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300"
                                };
                            }
                            <span class="px-2 py-1 text-xs font-medium rounded-full @tierColor">@player.CurrentTier</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                            @{
                                var timeSince = DateTime.UtcNow - player.LastLoginAt;
                                var lastActive = timeSince.TotalMinutes < 60 ? $"{(int)timeSince.TotalMinutes}m ago"
                                    : timeSince.TotalHours < 24 ? $"{(int)timeSince.TotalHours}h ago"
                                    : $"{(int)timeSince.TotalDays}d ago";
                            }
                            @lastActive
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <a href="/Admin/PlayerDetail?id=@player.Id" class="text-blue-600 dark:text-blue-400 hover:underline text-sm font-medium">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Data.TotalPages > 1)
    {
        <div class="bg-gray-50 dark:bg-gray-900 px-6 py-3 flex items-center justify-between border-t dark:border-gray-700">
            <div class="flex space-x-2">
                @if (Model.Data.Page > 1)
                {
                    <a href="/Admin/Players?Page=@(Model.Data.Page - 1)&Search=@Model.Search&Tier=@Model.Tier"
                       class="px-3 py-1 bg-white dark:bg-gray-800 border dark:border-gray-600 rounded text-sm hover:bg-gray-50 dark:hover:bg-gray-700">
                        Previous
                    </a>
                }
                @for (var i = Math.Max(1, Model.Data.Page - 2); i <= Math.Min(Model.Data.TotalPages, Model.Data.Page + 2); i++)
                {
                    <a href="/Admin/Players?Page=@i&Search=@Model.Search&Tier=@Model.Tier"
                       class="px-3 py-1 rounded text-sm @(i == Model.Data.Page ? "bg-blue-600 text-white" : "bg-white dark:bg-gray-800 border dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700")">
                        @i
                    </a>
                }
                @if (Model.Data.Page < Model.Data.TotalPages)
                {
                    <a href="/Admin/Players?Page=@(Model.Data.Page + 1)&Search=@Model.Search&Tier=@Model.Tier"
                       class="px-3 py-1 bg-white dark:bg-gray-800 border dark:border-gray-600 rounded text-sm hover:bg-gray-50 dark:hover:bg-gray-700">
                        Next
                    </a>
                }
            </div>
        </div>
    }
</div>
