@page
@model ApiCombatGame.Pages.Admin.PlayersModel
@{
    ViewData["Title"] = "Player Analytics";
    Layout = "_AdminLayout";
}

<!-- Search & Filters -->
<div class="md3-card p-6 mb-6">
    <form method="get" class="flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
            <md-outlined-text-field label="Search" name="Search" value="@Model.Search" placeholder="Username or email..."
                                    style="width: 100%;">
                <md-icon slot="leading-icon">search</md-icon>
            </md-outlined-text-field>
        </div>
        <div class="min-w-[150px]">
            <md-outlined-select label="Tier" name="Tier" style="width: 100%;">
                <md-select-option value="" selected="@(string.IsNullOrEmpty(Model.Tier))">
                    <div slot="headline">All Tiers</div>
                </md-select-option>
                <md-select-option value="Free" selected="@(Model.Tier == "Free")">
                    <div slot="headline">Free</div>
                </md-select-option>
                <md-select-option value="Premium" selected="@(Model.Tier == "Premium")">
                    <div slot="headline">Premium</div>
                </md-select-option>
                <md-select-option value="PremiumPlus" selected="@(Model.Tier == "PremiumPlus")">
                    <div slot="headline">Premium+</div>
                </md-select-option>
            </md-outlined-select>
        </div>
        <md-filled-button type="submit">
            <md-icon slot="icon">search</md-icon>
            Search
        </md-filled-button>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Tier))
        {
            <a href="/Admin/Players">
                <md-outlined-button type="button">
                    Clear
                </md-outlined-button>
            </a>
        }
    </form>
</div>

<!-- Results Summary -->
<div class="flex justify-between items-center mb-4">
    <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
        Showing @((Model.Data.Page - 1) * Model.Data.PageSize + 1)-@Math.Min(Model.Data.Page * Model.Data.PageSize, Model.Data.TotalCount) of @Model.Data.TotalCount players
    </div>
</div>

<!-- Player Table -->
<div class="md3-card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="md3-table min-w-full">
            <thead>
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Player</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Rating</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Battles</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Win Rate</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Tier</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Last Active</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in Model.Data.Players)
                {
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <div>
                                    <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">
                                        @player.Username
                                        @if (player.IsAdmin)
                                        {
                                            <span class="md3-badge-error ml-1">Admin</span>
                                        }
                                    </div>
                                    <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">@player.Email</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">@player.Rating</div>
                            <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Level @player.Level</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">@player.TotalBattles</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            <span style="color: @(player.WinRate >= 55 ? "var(--md-sys-color-primary)" : player.WinRate <= 45 ? "var(--md-sys-color-error)" : "var(--md-sys-color-on-surface)");">
                                @player.WinRate%
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @{
                                var tierBadge = player.CurrentTier switch
                                {
                                    "Premium" => "md3-badge-primary",
                                    "PremiumPlus" => "md3-badge-tertiary",
                                    _ => "md3-badge-secondary"
                                };
                            }
                            <span class="@tierBadge">@player.CurrentTier</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                            @{
                                var timeSince = DateTime.UtcNow - player.LastLoginAt;
                                var lastActive = timeSince.TotalMinutes < 60 ? $"{(int)timeSince.TotalMinutes}m ago"
                                    : timeSince.TotalHours < 24 ? $"{(int)timeSince.TotalHours}h ago"
                                    : $"{(int)timeSince.TotalDays}d ago";
                            }
                            @lastActive
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <a href="/Admin/PlayerDetail?id=@player.Id">
                                <md-text-button>View Details</md-text-button>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Data.TotalPages > 1)
    {
        <div class="px-6 py-3 flex items-center justify-between" style="border-top: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container);">
            <div class="flex space-x-2">
                @if (Model.Data.Page > 1)
                {
                    <a href="/Admin/Players?Page=@(Model.Data.Page - 1)&Search=@Model.Search&Tier=@Model.Tier">
                        <md-outlined-button>Previous</md-outlined-button>
                    </a>
                }
                @for (var i = Math.Max(1, Model.Data.Page - 2); i <= Math.Min(Model.Data.TotalPages, Model.Data.Page + 2); i++)
                {
                    @if (i == Model.Data.Page)
                    {
                        <md-filled-button disabled style="--md-filled-button-disabled-container-color: var(--md-sys-color-primary); --md-filled-button-disabled-label-text-color: var(--md-sys-color-on-primary); --md-filled-button-disabled-container-opacity: 1; --md-filled-button-disabled-label-text-opacity: 1;">
                            @i
                        </md-filled-button>
                    }
                    else
                    {
                        <a href="/Admin/Players?Page=@i&Search=@Model.Search&Tier=@Model.Tier">
                            <md-outlined-button>@i</md-outlined-button>
                        </a>
                    }
                }
                @if (Model.Data.Page < Model.Data.TotalPages)
                {
                    <a href="/Admin/Players?Page=@(Model.Data.Page + 1)&Search=@Model.Search&Tier=@Model.Tier">
                        <md-outlined-button>Next</md-outlined-button>
                    </a>
                }
            </div>
        </div>
    }
</div>
