@page
@model ApiCombatGame.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Overview";
    Layout = "_AdminLayout";
}

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
    <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">DAU</div>
        <div class="text-3xl font-bold mt-1">@Model.Data.Dau.ToString("N0")</div>
        <div class="text-sm mt-1 @(Model.Data.DauChange >= 0 ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
            @(Model.Data.DauChange >= 0 ? "+" : "")@Model.Data.DauChange% vs yesterday
        </div>
    </div>
    <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">WAU</div>
        <div class="text-3xl font-bold mt-1">@Model.Data.Wau.ToString("N0")</div>
        <div class="text-sm mt-1 @(Model.Data.WauChange >= 0 ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
            @(Model.Data.WauChange >= 0 ? "+" : "")@Model.Data.WauChange% vs last week
        </div>
    </div>
    <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">MAU</div>
        <div class="text-3xl font-bold mt-1">@Model.Data.Mau.ToString("N0")</div>
        <div class="text-sm mt-1 @(Model.Data.MauChange >= 0 ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
            @(Model.Data.MauChange >= 0 ? "+" : "")@Model.Data.MauChange% vs last month
        </div>
    </div>
    <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">MRR</div>
        <div class="text-3xl font-bold mt-1">$@Model.Data.Mrr.ToString("N0")</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">ARR: $@Model.Data.Arr.ToString("N0")</div>
    </div>
    <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Conversion</div>
        <div class="text-3xl font-bold mt-1">@Model.Data.ConversionRate%</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">Free to Paid</div>
    </div>
</div>

<!-- Second Row: Activity & Engagement -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <h3 class="text-lg font-semibold mb-4">Today's Activity</h3>
        <div class="space-y-4">
            <div class="flex justify-between items-center">
                <span class="text-gray-600 dark:text-gray-400">New Signups</span>
                <span class="font-bold text-lg">@Model.Data.SignupsToday</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-gray-600 dark:text-gray-400">Battles</span>
                <span class="font-bold text-lg">@Model.Data.BattlesToday</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-gray-600 dark:text-gray-400">Weekly Signups</span>
                <span class="font-bold text-lg">@Model.Data.SignupsThisWeek</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-gray-600 dark:text-gray-400">Weekly Battles</span>
                <span class="font-bold text-lg">@Model.Data.BattlesThisWeek</span>
            </div>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <h3 class="text-lg font-semibold mb-4">Player Segments</h3>
        <div class="space-y-3">
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600 dark:text-gray-400">Free</span>
                    <span class="font-medium">@Model.Data.FreeTierCount</span>
                </div>
                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                    @{
                        var freePercent = Model.Data.TotalPlayers > 0 ? (double)Model.Data.FreeTierCount / Model.Data.TotalPlayers * 100 : 0;
                        var premiumPercent = Model.Data.TotalPlayers > 0 ? (double)Model.Data.PremiumCount / Model.Data.TotalPlayers * 100 : 0;
                        var ppPercent = Model.Data.TotalPlayers > 0 ? (double)Model.Data.PremiumPlusCount / Model.Data.TotalPlayers * 100 : 0;
                    }
                    <div class="bg-gray-400 h-2 rounded-full" style="width: @freePercent%"></div>
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-blue-600 dark:text-blue-400">Premium</span>
                    <span class="font-medium">@Model.Data.PremiumCount</span>
                </div>
                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                    <div class="bg-blue-500 h-2 rounded-full" style="width: @premiumPercent%"></div>
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-purple-600 dark:text-purple-400">Premium+</span>
                    <span class="font-medium">@Model.Data.PremiumPlusCount</span>
                </div>
                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                    <div class="bg-purple-500 h-2 rounded-full" style="width: @ppPercent%"></div>
                </div>
            </div>
        </div>
        <div class="mt-4 pt-4 border-t dark:border-gray-700">
            <div class="flex justify-between text-sm">
                <span class="text-gray-600 dark:text-gray-400">Total Players</span>
                <span class="font-bold">@Model.Data.TotalPlayers.ToString("N0")</span>
            </div>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <h3 class="text-lg font-semibold mb-4">Engagement Health</h3>
        <div class="space-y-4">
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600 dark:text-gray-400">DAU/MAU Ratio</span>
                    <span class="font-medium @(Model.Data.DauMauRatio >= 0.2 ? "text-green-600 dark:text-green-400" : "text-yellow-600 dark:text-yellow-400")">
                        @Model.Data.DauMauRatio
                    </span>
                </div>
                <div class="text-xs text-gray-500 dark:text-gray-400">
                    @(Model.Data.DauMauRatio >= 0.3 ? "Excellent stickiness" : Model.Data.DauMauRatio >= 0.2 ? "Good stickiness" : "Needs improvement")
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600 dark:text-gray-400">Guilds</span>
                    <span class="font-medium">@Model.Data.TotalGuilds</span>
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600 dark:text-gray-400">Paying Users</span>
                    <span class="font-medium">@((Model.Data.PremiumCount + Model.Data.PremiumPlusCount).ToString("N0"))</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <a href="/Admin/Players" class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border dark:border-gray-700 hover:shadow-md transition flex items-center">
        <div class="bg-blue-100 dark:bg-blue-900/30 p-3 rounded-lg mr-4">
            <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
        <div>
            <div class="font-medium">Player Management</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">Search and manage players</div>
        </div>
    </a>
    <a href="/Admin/Meta" class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border dark:border-gray-700 hover:shadow-md transition flex items-center">
        <div class="bg-green-100 dark:bg-green-900/30 p-3 rounded-lg mr-4">
            <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
        <div>
            <div class="font-medium">Meta & Balance</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">Unit stats and balance</div>
        </div>
    </a>
    <a href="/Admin/Guilds" class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border dark:border-gray-700 hover:shadow-md transition flex items-center">
        <div class="bg-yellow-100 dark:bg-yellow-900/30 p-3 rounded-lg mr-4">
            <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div>
            <div class="font-medium">Guild Analytics</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">Social features overview</div>
        </div>
    </a>
    <a href="/Admin/Technical" class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border dark:border-gray-700 hover:shadow-md transition flex items-center">
        <div class="bg-red-100 dark:bg-red-900/30 p-3 rounded-lg mr-4">
            <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div>
            <div class="font-medium">Technical Health</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">System status and queues</div>
        </div>
    </a>
</div>
