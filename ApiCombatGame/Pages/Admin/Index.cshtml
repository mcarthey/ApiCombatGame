@page
@model ApiCombatGame.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Overview";
    Layout = "_AdminLayout";
}

<!-- KPI Tooltip Styles -->
<style>
    .kpi-label {
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .kpi-info {
        position: relative;
        display: inline-flex;
        cursor: help;
    }
    .kpi-info .material-symbols-outlined {
        font-size: 16px;
        color: var(--md-sys-color-on-surface-variant);
        opacity: 0.6;
        transition: opacity 0.2s;
    }
    .kpi-info:hover .material-symbols-outlined {
        opacity: 1;
        color: var(--md-sys-color-primary);
    }
    .kpi-tooltip {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%);
        background: var(--md-sys-color-inverse-surface);
        color: var(--md-sys-color-inverse-on-surface);
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 400;
        white-space: nowrap;
        z-index: 10;
        pointer-events: none;
        box-shadow: var(--md-sys-elevation-2);
    }
    .kpi-info:hover .kpi-tooltip {
        display: block;
    }
</style>

@if (Model.ActiveAlerts.Any())
{
    <div class="mb-6 space-y-2">
        <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined" style="color: var(--md-sys-color-error);">notifications_active</span>
            <h2 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Active Alerts (@Model.ActiveAlerts.Count)</h2>
        </div>
        @foreach (var alert in Model.ActiveAlerts)
        {
            var borderColor = alert.Severity switch {
                ApiCombatGame.Models.Enums.AlertSeverity.Critical => "var(--md-sys-color-error)",
                ApiCombatGame.Models.Enums.AlertSeverity.Warning => "var(--md-sys-color-tertiary)",
                _ => "var(--md-sys-color-primary)"
            };
            var severityBadge = alert.Severity switch {
                ApiCombatGame.Models.Enums.AlertSeverity.Critical => "md3-badge-error",
                ApiCombatGame.Models.Enums.AlertSeverity.Warning => "md3-badge-tertiary",
                _ => "md3-badge-primary"
            };
            <div class="md3-card p-4 flex items-center justify-between" style="border-left: 3px solid @borderColor;">
                <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="@severityBadge text-xs">@alert.Severity</span>
                        <span class="text-xs" style="color: var(--md-sys-color-outline);">@alert.Category</span>
                        <span class="text-xs" style="color: var(--md-sys-color-outline);">@alert.CreatedAt.ToString("MMM dd, HH:mm") UTC</span>
                    </div>
                    <p class="text-sm" style="color: var(--md-sys-color-on-surface);">@alert.Message</p>
                    @if (!string.IsNullOrEmpty(alert.ActionRequired))
                    {
                        <p class="text-xs mt-1" style="color: var(--md-sys-color-on-surface-variant);">Action: @alert.ActionRequired</p>
                    }
                </div>
                <form method="post" asp-page-handler="AcknowledgeAlert" class="ml-3">
                    <input type="hidden" name="alertId" value="@alert.Id" />
                    <button type="submit" class="md3-btn-text text-xs">Acknowledge</button>
                </form>
            </div>
        }
    </div>
}

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium kpi-label" style="color: var(--md-sys-color-on-surface-variant);">
            DAU
            <span class="kpi-info">
                <span class="material-symbols-outlined">info</span>
                <span class="kpi-tooltip">Daily Active Users — unique players active today</span>
            </span>
        </div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.Dau.ToString("N0")</div>
        <div class="text-sm mt-1" style="color: @(Model.Data.DauChange >= 0 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-error)");">
            @(Model.Data.DauChange >= 0 ? "+" : "")@Model.Data.DauChange% vs yesterday
        </div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium kpi-label" style="color: var(--md-sys-color-on-surface-variant);">
            WAU
            <span class="kpi-info">
                <span class="material-symbols-outlined">info</span>
                <span class="kpi-tooltip">Weekly Active Users — unique players active in the last 7 days</span>
            </span>
        </div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.Wau.ToString("N0")</div>
        <div class="text-sm mt-1" style="color: @(Model.Data.WauChange >= 0 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-error)");">
            @(Model.Data.WauChange >= 0 ? "+" : "")@Model.Data.WauChange% vs last week
        </div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium kpi-label" style="color: var(--md-sys-color-on-surface-variant);">
            MAU
            <span class="kpi-info">
                <span class="material-symbols-outlined">info</span>
                <span class="kpi-tooltip">Monthly Active Users — unique players active in the last 30 days</span>
            </span>
        </div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.Mau.ToString("N0")</div>
        <div class="text-sm mt-1" style="color: @(Model.Data.MauChange >= 0 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-error)");">
            @(Model.Data.MauChange >= 0 ? "+" : "")@Model.Data.MauChange% vs last month
        </div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium kpi-label" style="color: var(--md-sys-color-on-surface-variant);">
            MRR
            <span class="kpi-info">
                <span class="material-symbols-outlined">info</span>
                <span class="kpi-tooltip">Monthly Recurring Revenue — total subscription income per month</span>
            </span>
        </div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">$@Model.Data.Mrr.ToString("N0")</div>
        <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">ARR: $@Model.Data.Arr.ToString("N0")</div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium kpi-label" style="color: var(--md-sys-color-on-surface-variant);">
            Conversion
            <span class="kpi-info">
                <span class="material-symbols-outlined">info</span>
                <span class="kpi-tooltip">Conversion Rate — percentage of free players who upgraded to paid</span>
            </span>
        </div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.ConversionRate%</div>
        <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Free to Paid</div>
    </div>
</div>

<!-- Second Row: Activity & Engagement -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="md3-card p-6">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Today's Activity</h3>
        <div class="space-y-4">
            <div class="flex justify-between items-center">
                <span style="color: var(--md-sys-color-on-surface-variant);">New Signups</span>
                <span class="font-bold text-lg" style="color: var(--md-sys-color-on-surface);">@Model.Data.SignupsToday</span>
            </div>
            <div class="flex justify-between items-center">
                <span style="color: var(--md-sys-color-on-surface-variant);">Battles</span>
                <span class="font-bold text-lg" style="color: var(--md-sys-color-on-surface);">@Model.Data.BattlesToday</span>
            </div>
            <div class="flex justify-between items-center">
                <span style="color: var(--md-sys-color-on-surface-variant);">Weekly Signups</span>
                <span class="font-bold text-lg" style="color: var(--md-sys-color-on-surface);">@Model.Data.SignupsThisWeek</span>
            </div>
            <div class="flex justify-between items-center">
                <span style="color: var(--md-sys-color-on-surface-variant);">Weekly Battles</span>
                <span class="font-bold text-lg" style="color: var(--md-sys-color-on-surface);">@Model.Data.BattlesThisWeek</span>
            </div>
        </div>
    </div>

    <div class="md3-card p-6">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Player Segments</h3>
        <div class="space-y-3">
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-on-surface-variant);">Free</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@Model.Data.FreeTierCount</span>
                </div>
                @{
                    var freePercent = Model.Data.TotalPlayers > 0 ? (double)Model.Data.FreeTierCount / Model.Data.TotalPlayers : 0;
                    var premiumPercent = Model.Data.TotalPlayers > 0 ? (double)Model.Data.PremiumCount / Model.Data.TotalPlayers : 0;
                    var ppPercent = Model.Data.TotalPlayers > 0 ? (double)Model.Data.PremiumPlusCount / Model.Data.TotalPlayers : 0;
                }
                <div class="md3-progress"><div class="md3-progress-bar" style="width: @(freePercent * 100)%; background: var(--md-sys-color-outline);"></div></div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-primary);">Premium</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@Model.Data.PremiumCount</span>
                </div>
                <div class="md3-progress"><div class="md3-progress-bar" style="width: @(premiumPercent * 100)%; background: var(--md-sys-color-primary);"></div></div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-tertiary-container);">Premium+</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@Model.Data.PremiumPlusCount</span>
                </div>
                <div class="md3-progress"><div class="md3-progress-bar" style="width: @(ppPercent * 100)%; background: var(--md-sys-color-tertiary-container);"></div></div>
            </div>
        </div>
        <div class="mt-4 pt-4" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
            <div class="flex justify-between text-sm">
                <span style="color: var(--md-sys-color-on-surface-variant);">Total Players</span>
                <span class="font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalPlayers.ToString("N0")</span>
            </div>
        </div>
    </div>

    <div class="md3-card p-6">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Engagement Health</h3>
        <div class="space-y-4">
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="kpi-label" style="color: var(--md-sys-color-on-surface-variant);">
                        DAU/MAU Ratio
                        <span class="kpi-info">
                            <span class="material-symbols-outlined">info</span>
                            <span class="kpi-tooltip">Stickiness — how often monthly users return daily. 0.2+ is good, 0.3+ is excellent.</span>
                        </span>
                    </span>
                    <span class="font-medium" style="color: @(Model.Data.DauMauRatio >= 0.2 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-error)");">
                        @Model.Data.DauMauRatio
                    </span>
                </div>
                <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">
                    @(Model.Data.DauMauRatio >= 0.3 ? "Excellent stickiness" : Model.Data.DauMauRatio >= 0.2 ? "Good stickiness" : "Needs improvement")
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-on-surface-variant);">Guilds</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalGuilds</span>
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-on-surface-variant);">Paying Users</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@((Model.Data.PremiumCount + Model.Data.PremiumPlusCount).ToString("N0"))</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <a href="/Admin/Players" class="acct-nav-card">
        <div>
            <div class="text-lg font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 8px; color: var(--md-sys-color-primary);">group</span>
                Player Management
            </div>
            <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Search and manage players</p>
        </div>
        <span class="material-symbols-outlined acct-nav-arrow">arrow_forward</span>
    </a>
    <a href="/Admin/Meta" class="acct-nav-card">
        <div>
            <div class="text-lg font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 8px; color: var(--md-sys-color-primary);">bar_chart</span>
                Meta & Balance
            </div>
            <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Unit stats and balance</p>
        </div>
        <span class="material-symbols-outlined acct-nav-arrow">arrow_forward</span>
    </a>
    <a href="/Admin/Guilds" class="acct-nav-card">
        <div>
            <div class="text-lg font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 8px; color: var(--md-sys-color-primary);">shield</span>
                Guild Analytics
            </div>
            <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Social features overview</p>
        </div>
        <span class="material-symbols-outlined acct-nav-arrow">arrow_forward</span>
    </a>
    <a href="/Admin/Technical" class="acct-nav-card">
        <div>
            <div class="text-lg font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 8px; color: var(--md-sys-color-primary);">settings</span>
                Technical Health
            </div>
            <p class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">System status and queues</p>
        </div>
        <span class="material-symbols-outlined acct-nav-arrow">arrow_forward</span>
    </a>
</div>
