@page
@model ApiCombatGame.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Overview";
    Layout = "_AdminLayout";
}

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">DAU</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.Dau.ToString("N0")</div>
        <div class="text-sm mt-1" style="color: @(Model.Data.DauChange >= 0 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-error)");">
            @(Model.Data.DauChange >= 0 ? "+" : "")@Model.Data.DauChange% vs yesterday
        </div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">WAU</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.Wau.ToString("N0")</div>
        <div class="text-sm mt-1" style="color: @(Model.Data.WauChange >= 0 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-error)");">
            @(Model.Data.WauChange >= 0 ? "+" : "")@Model.Data.WauChange% vs last week
        </div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">MAU</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.Mau.ToString("N0")</div>
        <div class="text-sm mt-1" style="color: @(Model.Data.MauChange >= 0 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-error)");">
            @(Model.Data.MauChange >= 0 ? "+" : "")@Model.Data.MauChange% vs last month
        </div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">MRR</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">$@Model.Data.Mrr.ToString("N0")</div>
        <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">ARR: $@Model.Data.Arr.ToString("N0")</div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Conversion</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.ConversionRate%</div>
        <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Free to Paid</div>
    </div>
</div>

<!-- Second Row: Activity & Engagement -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="md3-card p-6">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Today's Activity</h3>
        <div class="space-y-4">
            <div class="flex justify-between items-center">
                <span style="color: var(--md-sys-color-on-surface-variant);">New Signups</span>
                <span class="font-bold text-lg" style="color: var(--md-sys-color-on-surface);">@Model.Data.SignupsToday</span>
            </div>
            <div class="flex justify-between items-center">
                <span style="color: var(--md-sys-color-on-surface-variant);">Battles</span>
                <span class="font-bold text-lg" style="color: var(--md-sys-color-on-surface);">@Model.Data.BattlesToday</span>
            </div>
            <div class="flex justify-between items-center">
                <span style="color: var(--md-sys-color-on-surface-variant);">Weekly Signups</span>
                <span class="font-bold text-lg" style="color: var(--md-sys-color-on-surface);">@Model.Data.SignupsThisWeek</span>
            </div>
            <div class="flex justify-between items-center">
                <span style="color: var(--md-sys-color-on-surface-variant);">Weekly Battles</span>
                <span class="font-bold text-lg" style="color: var(--md-sys-color-on-surface);">@Model.Data.BattlesThisWeek</span>
            </div>
        </div>
    </div>

    <div class="md3-card p-6">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Player Segments</h3>
        <div class="space-y-3">
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-on-surface-variant);">Free</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@Model.Data.FreeTierCount</span>
                </div>
                @{
                    var freePercent = Model.Data.TotalPlayers > 0 ? (double)Model.Data.FreeTierCount / Model.Data.TotalPlayers : 0;
                    var premiumPercent = Model.Data.TotalPlayers > 0 ? (double)Model.Data.PremiumCount / Model.Data.TotalPlayers : 0;
                    var ppPercent = Model.Data.TotalPlayers > 0 ? (double)Model.Data.PremiumPlusCount / Model.Data.TotalPlayers : 0;
                }
                <div class="md3-progress"><div class="md3-progress-bar" style="width: @(freePercent * 100)%; background: var(--md-sys-color-outline);"></div></div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-primary);">Premium</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@Model.Data.PremiumCount</span>
                </div>
                <div class="md3-progress"><div class="md3-progress-bar" style="width: @(premiumPercent * 100)%; background: var(--md-sys-color-primary);"></div></div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-tertiary-container);">Premium+</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@Model.Data.PremiumPlusCount</span>
                </div>
                <div class="md3-progress"><div class="md3-progress-bar" style="width: @(ppPercent * 100)%; background: var(--md-sys-color-tertiary-container);"></div></div>
            </div>
        </div>
        <div class="mt-4 pt-4" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
            <div class="flex justify-between text-sm">
                <span style="color: var(--md-sys-color-on-surface-variant);">Total Players</span>
                <span class="font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalPlayers.ToString("N0")</span>
            </div>
        </div>
    </div>

    <div class="md3-card p-6">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Engagement Health</h3>
        <div class="space-y-4">
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-on-surface-variant);">DAU/MAU Ratio</span>
                    <span class="font-medium" style="color: @(Model.Data.DauMauRatio >= 0.2 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-error)");">
                        @Model.Data.DauMauRatio
                    </span>
                </div>
                <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">
                    @(Model.Data.DauMauRatio >= 0.3 ? "Excellent stickiness" : Model.Data.DauMauRatio >= 0.2 ? "Good stickiness" : "Needs improvement")
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-on-surface-variant);">Guilds</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalGuilds</span>
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span style="color: var(--md-sys-color-on-surface-variant);">Paying Users</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">@((Model.Data.PremiumCount + Model.Data.PremiumPlusCount).ToString("N0"))</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <a href="/Admin/Players" class="md3-card stat-card p-4 flex items-center">
        <div class="p-3 mr-4" style="background: var(--md-sys-color-primary-container); border-radius: var(--md-sys-shape-corner-medium);">
            <span class="material-symbols-outlined" style="color: var(--md-sys-color-on-primary-container);">group</span>
        </div>
        <div>
            <div class="font-medium" style="color: var(--md-sys-color-on-surface);">Player Management</div>
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Search and manage players</div>
        </div>
    </a>
    <a href="/Admin/Meta" class="md3-card stat-card p-4 flex items-center">
        <div class="p-3 mr-4" style="background: var(--md-sys-color-secondary-container); border-radius: var(--md-sys-shape-corner-medium);">
            <span class="material-symbols-outlined" style="color: var(--md-sys-color-on-secondary-container);">bar_chart</span>
        </div>
        <div>
            <div class="font-medium" style="color: var(--md-sys-color-on-surface);">Meta & Balance</div>
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Unit stats and balance</div>
        </div>
    </a>
    <a href="/Admin/Guilds" class="md3-card stat-card p-4 flex items-center">
        <div class="p-3 mr-4" style="background: var(--md-sys-color-tertiary-container); border-radius: var(--md-sys-shape-corner-medium);">
            <span class="material-symbols-outlined" style="color: var(--md-sys-color-on-tertiary-container);">shield</span>
        </div>
        <div>
            <div class="font-medium" style="color: var(--md-sys-color-on-surface);">Guild Analytics</div>
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Social features overview</div>
        </div>
    </a>
    <a href="/Admin/Technical" class="md3-card stat-card p-4 flex items-center">
        <div class="p-3 mr-4" style="background: var(--md-sys-color-error-container); border-radius: var(--md-sys-shape-corner-medium);">
            <span class="material-symbols-outlined" style="color: var(--md-sys-color-on-error-container);">settings</span>
        </div>
        <div>
            <div class="font-medium" style="color: var(--md-sys-color-on-surface);">Technical Health</div>
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">System status and queues</div>
        </div>
    </a>
</div>
