@page
@model ApiCombatGame.Pages.Admin.PlayerDetailModel
@{
    ViewData["Title"] = $"Player: {Model.PlayerData?.Username ?? "Not Found"}";
    Layout = "_AdminLayout";
}

@if (Model.PlayerData == null)
{
    <div class="text-center py-12">
        <p style="color: var(--md-sys-color-on-surface-variant);">Player not found.</p>
        <a href="/Admin/Players" class="md3-btn-text mt-2 inline-block" style="text-decoration: none;">
            Back to Players
        </a>
    </div>
    return;
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="md3-alert-success mb-6">
        @Model.SuccessMessage
    </div>
}

<!-- Back Button -->
<div class="mb-6">
    <a href="/Admin/Players" class="md3-btn-text" style="text-decoration: none;">
        <span class="material-symbols-outlined">arrow_back</span>
        Back to Players
    </a>
</div>

@{ var p = Model.PlayerData; }

<!-- Player Header -->
<div class="md3-card p-6 mb-6">
    <div class="flex justify-between items-start">
        <div>
            <h2 class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">
                @p.Username
                @if (p.IsAdmin)
                {
                    <span class="md3-badge-error ml-2">@p.AdminRole</span>
                }
                @if (p.IsEducator)
                {
                    <span class="md3-badge-primary ml-2"><span class="material-symbols-outlined" style="font-size: 14px; vertical-align: text-bottom;">school</span> Educator</span>
                }
            </h2>
            <p class="mt-1" style="color: var(--md-sys-color-on-surface-variant);">@p.Email</p>
            <p class="text-sm mt-1" style="color: var(--md-sys-color-outline);">ID: @p.Id</p>
        </div>
        <div>
            @{
                var tierBadge = p.CurrentTier switch
                {
                    "Premium" => "md3-badge-primary",
                    "PremiumPlus" => "md3-badge-tertiary",
                    _ => "md3-badge-secondary"
                };
            }
            <span class="@tierBadge text-sm px-3 py-1">@p.CurrentTier</span>
        </div>
    </div>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-6">
    <div class="md3-card p-4 text-center stat-card">
        <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@p.Level</div>
        <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Level</div>
    </div>
    <div class="md3-card p-4 text-center stat-card">
        <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@p.Rating</div>
        <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Rating</div>
    </div>
    <div class="md3-card p-4 text-center stat-card">
        <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@p.Currency.ToString("N0")</div>
        <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Currency</div>
    </div>
    <div class="md3-card p-4 text-center stat-card">
        <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@p.TotalBattles</div>
        <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Battles</div>
    </div>
    <div class="md3-card p-4 text-center stat-card">
        <div class="text-2xl font-bold" style="color: @(p.WinRate >= 55 ? "var(--md-sys-color-primary)" : p.WinRate <= 45 ? "var(--md-sys-color-error)" : "var(--md-sys-color-on-surface)");">@p.WinRate%</div>
        <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Win Rate</div>
    </div>
    <div class="md3-card p-4 text-center stat-card">
        <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@p.WinStreak</div>
        <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">Win Streak</div>
    </div>
</div>

<!-- Details Grid -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- Player Info -->
    <div class="md3-card p-6">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Player Info</h3>
        <dl class="space-y-3">
            <div class="flex justify-between">
                <dt style="color: var(--md-sys-color-on-surface-variant);">XP</dt>
                <dd class="font-medium" style="color: var(--md-sys-color-on-surface);">@p.ExperiencePoints.ToString("N0")</dd>
            </div>
            <div class="flex justify-between">
                <dt style="color: var(--md-sys-color-on-surface-variant);">Units Owned</dt>
                <dd class="font-medium" style="color: var(--md-sys-color-on-surface);">@p.UnitsOwned</dd>
            </div>
            <div class="flex justify-between">
                <dt style="color: var(--md-sys-color-on-surface-variant);">Teams</dt>
                <dd class="font-medium" style="color: var(--md-sys-color-on-surface);">@p.TeamsConfigured</dd>
            </div>
            <div class="flex justify-between">
                <dt style="color: var(--md-sys-color-on-surface-variant);">Achievements</dt>
                <dd class="font-medium" style="color: var(--md-sys-color-on-surface);">@p.AchievementsUnlocked</dd>
            </div>
            <div class="flex justify-between">
                <dt style="color: var(--md-sys-color-on-surface-variant);">Guild</dt>
                <dd class="font-medium" style="color: var(--md-sys-color-on-surface);">@(p.GuildName ?? "None") @(p.GuildRole != null ? $"({p.GuildRole})" : "")</dd>
            </div>
            <div class="flex justify-between">
                <dt style="color: var(--md-sys-color-on-surface-variant);">Subscription</dt>
                <dd class="font-medium" style="color: var(--md-sys-color-on-surface);">@(p.SubscriptionStatus ?? "None")</dd>
            </div>
            <div class="flex justify-between">
                <dt style="color: var(--md-sys-color-on-surface-variant);">Joined</dt>
                <dd class="font-medium" style="color: var(--md-sys-color-on-surface);">@p.CreatedAt.ToString("MMM dd, yyyy")</dd>
            </div>
            <div class="flex justify-between">
                <dt style="color: var(--md-sys-color-on-surface-variant);">Last Login</dt>
                <dd class="font-medium" style="color: var(--md-sys-color-on-surface);">@p.LastLoginAt.ToString("MMM dd, yyyy HH:mm") UTC</dd>
            </div>
        </dl>
    </div>

    <!-- Admin Actions -->
    <div class="md3-card p-6">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Admin Actions</h3>
        <div class="space-y-4">
            <!-- Adjust Currency -->
            <form method="post" asp-page-handler="AdjustCurrency" class="flex gap-2 items-end">
                <input type="hidden" name="playerId" value="@p.Id" />
                <div class="md3-input-wrapper" style="flex: 1;">
                    <label for="amount">Amount (+/-)</label>
                    <input class="md3-input" id="amount" name="amount" type="number" />
                </div>
                <button class="md3-btn-filled" type="submit">
                    Adjust Gold
                </button>
            </form>

            <!-- Adjust Rating -->
            <form method="post" asp-page-handler="AdjustRating" class="flex gap-2 items-end">
                <input type="hidden" name="playerId" value="@p.Id" />
                <div class="md3-input-wrapper" style="flex: 1;">
                    <label for="ratingAmount">Rating (+/-)</label>
                    <input class="md3-input" id="ratingAmount" name="amount" type="number" />
                </div>
                <button class="md3-btn-filled" type="submit">
                    Adjust Rating
                </button>
            </form>

            <!-- Set Tier -->
            <form method="post" asp-page-handler="SetTier" class="flex gap-2 items-end">
                <input type="hidden" name="playerId" value="@p.Id" />
                <div class="md3-input-wrapper" style="flex: 1;">
                    <label for="tier">Tier</label>
                    <select class="md3-select" id="tier" name="tier">
                        <option value="Free" selected="@(p.CurrentTier == "Free")">Free</option>
                        <option value="Premium" selected="@(p.CurrentTier == "Premium")">Premium</option>
                        <option value="PremiumPlus" selected="@(p.CurrentTier == "PremiumPlus")">Premium+</option>
                    </select>
                </div>
                <button class="md3-btn-filled" type="submit">
                    Set Tier
                </button>
            </form>

            <!-- Toggle Admin -->
            <form method="post" asp-page-handler="ToggleAdmin" class="flex gap-2">
                <input type="hidden" name="playerId" value="@p.Id" />
                <input type="hidden" name="makeAdmin" value="@(!p.IsAdmin)" />
                @if (p.IsAdmin)
                {
                    <button class="md3-btn-filled w-full" type="submit" style="background: var(--md-sys-color-error-container); color: var(--md-sys-color-on-error-container);">
                        Remove Admin
                    </button>
                }
                else
                {
                    <button class="md3-btn-tonal w-full" type="submit">
                        Make Admin
                    </button>
                }
            </form>

            <!-- Toggle Educator -->
            <form method="post" asp-page-handler="ToggleEducator" class="flex gap-2">
                <input type="hidden" name="playerId" value="@p.Id" />
                <input type="hidden" name="makeEducator" value="@(!p.IsEducator)" />
                @if (p.IsEducator)
                {
                    <button class="md3-btn-filled w-full" type="submit" style="background: var(--md-sys-color-error-container); color: var(--md-sys-color-on-error-container);">
                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: text-bottom; margin-right: 4px;">school</span>
                        Remove Educator
                    </button>
                }
                else
                {
                    <button class="md3-btn-tonal w-full" type="submit">
                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: text-bottom; margin-right: 4px;">school</span>
                        Grant Educator
                    </button>
                }
            </form>

            <!-- Reset Password -->
            <form method="post" asp-page-handler="ResetPassword" class="flex gap-2 items-end">
                <input type="hidden" name="playerId" value="@p.Id" />
                <div class="md3-input-wrapper" style="flex: 1;">
                    <label for="newPassword">New password (min 8 chars)</label>
                    <input class="md3-input" id="newPassword" name="newPassword" type="password" />
                </div>
                <button class="md3-btn-tonal" type="submit">
                    Reset Password
                </button>
            </form>

            <!-- Rating Reconciliation -->
            <div class="mt-4 pt-4" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
                <div class="flex items-center gap-2 mb-2">
                    <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary);">sync</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">Rating Reconciliation</span>
                </div>
                <p class="text-sm mb-3" style="color: var(--md-sys-color-on-surface-variant);">
                    Preview what this player's rating would be after replaying all battle history.
                </p>
                <form method="post" asp-page-handler="PreviewReconcile">
                    <input type="hidden" name="playerId" value="@p.Id" />
                    <button class="md3-btn-tonal w-full" type="submit">
                        Preview Rating Reconciliation
                    </button>
                </form>

                @if (Model.ReconciliationPreview != null)
                {
                    var rp = Model.ReconciliationPreview;
                    <div class="mt-3 p-4 rounded-lg" style="background: var(--md-sys-color-surface-container-high);">
                        <div class="flex justify-between mb-2">
                            <span style="color: var(--md-sys-color-on-surface-variant);">Current Rating</span>
                            <span class="font-bold" style="color: var(--md-sys-color-on-surface);">@rp.CurrentRating</span>
                        </div>
                        <div class="flex justify-between mb-2">
                            <span style="color: var(--md-sys-color-on-surface-variant);">Recalculated Rating</span>
                            <span class="font-bold" style="color: var(--md-sys-color-on-surface);">@rp.RecalculatedRating</span>
                        </div>
                        <div class="flex justify-between mb-2">
                            <span style="color: var(--md-sys-color-on-surface-variant);">Delta</span>
                            <span class="font-bold" style="color: @(rp.Delta > 0 ? "var(--md-sys-color-primary)" : rp.Delta < 0 ? "var(--md-sys-color-error)" : "var(--md-sys-color-on-surface)");">
                                @(rp.Delta > 0 ? "+" : "")@rp.Delta
                            </span>
                        </div>
                        <div class="flex justify-between mb-2">
                            <span style="color: var(--md-sys-color-on-surface-variant);">Ranked Battles Replayed</span>
                            <span style="color: var(--md-sys-color-on-surface);">@rp.RankedBattlesReplayed</span>
                        </div>
                        <div class="flex justify-between">
                            <span style="color: var(--md-sys-color-on-surface-variant);">Casual Battles Fixed</span>
                            <span style="color: var(--md-sys-color-on-surface);">@rp.CasualBattlesFixed</span>
                        </div>
                        @if (rp.Delta != 0)
                        {
                            <p class="text-sm mt-3" style="color: var(--md-sys-color-on-surface-variant);">
                                To apply corrections, use <a href="/Admin/Tools" style="color: var(--md-sys-color-primary);">Global Reconcile</a> on the Tools page.
                            </p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent Battles -->
<div class="md3-card overflow-hidden">
    <div class="px-6 py-4" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h3 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Recent Battles (@p.Wins W - @(p.TotalBattles - p.Wins) L)</h3>
    </div>
    <div>
        @if (p.RecentBattles.Any())
        {
            @foreach (var battle in p.RecentBattles)
            {
                <div class="px-6 py-3 flex items-center justify-between" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                    <div>
                        <span class="font-medium" style="color: var(--md-sys-color-on-surface);">vs @battle.OpponentName</span>
                        <span class="text-sm ml-2" style="color: var(--md-sys-color-on-surface-variant);">@battle.CompletedAt.ToString("MMM dd, HH:mm")</span>
                    </div>
                    <div class="flex items-center space-x-3">
                        @if (battle.Mode == "casual")
                        {
                            <span class="text-xs px-2 py-0.5 rounded-full font-medium" style="background: color-mix(in srgb, var(--md-sys-color-tertiary) 15%, transparent); color: var(--md-sys-color-tertiary);">casual</span>
                        }
                        <span class="text-sm" style="color: @(battle.RatingChange >= 0 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-error)");">
                            @(battle.RatingChange >= 0 ? "+" : "")@battle.RatingChange
                        </span>
                        @if (battle.IsWin)
                        {
                            <span class="md3-badge-primary">Won</span>
                        }
                        else
                        {
                            <span class="md3-badge-error">Lost</span>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="px-6 py-8 text-center" style="color: var(--md-sys-color-on-surface-variant);">No battles recorded.</div>
        }
    </div>
</div>

<!-- API Keys -->
<div class="md3-card overflow-hidden mt-6">
    <div class="px-6 py-4 flex items-center gap-2" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary);">key</span>
        <h3 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">API Keys (@p.ApiKeys.Count)</h3>
    </div>
    <div>
        @if (p.ApiKeys.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr style="background: var(--md-sys-color-surface-container); border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                            <th class="px-4 py-2 text-left font-medium" style="color: var(--md-sys-color-on-surface-variant);">Name</th>
                            <th class="px-4 py-2 text-left font-medium" style="color: var(--md-sys-color-on-surface-variant);">Prefix</th>
                            <th class="px-4 py-2 text-center font-medium" style="color: var(--md-sys-color-on-surface-variant);">Status</th>
                            <th class="px-4 py-2 text-left font-medium" style="color: var(--md-sys-color-on-surface-variant);">Created</th>
                            <th class="px-4 py-2 text-left font-medium" style="color: var(--md-sys-color-on-surface-variant);">Last Used</th>
                            <th class="px-4 py-2 text-right font-medium" style="color: var(--md-sys-color-on-surface-variant);">Requests</th>
                            <th class="px-4 py-2 text-right font-medium" style="color: var(--md-sys-color-on-surface-variant);">Unique IPs</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in p.ApiKeys)
                        {
                            <tr style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                                <td class="px-4 py-2 font-medium" style="color: var(--md-sys-color-on-surface);">@key.Name</td>
                                <td class="px-4 py-2 font-mono text-xs" style="color: var(--md-sys-color-on-surface-variant);">@key.KeyPrefix...</td>
                                <td class="px-4 py-2 text-center">
                                    @if (key.IsActive)
                                    {
                                        <span class="md3-badge-primary">Active</span>
                                    }
                                    else
                                    {
                                        <span class="md3-badge-error">Revoked</span>
                                    }
                                </td>
                                <td class="px-4 py-2" style="color: var(--md-sys-color-on-surface-variant); white-space: nowrap;">@key.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="px-4 py-2" style="color: var(--md-sys-color-on-surface-variant); white-space: nowrap;">@(key.LastUsedAt?.ToString("MMM dd, HH:mm") ?? "Never")</td>
                                <td class="px-4 py-2 text-right font-mono" style="color: var(--md-sys-color-on-surface);">@key.TotalRequests.ToString("N0")</td>
                                <td class="px-4 py-2 text-right font-mono" style="color: var(--md-sys-color-on-surface);">@key.UniqueIps</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="px-6 py-8 text-center" style="color: var(--md-sys-color-on-surface-variant);">No API keys created.</div>
        }
    </div>
</div>

<!-- Subscription History -->
<div class="md3-card overflow-hidden mt-6">
    <div class="px-6 py-4 flex items-center gap-2" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary);">receipt_long</span>
        <h3 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Subscription History</h3>
    </div>
    <div>
        @if (p.SubscriptionHistory.Any())
        {
            @foreach (var evt in p.SubscriptionHistory)
            {
                <div class="px-6 py-3 flex items-center justify-between" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                    <div class="flex items-center gap-3">
                        @{
                            var evtBadge = evt.EventType switch
                            {
                                "upgraded" => "md3-badge-primary",
                                "downgraded" => "md3-badge-error",
                                "cancelled" => "md3-badge-error",
                                "renewed" => "md3-badge-primary",
                                _ => "md3-badge-secondary"
                            };
                        }
                        <span class="@evtBadge text-xs">@evt.EventType</span>
                        <span style="color: var(--md-sys-color-on-surface);">
                            @if (evt.OldTier != null && evt.NewTier != null)
                            {
                                @evt.OldTier <span style="color: var(--md-sys-color-outline);">→</span> @evt.NewTier
                            }
                            else if (evt.NewTier != null)
                            {
                                @evt.NewTier
                            }
                        </span>
                        @if (evt.AmountUsd.HasValue)
                        {
                            <span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">$@evt.AmountUsd.Value.ToString("F2")</span>
                        }
                    </div>
                    <span class="text-sm" style="color: var(--md-sys-color-on-surface-variant); white-space: nowrap;">@evt.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                </div>
            }
        }
        else
        {
            <div class="px-6 py-8 text-center" style="color: var(--md-sys-color-on-surface-variant);">No subscription events recorded.</div>
        }
    </div>
</div>

<!-- Support Timeline -->
<div class="md3-card overflow-hidden mt-6">
    <div class="px-6 py-4 flex items-center justify-between" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary);">history</span>
            <h3 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Support Timeline</h3>
        </div>
        <form method="get" class="flex items-center gap-2">
            <input type="hidden" name="id" value="@p.Id" />
            <select name="ledgerProperty" class="md3-select text-sm" onchange="this.form.submit()">
                <option value="">All Properties</option>
                <option value="Rating" selected="@(Model.LedgerProperty == "Rating")">Rating</option>
                <option value="Currency" selected="@(Model.LedgerProperty == "Currency")">Currency</option>
                <option value="ExperiencePoints" selected="@(Model.LedgerProperty == "ExperiencePoints")">XP</option>
                <option value="Level" selected="@(Model.LedgerProperty == "Level")">Level</option>
                <option value="WinStreak" selected="@(Model.LedgerProperty == "WinStreak")">Win Streak</option>
                <option value="Gems" selected="@(Model.LedgerProperty == "Gems")">Gems</option>
                <option value="AchievementPoints" selected="@(Model.LedgerProperty == "AchievementPoints")">Achievement Pts</option>
            </select>
        </form>
    </div>
    <div class="overflow-x-auto">
        @if (Model.LedgerEntries.Any())
        {
            <table class="w-full text-sm">
                <thead>
                    <tr style="background: var(--md-sys-color-surface-container); border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                        <th class="px-4 py-2 text-left font-medium" style="color: var(--md-sys-color-on-surface-variant);">Timestamp</th>
                        <th class="px-4 py-2 text-left font-medium" style="color: var(--md-sys-color-on-surface-variant);">Source</th>
                        <th class="px-4 py-2 text-left font-medium" style="color: var(--md-sys-color-on-surface-variant);">Action</th>
                        <th class="px-4 py-2 text-left font-medium" style="color: var(--md-sys-color-on-surface-variant);">Property</th>
                        <th class="px-4 py-2 text-right font-medium" style="color: var(--md-sys-color-on-surface-variant);">Old</th>
                        <th class="px-4 py-2 text-center font-medium" style="color: var(--md-sys-color-on-surface-variant);"></th>
                        <th class="px-4 py-2 text-left font-medium" style="color: var(--md-sys-color-on-surface-variant);">New</th>
                        <th class="px-4 py-2 text-right font-medium" style="color: var(--md-sys-color-on-surface-variant);">Delta</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.LedgerEntries)
                    {
                        <tr style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                            <td class="px-4 py-2" style="color: var(--md-sys-color-on-surface-variant); white-space: nowrap;">
                                @entry.Timestamp.ToString("MMM dd, HH:mm:ss")
                            </td>
                            <td class="px-4 py-2">
                                <span class="text-xs px-2 py-0.5 rounded-full font-medium"
                                      style="background: color-mix(in srgb, var(--md-sys-color-tertiary) 15%, transparent); color: var(--md-sys-color-tertiary);">
                                    @entry.Source
                                </span>
                            </td>
                            <td class="px-4 py-2" style="color: var(--md-sys-color-on-surface);">@entry.Action</td>
                            <td class="px-4 py-2" style="color: var(--md-sys-color-on-surface);">@entry.Property</td>
                            <td class="px-4 py-2 text-right font-mono" style="color: var(--md-sys-color-on-surface-variant);">@entry.OldValue.ToString("N0")</td>
                            <td class="px-4 py-2 text-center" style="color: var(--md-sys-color-outline);">→</td>
                            <td class="px-4 py-2 font-mono" style="color: var(--md-sys-color-on-surface);">@entry.NewValue.ToString("N0")</td>
                            <td class="px-4 py-2 text-right font-mono font-bold"
                                style="color: @(entry.Delta > 0 ? "var(--md-sys-color-primary)" : entry.Delta < 0 ? "var(--md-sys-color-error)" : "var(--md-sys-color-on-surface)");">
                                @(entry.Delta > 0 ? "+" : "")@entry.Delta.ToString("N0")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="px-6 py-8 text-center" style="color: var(--md-sys-color-on-surface-variant);">
                No ledger entries recorded yet.
            </div>
        }
    </div>
</div>
