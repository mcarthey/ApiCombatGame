@page
@model ApiCombatGame.Pages.Admin.EasterEggsModel
@{
    ViewData["Title"] = "Easter Egg Hunt";
    Layout = "_AdminLayout";
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="md3-alert-success mb-6">
        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: text-bottom;">check_circle</span>
        @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="md3-alert-error mb-6">
        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: text-bottom;">error</span>
        @Model.ErrorMessage
    </div>
}

<!-- Summary Stats -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="md3-card p-5">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Total Eggs (All Time)</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.TotalEggsAllTime</div>
    </div>
    <div class="md3-card p-5">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Total Claims</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-primary);">@Model.TotalClaimsAllTime</div>
    </div>
    <div class="md3-card p-5">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Loot Awarded</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-tertiary);">@Model.TotalLootAwarded.ToString("N0")</div>
    </div>
    <div class="md3-card p-5">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Unique Hunters</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.UniqueFinders</div>
    </div>
</div>

<!-- Active Eggs (This Week) -->
<div class="md3-card p-6 mb-8">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">
            <span class="material-symbols-outlined" style="font-size: 22px; vertical-align: text-bottom; color: var(--md-sys-color-tertiary);">egg_alt</span>
            This Week's Eggs
        </h2>
        <div class="flex gap-2">
            <button class="md3-btn-tonal" onclick="document.getElementById('create-dialog').showModal()">
                <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
                New Egg
            </button>
            <form method="post" asp-page-handler="Regenerate" style="display: inline;">
                <button class="md3-btn-outlined" type="submit" onclick="return confirm('Regenerate this week\'s eggs? Current ones will be deactivated.');">
                    <span class="material-symbols-outlined" style="font-size: 18px;">refresh</span>
                    Regenerate
                </button>
            </form>
        </div>
    </div>

    @if (Model.ActiveEggs.Count == 0)
    {
        <p class="text-sm py-4" style="color: var(--md-sys-color-on-surface-variant);">No eggs for this week yet. Click "New Egg" or "Regenerate" to create some.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="md3-table w-full">
                <thead>
                    <tr>
                        <th class="text-left">Page</th>
                        <th class="text-left">Code</th>
                        <th class="text-left">Position</th>
                        <th class="text-center">Difficulty</th>
                        <th class="text-center">Icon</th>
                        <th class="text-center">Claims</th>
                        <th class="text-center">Active</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ActiveEggs)
                    {
                        <tr>
                            <td>
                                <div class="font-medium" style="color: var(--md-sys-color-on-surface);">@item.Egg.PagePath</div>
                                <div class="text-xs" style="color: var(--md-sys-color-on-surface-variant);">@item.Egg.CssSelector</div>
                            </td>
                            <td>
                                <code style="background: var(--md-sys-color-surface-container-high); padding: 2px 8px; border-radius: 4px; font-size: 13px;">@item.Egg.Code</code>
                            </td>
                            <td class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                                @item.Egg.OffsetX.ToString("F0")% / @item.Egg.OffsetY.ToString("F0")%
                            </td>
                            <td class="text-center">
                                @{
                                    var diffColor = item.Egg.Difficulty switch
                                    {
                                        1 => "var(--md-sys-color-primary)",
                                        2 => "#f59e0b",
                                        _ => "var(--md-sys-color-error)"
                                    };
                                    var diffLabel = item.Egg.Difficulty switch
                                    {
                                        1 => "Easy",
                                        2 => "Medium",
                                        _ => "Hard"
                                    };
                                }
                                <span class="md3-badge" style="background: color-mix(in srgb, @diffColor 15%, transparent); color: @diffColor; padding: 2px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500;">@diffLabel</span>
                            </td>
                            <td class="text-center">
                                <span class="material-symbols-outlined" style="font-size: 20px; color: var(--md-sys-color-tertiary);">@item.Egg.IconName</span>
                            </td>
                            <td class="text-center font-semibold" style="color: var(--md-sys-color-on-surface);">@item.ClaimCount</td>
                            <td class="text-center">
                                <form method="post" asp-page-handler="ToggleActive" style="display: inline;">
                                    <input type="hidden" name="eggId" value="@item.Egg.Id" />
                                    <button type="submit" class="md3-btn-icon" title="@(item.Egg.IsActive ? "Deactivate" : "Activate")">
                                        <span class="material-symbols-outlined" style="font-size: 20px; color: @(item.Egg.IsActive ? "var(--md-sys-color-primary)" : "var(--md-sys-color-outline)");">
                                            @(item.Egg.IsActive ? "toggle_on" : "toggle_off")
                                        </span>
                                    </button>
                                </form>
                            </td>
                            <td class="text-right">
                                <button class="md3-btn-icon" title="Edit" onclick="openEditDialog('@item.Egg.Id', '@item.Egg.Code', '@item.Egg.PagePath', '@item.Egg.CssSelector', @item.Egg.OffsetX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture), @item.Egg.OffsetY.ToString("F1", System.Globalization.CultureInfo.InvariantCulture), '@item.Egg.WeekStart.ToString("yyyy-MM-dd")', '@item.Egg.WeekEnd.ToString("yyyy-MM-dd")', @item.Egg.Difficulty, '@item.Egg.IconName', '@(item.Egg.HintText?.Replace("'", "\\'") ?? "")', @(item.Egg.IsActive ? "true" : "false"))">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
                                </button>
                                <form method="post" asp-page-handler="Delete" style="display: inline;">
                                    <input type="hidden" name="eggId" value="@item.Egg.Id" />
                                    <button type="submit" class="md3-btn-icon" title="Deactivate" onclick="return confirm('Deactivate this egg?');">
                                        <span class="material-symbols-outlined" style="font-size: 18px; color: var(--md-sys-color-error);">delete</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Past Eggs -->
@if (Model.PastEggs.Count > 0)
{
    <div class="md3-card p-6 mb-8">
        <h2 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">
            <span class="material-symbols-outlined" style="font-size: 22px; vertical-align: text-bottom; color: var(--md-sys-color-outline);">history</span>
            Past Eggs (Last 4 Weeks)
        </h2>
        <div class="overflow-x-auto">
            <table class="md3-table w-full">
                <thead>
                    <tr>
                        <th class="text-left">Week</th>
                        <th class="text-left">Page</th>
                        <th class="text-left">Code</th>
                        <th class="text-center">Difficulty</th>
                        <th class="text-center">Claims</th>
                        <th class="text-center">Active</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PastEggs)
                    {
                        <tr style="opacity: @(item.Egg.IsActive ? "1" : "0.5");">
                            <td class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                                @item.Egg.WeekStart.ToString("MMM d") – @item.Egg.WeekEnd.ToString("MMM d")
                            </td>
                            <td class="font-medium" style="color: var(--md-sys-color-on-surface);">@item.Egg.PagePath</td>
                            <td>
                                <code style="background: var(--md-sys-color-surface-container-high); padding: 2px 8px; border-radius: 4px; font-size: 13px;">@item.Egg.Code</code>
                            </td>
                            <td class="text-center">
                                @{
                                    var pastDiffColor = item.Egg.Difficulty switch { 1 => "var(--md-sys-color-primary)", 2 => "#f59e0b", _ => "var(--md-sys-color-error)" };
                                    var pastDiffLabel = item.Egg.Difficulty switch { 1 => "Easy", 2 => "Medium", _ => "Hard" };
                                }
                                <span style="color: @pastDiffColor; font-size: 12px; font-weight: 500;">@pastDiffLabel</span>
                            </td>
                            <td class="text-center font-semibold" style="color: var(--md-sys-color-on-surface);">@item.ClaimCount</td>
                            <td class="text-center">
                                <span class="material-symbols-outlined" style="font-size: 16px; color: @(item.Egg.IsActive ? "var(--md-sys-color-primary)" : "var(--md-sys-color-outline)");">
                                    @(item.Egg.IsActive ? "check_circle" : "cancel")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Recent Claims -->
<div class="md3-card p-6 mb-8">
    <h2 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">
        <span class="material-symbols-outlined" style="font-size: 22px; vertical-align: text-bottom; color: var(--md-sys-color-primary);">receipt_long</span>
        Recent Claims
    </h2>
    @if (Model.RecentClaims.Count == 0)
    {
        <p class="text-sm py-4" style="color: var(--md-sys-color-on-surface-variant);">No claims yet. Eggs are waiting to be found!</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="md3-table w-full">
                <thead>
                    <tr>
                        <th class="text-left">Player</th>
                        <th class="text-left">Egg</th>
                        <th class="text-left">Page</th>
                        <th class="text-left">Loot</th>
                        <th class="text-right">When</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model.RecentClaims)
                    {
                        <tr>
                            <td class="font-medium" style="color: var(--md-sys-color-on-surface);">@claim.PlayerName</td>
                            <td>
                                <code style="background: var(--md-sys-color-surface-container-high); padding: 2px 8px; border-radius: 4px; font-size: 13px;">@claim.EggCode</code>
                            </td>
                            <td class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">@claim.EggPage</td>
                            <td>
                                @{
                                    var lootIcon = claim.LootType switch { "Gems" => "diamond", "XpBoost" => "electric_bolt", _ => "paid" };
                                    var lootColor = claim.LootType switch { "Gems" => "var(--md-sys-color-tertiary)", "XpBoost" => "var(--md-sys-color-primary)", _ => "#facc15" };
                                }
                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-outlined" style="font-size: 16px; color: @lootColor;">@lootIcon</span>
                                    <span class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">@claim.LootDescription</span>
                                </span>
                            </td>
                            <td class="text-right text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                                @claim.ClaimedAt.ToString("MMM d, h:mm tt")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Create Egg Dialog -->
<dialog id="create-dialog" class="md3-dialog" style="max-width: 520px; width: 90vw;">
    <form method="post" asp-page-handler="Create">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">
            <span class="material-symbols-outlined" style="font-size: 22px; vertical-align: text-bottom; color: var(--md-sys-color-tertiary);">add_circle</span>
            Create New Egg
        </h3>

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div class="md3-input-wrapper">
                <label for="c-code">Code</label>
                <input class="md3-input" id="c-code" name="EditInput.Code" required placeholder="CHEST-XXXX" />
            </div>
            <div class="md3-input-wrapper">
                <label for="c-page">Page Path</label>
                <input class="md3-input" id="c-page" name="EditInput.PagePath" required placeholder="/api-docs/v1" />
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div class="md3-input-wrapper">
                <label for="c-selector">CSS Selector</label>
                <input class="md3-input" id="c-selector" name="EditInput.CssSelector" placeholder="main" value="main" />
            </div>
            <div class="md3-input-wrapper">
                <label for="c-icon">Icon Name</label>
                <input class="md3-input" id="c-icon" name="EditInput.IconName" placeholder="egg_alt" value="egg_alt" />
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div class="md3-input-wrapper">
                <label for="c-ox">Offset X (%)</label>
                <input class="md3-input" id="c-ox" name="EditInput.OffsetX" type="number" step="0.1" min="0" max="100" value="50" />
            </div>
            <div class="md3-input-wrapper">
                <label for="c-oy">Offset Y (%)</label>
                <input class="md3-input" id="c-oy" name="EditInput.OffsetY" type="number" step="0.1" min="0" max="100" value="50" />
            </div>
        </div>

        <div class="grid grid-cols-3 gap-4 mb-4">
            <div class="md3-input-wrapper">
                <label for="c-diff">Difficulty</label>
                <select class="md3-input" id="c-diff" name="EditInput.Difficulty">
                    <option value="1">Easy</option>
                    <option value="2">Medium</option>
                    <option value="3">Hard</option>
                </select>
            </div>
            <div class="md3-input-wrapper">
                <label for="c-start">Week Start</label>
                <input class="md3-input" id="c-start" name="EditInput.WeekStart" type="date" required />
            </div>
            <div class="md3-input-wrapper">
                <label for="c-end">Week End</label>
                <input class="md3-input" id="c-end" name="EditInput.WeekEnd" type="date" required />
            </div>
        </div>

        <div class="md3-input-wrapper mb-4">
            <label for="c-hint">Hint Text (optional)</label>
            <input class="md3-input" id="c-hint" name="EditInput.HintText" placeholder="Look near the hero stats..." />
        </div>

        <div class="flex justify-end gap-2 mt-6">
            <button type="button" class="md3-btn-text" onclick="document.getElementById('create-dialog').close()">Cancel</button>
            <button type="submit" class="md3-btn-filled">
                <span class="material-symbols-outlined" style="font-size: 18px;">egg_alt</span>
                Create Egg
            </button>
        </div>
    </form>
</dialog>

<!-- Edit Egg Dialog -->
<dialog id="edit-dialog" class="md3-dialog" style="max-width: 520px; width: 90vw;">
    <form method="post" asp-page-handler="Edit">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">
            <span class="material-symbols-outlined" style="font-size: 22px; vertical-align: text-bottom; color: var(--md-sys-color-primary);">edit</span>
            Edit Egg
        </h3>

        <input type="hidden" id="e-id" name="EditInput.Id" />

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div class="md3-input-wrapper">
                <label for="e-code">Code</label>
                <input class="md3-input" id="e-code" name="EditInput.Code" required />
            </div>
            <div class="md3-input-wrapper">
                <label for="e-page">Page Path</label>
                <input class="md3-input" id="e-page" name="EditInput.PagePath" required />
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div class="md3-input-wrapper">
                <label for="e-selector">CSS Selector</label>
                <input class="md3-input" id="e-selector" name="EditInput.CssSelector" />
            </div>
            <div class="md3-input-wrapper">
                <label for="e-icon">Icon Name</label>
                <input class="md3-input" id="e-icon" name="EditInput.IconName" />
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div class="md3-input-wrapper">
                <label for="e-ox">Offset X (%)</label>
                <input class="md3-input" id="e-ox" name="EditInput.OffsetX" type="number" step="0.1" min="0" max="100" />
            </div>
            <div class="md3-input-wrapper">
                <label for="e-oy">Offset Y (%)</label>
                <input class="md3-input" id="e-oy" name="EditInput.OffsetY" type="number" step="0.1" min="0" max="100" />
            </div>
        </div>

        <div class="grid grid-cols-3 gap-4 mb-4">
            <div class="md3-input-wrapper">
                <label for="e-diff">Difficulty</label>
                <select class="md3-input" id="e-diff" name="EditInput.Difficulty">
                    <option value="1">Easy</option>
                    <option value="2">Medium</option>
                    <option value="3">Hard</option>
                </select>
            </div>
            <div class="md3-input-wrapper">
                <label for="e-start">Week Start</label>
                <input class="md3-input" id="e-start" name="EditInput.WeekStart" type="date" required />
            </div>
            <div class="md3-input-wrapper">
                <label for="e-end">Week End</label>
                <input class="md3-input" id="e-end" name="EditInput.WeekEnd" type="date" required />
            </div>
        </div>

        <div class="md3-input-wrapper mb-4">
            <label for="e-hint">Hint Text (optional)</label>
            <input class="md3-input" id="e-hint" name="EditInput.HintText" />
        </div>

        <div class="flex items-center gap-2 mb-4">
            <input type="checkbox" id="e-active" name="EditInput.IsActive" value="true" />
            <label for="e-active" class="text-sm font-medium" style="color: var(--md-sys-color-on-surface);">Active</label>
        </div>

        <div class="flex justify-end gap-2 mt-6">
            <button type="button" class="md3-btn-text" onclick="document.getElementById('edit-dialog').close()">Cancel</button>
            <button type="submit" class="md3-btn-filled">
                <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                Save Changes
            </button>
        </div>
    </form>
</dialog>

@section Scripts {
<script>
    // Pre-fill create dialog dates with current week
    (function () {
        var now = new Date();
        var day = now.getDay();
        var monday = new Date(now);
        monday.setDate(now.getDate() - ((day + 6) % 7));
        var sunday = new Date(monday);
        sunday.setDate(monday.getDate() + 6);

        var fmt = function (d) { return d.toISOString().split('T')[0]; };
        var startEl = document.getElementById('c-start');
        var endEl = document.getElementById('c-end');
        if (startEl && !startEl.value) startEl.value = fmt(monday);
        if (endEl && !endEl.value) endEl.value = fmt(sunday);
    })();

    // Close dialogs on backdrop click
    document.querySelectorAll('dialog').forEach(function (d) {
        d.addEventListener('click', function (e) {
            if (e.target === d) d.close();
        });
    });

    function openEditDialog(id, code, page, selector, ox, oy, start, end, diff, icon, hint, active) {
        document.getElementById('e-id').value = id;
        document.getElementById('e-code').value = code;
        document.getElementById('e-page').value = page;
        document.getElementById('e-selector').value = selector;
        document.getElementById('e-ox').value = ox;
        document.getElementById('e-oy').value = oy;
        document.getElementById('e-start').value = start;
        document.getElementById('e-end').value = end;
        document.getElementById('e-diff').value = diff;
        document.getElementById('e-icon').value = icon;
        document.getElementById('e-hint').value = hint;
        document.getElementById('e-active').checked = active;

        document.getElementById('edit-dialog').showModal();
    }
</script>
}
