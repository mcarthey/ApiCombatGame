@page
@model ApiCombatGame.Pages.Admin.GuildsModel
@{
    ViewData["Title"] = "Guild Analytics";
    Layout = "_AdminLayout";
}

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Total Guilds</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalGuilds</div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Total Members</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalGuildMembers</div>
        <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Avg @Model.Data.AvgMembersPerGuild/guild</div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Bosses Spawned</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalBossesSpawned</div>
    </div>
    <div class="md3-card stat-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Boss Completion</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.Data.BossCompletionRate%</div>
        <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">@Model.Data.TotalBossesDefeated defeated</div>
    </div>
</div>

<!-- Top Guilds Table -->
<div class="md3-card overflow-hidden">
    <div class="px-6 py-4" style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <h3 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Top Guilds</h3>
    </div>
    @if (Model.Data.TopGuilds.Any())
    {
        <div class="overflow-x-auto">
            <table class="md3-table min-w-full">
                <thead>
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Guild</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Level</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Members</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Avg Rating</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Treasury</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Premium %</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guild in Model.Data.TopGuilds)
                    {
                        <tr>
                            <td class="px-6 py-4">
                                <div class="font-medium" style="color: var(--md-sys-color-on-surface);">@guild.Name</div>
                                <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">[@guild.Tag]</div>
                            </td>
                            <td class="px-6 py-4 text-sm" style="color: var(--md-sys-color-on-surface);">@guild.Level</td>
                            <td class="px-6 py-4 text-sm" style="color: var(--md-sys-color-on-surface);">@guild.MemberCount / @guild.MaxMembers</td>
                            <td class="px-6 py-4 text-sm font-medium" style="color: var(--md-sys-color-on-surface);">@guild.AvgMemberRating</td>
                            <td class="px-6 py-4 text-sm" style="color: var(--md-sys-color-on-surface);">@guild.TreasuryBalance.ToString("N0")</td>
                            <td class="px-6 py-4 text-sm">
                                <span style="color: @(guild.PremiumRate >= 70 ? "var(--md-sys-color-primary)" : "var(--md-sys-color-on-surface)"); @(guild.PremiumRate >= 70 ? "font-weight: 500;" : "")">
                                    @guild.PremiumRate%
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm" style="color: var(--md-sys-color-on-surface-variant);">@guild.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-8 text-center" style="color: var(--md-sys-color-on-surface-variant);">No guilds created yet.</div>
    }
</div>
