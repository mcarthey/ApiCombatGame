@page
@model ApiCombatGame.Pages.Admin.GuildsModel
@{
    ViewData["Title"] = "Guild Analytics";
    Layout = "_AdminLayout";
}

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Total Guilds</div>
        <div class="text-3xl font-bold mt-1">@Model.Data.TotalGuilds</div>
    </div>
    <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Total Members</div>
        <div class="text-3xl font-bold mt-1">@Model.Data.TotalGuildMembers</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">Avg @Model.Data.AvgMembersPerGuild/guild</div>
    </div>
    <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Bosses Spawned</div>
        <div class="text-3xl font-bold mt-1">@Model.Data.TotalBossesSpawned</div>
    </div>
    <div class="stat-card bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 border dark:border-gray-700">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Boss Completion</div>
        <div class="text-3xl font-bold mt-1">@Model.Data.BossCompletionRate%</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">@Model.Data.TotalBossesDefeated defeated</div>
    </div>
</div>

<!-- Top Guilds Table -->
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-4 border-b dark:border-gray-700">
        <h3 class="text-lg font-semibold">Top Guilds</h3>
    </div>
    @if (Model.Data.TopGuilds.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-900">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Guild</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Level</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Members</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Avg Rating</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Treasury</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Premium %</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Created</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @foreach (var guild in Model.Data.TopGuilds)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-750">
                            <td class="px-6 py-4">
                                <div class="font-medium">@guild.Name</div>
                                <div class="text-sm text-gray-500 dark:text-gray-400">[@guild.Tag]</div>
                            </td>
                            <td class="px-6 py-4 text-sm">@guild.Level</td>
                            <td class="px-6 py-4 text-sm">@guild.MemberCount / @guild.MaxMembers</td>
                            <td class="px-6 py-4 text-sm font-medium">@guild.AvgMemberRating</td>
                            <td class="px-6 py-4 text-sm">@guild.TreasuryBalance.ToString("N0")</td>
                            <td class="px-6 py-4 text-sm">
                                <span class="@(guild.PremiumRate >= 70 ? "text-green-600 dark:text-green-400 font-medium" : "")">
                                    @guild.PremiumRate%
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">@guild.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">No guilds created yet.</div>
    }
</div>
