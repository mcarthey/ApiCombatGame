@page
@model ApiCombatGame.Pages.Admin.TechnicalModel
@{
    ViewData["Title"] = "Technical Health";
    Layout = "_AdminLayout";
}

<!-- Battle Pipeline -->
<div class="md3-card p-6 mb-6">
    <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Battle Pipeline</h3>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div class="text-center p-4" style="background: var(--md-sys-color-tertiary-container); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-tertiary-container);">@Model.Data.QueuedBattles</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-tertiary-container);">Queued</div>
        </div>
        <div class="text-center p-4" style="background: var(--md-sys-color-primary-container); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-primary-container);">@Model.Data.MatchedBattles</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-primary-container);">Matched</div>
        </div>
        <div class="text-center p-4" style="background: var(--md-sys-color-secondary-container); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-secondary-container);">@Model.Data.CompletedBattlesToday</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-secondary-container);">Completed Today</div>
        </div>
        <div class="text-center p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.CompletedBattles.ToString("N0")</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Total Completed</div>
        </div>
        <div class="text-center p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalBattles.ToString("N0")</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Total All Time</div>
        </div>
    </div>
</div>

<!-- Database Entity Counts -->
<div class="md3-card p-6 mb-6">
    <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Database Overview</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalPlayers.ToString("N0")</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Players</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalUnits.ToString("N0")</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Player Units</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalTeams.ToString("N0")</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Teams</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalGuilds.ToString("N0")</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Guilds</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalStrategies.ToString("N0")</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Marketplace Strategies</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalChallenges.ToString("N0")</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Daily Challenges</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalAchievementUnlocks.ToString("N0")</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Achievement Unlocks</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="text-2xl font-bold" style="color: var(--md-sys-color-on-surface);">@Model.Data.TotalBattles.ToString("N0")</div>
            <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">Total Battles</div>
        </div>
    </div>
</div>

<!-- Background Jobs Status -->
<div class="md3-card p-6">
    <h3 class="text-lg font-semibold mb-2" style="color: var(--md-sys-color-on-surface);">Background Jobs</h3>
    <p class="text-sm mb-4" style="color: var(--md-sys-color-on-surface-variant);">10 hosted services running in the application pipeline. All jobs start automatically on app boot.</p>

    <!-- Continuous -->
    <div class="text-xs font-semibold uppercase tracking-wider mb-2 mt-4" style="color: var(--md-sys-color-primary);">Continuous</div>
    <div class="space-y-3 mb-6">
        <details class="group" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <summary class="p-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                <div class="flex items-center justify-between mb-1">
                    <div class="flex items-center">
                        <span class="material-symbols-outlined mr-3" style="color: var(--md-sys-color-primary);">swords</span>
                        <span class="font-medium" style="color: var(--md-sys-color-on-surface);">BackgroundBattleProcessor</span>
                        @if (Model.Data.QueuedBattleDetails.Any())
                        {
                            <span class="ml-2 text-xs font-bold px-1.5 py-0.5" style="background: var(--md-sys-color-tertiary-container); color: var(--md-sys-color-on-tertiary-container); border-radius: var(--md-sys-shape-corner-small);">@Model.Data.QueuedBattleDetails.Count in queue</span>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium px-2 py-1" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">Every 5s</span>
                        <span class="material-symbols-outlined transition-transform group-open:rotate-180" style="color: var(--md-sys-color-on-surface-variant); font-size: 18px;">expand_more</span>
                    </div>
                </div>
                <div class="text-sm ml-10" style="color: var(--md-sys-color-on-surface-variant);">Processes queued battles through the combat engine, resolves matches, and updates ratings.</div>
            </summary>
            <div class="px-4 pb-4" style="border-top: 1px solid var(--md-sys-color-outline-variant);">
                @if (Model.Data.QueuedBattleDetails.Any())
                {
                    <div class="overflow-hidden mt-3" style="border-radius: var(--md-sys-shape-corner-medium);">
                        <table class="md3-table w-full text-sm">
                            <thead>
                                <tr>
                                    <th class="px-3 py-2 text-left text-xs font-medium uppercase">Player</th>
                                    <th class="px-3 py-2 text-left text-xs font-medium uppercase">Rating</th>
                                    <th class="px-3 py-2 text-left text-xs font-medium uppercase">Mode</th>
                                    <th class="px-3 py-2 text-left text-xs font-medium uppercase">Waiting</th>
                                    <th class="px-3 py-2 text-left text-xs font-medium uppercase">Battle ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var battle in Model.Data.QueuedBattleDetails)
                                {
                                    var waitColor = battle.WaitSeconds > 60 ? "var(--md-sys-color-error)" :
                                                    battle.WaitSeconds > 15 ? "var(--md-sys-color-tertiary-container)" :
                                                    "var(--md-sys-color-on-surface-variant)";
                                    <tr>
                                        <td class="px-3 py-2">
                                            @battle.PlayerName
                                            @if (battle.IsBot)
                                            {
                                                <span class="text-xs ml-1 px-1 py-0.5" style="background: var(--md-sys-color-surface-container-highest); color: var(--md-sys-color-on-surface-variant); border-radius: var(--md-sys-shape-corner-small);">BOT</span>
                                            }
                                        </td>
                                        <td class="px-3 py-2 font-mono text-xs">@battle.PlayerRating</td>
                                        <td class="px-3 py-2 text-xs">@battle.Mode</td>
                                        <td class="px-3 py-2 font-mono text-xs" style="color: @waitColor;">
                                            @if (battle.WaitSeconds >= 60)
                                            {
                                                @($"{battle.WaitSeconds / 60:F0}m {battle.WaitSeconds % 60:F0}s")
                                            }
                                            else
                                            {
                                                @($"{battle.WaitSeconds:F0}s")
                                            }
                                        </td>
                                        <td class="px-3 py-2 font-mono text-xs" style="color: var(--md-sys-color-on-surface-variant);">@battle.BattleId.ToString()[..8]...</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-sm mt-3" style="color: var(--md-sys-color-on-surface-variant);">No battles currently in queue.</p>
                }
            </div>
        </details>
    </div>

    <!-- Hourly -->
    <div class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--md-sys-color-primary);">Hourly</div>
    <div class="space-y-3 mb-6">
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="flex items-center justify-between mb-1">
                <div class="flex items-center">
                    <span class="material-symbols-outlined mr-3" style="color: var(--md-sys-color-primary);">warning</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">AdminAlertJob</span>
                </div>
                <span class="text-xs font-medium px-2 py-1" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">Every 1h</span>
            </div>
            <div class="text-sm ml-10" style="color: var(--md-sys-color-on-surface-variant);">Monitors queue health, player growth milestones, and expired guild bosses. Creates admin alerts.</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="flex items-center justify-between mb-1">
                <div class="flex items-center">
                    <span class="material-symbols-outlined mr-3" style="color: var(--md-sys-color-primary);">sports_esports</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">TournamentProcessingJob</span>
                </div>
                <span class="text-xs font-medium px-2 py-1" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">Every 1h</span>
            </div>
            <div class="text-sm ml-10" style="color: var(--md-sys-color-on-surface-variant);">Creates weekly tournaments and processes ongoing tournament matches.</div>
        </div>
    </div>

    <!-- Every 6 Hours -->
    <div class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--md-sys-color-primary);">Every 6 Hours</div>
    <div class="space-y-3 mb-6">
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="flex items-center justify-between mb-1">
                <div class="flex items-center">
                    <span class="material-symbols-outlined mr-3" style="color: var(--md-sys-color-primary);">groups</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">GuildWarMatchingJob</span>
                </div>
                <span class="text-xs font-medium px-2 py-1" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">Every 6h</span>
            </div>
            <div class="text-sm ml-10" style="color: var(--md-sys-color-on-surface-variant);">Finalizes expired guild wars and matches new guilds for upcoming wars.</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="flex items-center justify-between mb-1">
                <div class="flex items-center">
                    <span class="material-symbols-outlined mr-3" style="color: var(--md-sys-color-primary);">delete_sweep</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">NotificationCleanupJob</span>
                </div>
                <span class="text-xs font-medium px-2 py-1" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">Every 6h</span>
            </div>
            <div class="text-sm ml-10" style="color: var(--md-sys-color-on-surface-variant);">Cleans up expired notifications from the database to keep things tidy.</div>
        </div>
    </div>

    <!-- Daily -->
    <div class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--md-sys-color-primary);">Daily</div>
    <div class="space-y-3 mb-6">
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="flex items-center justify-between mb-1">
                <div class="flex items-center">
                    <span class="material-symbols-outlined mr-3" style="color: var(--md-sys-color-primary);">task</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">DailyChallengeGenerationJob</span>
                </div>
                <span class="text-xs font-medium px-2 py-1" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">Midnight UTC</span>
            </div>
            <div class="text-sm ml-10" style="color: var(--md-sys-color-on-surface-variant);">Generates new daily challenges for all active players (logged in within 7 days).</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="flex items-center justify-between mb-1">
                <div class="flex items-center">
                    <span class="material-symbols-outlined mr-3" style="color: var(--md-sys-color-primary);">trending_down</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">StrategyDecayJob</span>
                </div>
                <span class="text-xs font-medium px-2 py-1" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">2 AM UTC</span>
            </div>
            <div class="text-sm ml-10" style="color: var(--md-sys-color-on-surface-variant);">Applies rating decay to marketplace strategies to prevent staleness and encourage fresh builds.</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="flex items-center justify-between mb-1">
                <div class="flex items-center">
                    <span class="material-symbols-outlined mr-3" style="color: var(--md-sys-color-primary);">mail</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">GuildInviteExpiryJob</span>
                </div>
                <span class="text-xs font-medium px-2 py-1" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">Daily</span>
            </div>
            <div class="text-sm ml-10" style="color: var(--md-sys-color-on-surface-variant);">Marks pending guild invites as expired when their expiration window has passed.</div>
        </div>
    </div>

    <!-- Weekly -->
    <div class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--md-sys-color-primary);">Weekly</div>
    <div class="space-y-3">
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="flex items-center justify-between mb-1">
                <div class="flex items-center">
                    <span class="material-symbols-outlined mr-3" style="color: var(--md-sys-color-primary);">shuffle</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">WeeklyModifierRotationJob</span>
                </div>
                <span class="text-xs font-medium px-2 py-1" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">Mondays 00:00 UTC</span>
            </div>
            <div class="text-sm ml-10" style="color: var(--md-sys-color-on-surface-variant);">Rotates the active battle modifier to keep the meta fresh each week.</div>
        </div>
        <div class="p-4" style="background: var(--md-sys-color-surface-container-high); border-radius: var(--md-sys-shape-corner-medium);">
            <div class="flex items-center justify-between mb-1">
                <div class="flex items-center">
                    <span class="material-symbols-outlined mr-3" style="color: var(--md-sys-color-primary);">destruction</span>
                    <span class="font-medium" style="color: var(--md-sys-color-on-surface);">GuildBossSpawnJob</span>
                </div>
                <span class="text-xs font-medium px-2 py-1" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border-radius: var(--md-sys-shape-corner-small);">Mondays 00:00 UTC</span>
            </div>
            <div class="text-sm ml-10" style="color: var(--md-sys-color-on-surface-variant);">Spawns a new boss encounter for each guild to tackle as a team.</div>
        </div>
    </div>
</div>
