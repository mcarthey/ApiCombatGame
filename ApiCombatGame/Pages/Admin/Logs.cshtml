@page
@model ApiCombatGame.Pages.Admin.LogsModel
@{
    ViewData["Title"] = "Logs";
    Layout = "_AdminLayout";
}

<!-- Filters -->
<div class="md3-card p-6 mb-6">
    <form method="get" class="flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
            <div class="md3-input-wrapper" style="width: 100%;">
                <label for="Search">Search</label>
                <input class="md3-input" id="Search" name="Search" value="@Model.Search" placeholder="Message, support ID, or exception..." />
            </div>
        </div>
        <div class="min-w-[130px]">
            <div class="md3-input-wrapper" style="width: 100%;">
                <label for="Level">Level</label>
                <select class="md3-select" id="Level" name="Level">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Level))">All Levels</option>
                    <option value="Info" selected="@(Model.Level == "Info")">Info</option>
                    <option value="Warning" selected="@(Model.Level == "Warning")">Warning</option>
                    <option value="Error" selected="@(Model.Level == "Error")">Error</option>
                    <option value="Fatal" selected="@(Model.Level == "Fatal")">Fatal</option>
                </select>
            </div>
        </div>
        <div class="min-w-[150px]">
            <div class="md3-input-wrapper" style="width: 100%;">
                <label for="DateFrom">From</label>
                <input class="md3-input" type="date" id="DateFrom" name="DateFrom" value="@Model.DateFrom" />
            </div>
        </div>
        <div class="min-w-[150px]">
            <div class="md3-input-wrapper" style="width: 100%;">
                <label for="DateTo">To</label>
                <input class="md3-input" type="date" id="DateTo" name="DateTo" value="@Model.DateTo" />
            </div>
        </div>
        <button class="md3-btn-filled" type="submit">
            <span class="material-symbols-outlined">search</span>
            Search
        </button>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Level) || !string.IsNullOrEmpty(Model.DateFrom) || !string.IsNullOrEmpty(Model.DateTo))
        {
            <a href="/Admin/Logs" class="md3-btn-outlined" style="text-decoration: none;">Clear</a>
        }
    </form>
</div>

<!-- Results Count -->
<div class="flex justify-between items-center mb-4">
    <span class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
        @Model.Data.TotalCount.ToString("N0") log entries
    </span>
</div>

<!-- Log Detail Panel -->
@if (Model.SelectedLog != null)
{
    var log = Model.SelectedLog;
    <div class="md3-card p-6 mb-6" style="border-left: 4px solid @GetLevelColor(log.Level.ToString());">
        <div class="flex justify-between items-start mb-4">
            <div>
                <h3 class="text-lg font-semibold" style="color: var(--md-sys-color-on-surface);">Log Detail</h3>
                @if (!string.IsNullOrEmpty(log.SupportId))
                {
                    <span class="font-mono text-sm font-bold" style="color: var(--md-sys-color-error);">@log.SupportId</span>
                }
            </div>
            <a href="/Admin/Logs?Search=@Model.Search&Level=@Model.Level&DateFrom=@Model.DateFrom&DateTo=@Model.DateTo&Page=@Model.Page" class="md3-btn-text" style="text-decoration: none;">
                <span class="material-symbols-outlined">close</span>
                Close
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
            <div>
                <div class="text-xs font-medium uppercase" style="color: var(--md-sys-color-on-surface-variant);">Level</div>
                <span class="text-sm font-medium px-2 py-1 rounded" style="background: @GetLevelBg(log.Level.ToString()); color: @GetLevelColor(log.Level.ToString());">@log.Level</span>
            </div>
            <div>
                <div class="text-xs font-medium uppercase" style="color: var(--md-sys-color-on-surface-variant);">Category</div>
                <div class="text-sm" style="color: var(--md-sys-color-on-surface);">@log.Category</div>
            </div>
            <div>
                <div class="text-xs font-medium uppercase" style="color: var(--md-sys-color-on-surface-variant);">Timestamp</div>
                <div class="text-sm" style="color: var(--md-sys-color-on-surface);">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
            </div>
            <div>
                <div class="text-xs font-medium uppercase" style="color: var(--md-sys-color-on-surface-variant);">Player</div>
                <div class="text-sm" style="color: var(--md-sys-color-on-surface);">
                    @if (log.Player != null)
                    {
                        <a href="/Admin/PlayerDetail?id=@log.PlayerId" style="color: var(--md-sys-color-primary);">@log.Player.Username</a>
                    }
                    else
                    {
                        <span style="color: var(--md-sys-color-on-surface-variant);">—</span>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(log.RequestPath))
        {
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                <div>
                    <div class="text-xs font-medium uppercase" style="color: var(--md-sys-color-on-surface-variant);">Path</div>
                    <div class="text-sm font-mono" style="color: var(--md-sys-color-on-surface);">@log.HttpMethod @log.RequestPath</div>
                </div>
                <div>
                    <div class="text-xs font-medium uppercase" style="color: var(--md-sys-color-on-surface-variant);">IP Address</div>
                    <div class="text-sm font-mono" style="color: var(--md-sys-color-on-surface);">@(log.IpAddress ?? "—")</div>
                </div>
                <div class="col-span-2">
                    <div class="text-xs font-medium uppercase" style="color: var(--md-sys-color-on-surface-variant);">User Agent</div>
                    <div class="text-sm" style="color: var(--md-sys-color-on-surface); word-break: break-all;">@(log.UserAgent ?? "—")</div>
                </div>
            </div>
        }

        <div class="mb-4">
            <div class="text-xs font-medium uppercase mb-1" style="color: var(--md-sys-color-on-surface-variant);">Message</div>
            <div class="text-sm p-3 rounded" style="background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface);">@log.Message</div>
        </div>

        @if (!string.IsNullOrEmpty(log.ExceptionDetails))
        {
            <div class="mb-4">
                <div class="text-xs font-medium uppercase mb-1" style="color: var(--md-sys-color-on-surface-variant);">Exception</div>
                <pre class="text-xs p-3 rounded overflow-x-auto" style="background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface); white-space: pre-wrap; word-break: break-all;">@log.ExceptionDetails</pre>
            </div>
        }

        @if (!string.IsNullOrEmpty(log.StackTrace))
        {
            <div>
                <div class="text-xs font-medium uppercase mb-1" style="color: var(--md-sys-color-on-surface-variant);">Stack Trace</div>
                <pre class="text-xs p-3 rounded overflow-x-auto" style="background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface); white-space: pre-wrap; word-break: break-all;">@log.StackTrace</pre>
            </div>
        }
    </div>
}

<!-- Log Table -->
<div class="md3-card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="md3-table min-w-full">
            <thead>
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="width: 160px;">Timestamp</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="width: 90px;">Level</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="width: 110px;">Category</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Message</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="width: 130px;">Support ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="width: 120px;">Player</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="width: 80px;">Detail</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Data.Logs.Any())
                {
                    @foreach (var log in Model.Data.Logs)
                    {
                        <tr style="border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                            <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                                @log.CreatedAt.ToString("MM/dd HH:mm:ss")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-xs font-medium px-2 py-1 rounded" style="background: @GetLevelBg(log.Level); color: @GetLevelColor(log.Level);">
                                    @log.Level
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: var(--md-sys-color-on-surface);">
                                @log.Category
                            </td>
                            <td class="px-6 py-4 text-sm" style="color: var(--md-sys-color-on-surface); max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @log.Message
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (!string.IsNullOrEmpty(log.SupportId))
                                {
                                    <span class="text-xs font-mono font-bold" style="color: var(--md-sys-color-error);">@log.SupportId</span>
                                }
                                else
                                {
                                    <span style="color: var(--md-sys-color-on-surface-variant);">—</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                @if (log.PlayerId.HasValue)
                                {
                                    <a href="/Admin/PlayerDetail?id=@log.PlayerId" style="color: var(--md-sys-color-primary);">@(log.PlayerUsername ?? "Unknown")</a>
                                }
                                else
                                {
                                    <span style="color: var(--md-sys-color-on-surface-variant);">—</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <a href="/Admin/Logs?Search=@Model.Search&Level=@Model.Level&DateFrom=@Model.DateFrom&DateTo=@Model.DateTo&Page=@Model.Page&DetailId=@log.Id"
                                   class="md3-btn-text" style="text-decoration: none; padding: 4px 8px;">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">visibility</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center" style="color: var(--md-sys-color-on-surface-variant);">
                            No log entries found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Data.TotalPages > 1)
    {
        <div class="px-6 py-3 flex items-center justify-between" style="border-top: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container);">
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">
                Page @Model.Data.Page of @Model.Data.TotalPages
            </div>
            <div class="flex space-x-2">
                @if (Model.Data.Page > 1)
                {
                    <a href="/Admin/Logs?Page=@(Model.Data.Page - 1)&Search=@Model.Search&Level=@Model.Level&DateFrom=@Model.DateFrom&DateTo=@Model.DateTo"
                       class="md3-btn-outlined" style="text-decoration: none;">Previous</a>
                }
                @for (var i = Math.Max(1, Model.Data.Page - 2); i <= Math.Min(Model.Data.TotalPages, Model.Data.Page + 2); i++)
                {
                    @if (i == Model.Data.Page)
                    {
                        <button class="md3-btn-filled" disabled>@i</button>
                    }
                    else
                    {
                        <a href="/Admin/Logs?Page=@i&Search=@Model.Search&Level=@Model.Level&DateFrom=@Model.DateFrom&DateTo=@Model.DateTo"
                           class="md3-btn-outlined" style="text-decoration: none;">@i</a>
                    }
                }
                @if (Model.Data.Page < Model.Data.TotalPages)
                {
                    <a href="/Admin/Logs?Page=@(Model.Data.Page + 1)&Search=@Model.Search&Level=@Model.Level&DateFrom=@Model.DateFrom&DateTo=@Model.DateTo"
                       class="md3-btn-outlined" style="text-decoration: none;">Next</a>
                }
            </div>
        </div>
    }
</div>

@functions {
    static string GetLevelColor(string level) => level switch
    {
        "Info" => "var(--md-sys-color-primary)",
        "Warning" => "#e65100",
        "Error" => "var(--md-sys-color-error)",
        "Fatal" => "#7b1fa2",
        _ => "var(--md-sys-color-on-surface-variant)"
    };

    static string GetLevelBg(string level) => level switch
    {
        "Info" => "var(--md-sys-color-primary-container)",
        "Warning" => "#fff3e0",
        "Error" => "var(--md-sys-color-error-container)",
        "Fatal" => "#f3e5f5",
        _ => "var(--md-sys-color-surface-container-high)"
    };
}
