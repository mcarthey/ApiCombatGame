@page
@model ApiCombatGame.Pages.Admin.ToolsModel
@{
    ViewData["Title"] = "Admin Tools";
    Layout = "_AdminLayout";
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="md3-alert-success mb-6">
        @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="md3-alert-error mb-6">
        @Model.ErrorMessage
    </div>
}

<!-- Stats -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="md3-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Admin Users</div>
        <div class="text-3xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@Model.AdminCount</div>
        <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">of @Model.TotalPlayers total players</div>
    </div>
    <div class="md3-card p-6">
        <div class="text-sm font-medium" style="color: var(--md-sys-color-on-surface-variant);">Current User</div>
        <div class="text-xl font-bold mt-1" style="color: var(--md-sys-color-on-surface);">@User.Identity?.Name</div>
        <div class="text-sm mt-1" style="color: var(--md-sys-color-on-surface-variant);">SuperAdmin</div>
    </div>
</div>

<!-- Admin Actions -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Grant Admin -->
    <div class="md3-card p-6">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Grant Admin Access</h3>
        <p class="text-sm mb-4" style="color: var(--md-sys-color-on-surface-variant);">
            Grant SuperAdmin access to a player by username. They'll need to log out and back in for changes to take effect.
        </p>
        <form method="post" asp-page-handler="GrantAdminByUsername" class="flex gap-2 items-end">
            <div class="md3-input-wrapper" style="flex: 1;">
                <label for="username">Username</label>
                <input class="md3-input" id="username" name="username" required />
            </div>
            <button class="md3-btn-filled" type="submit">
                <span class="material-symbols-outlined">admin_panel_settings</span>
                Grant Admin
            </button>
        </form>
    </div>

    <!-- Danger Zone -->
    <div class="md3-card p-6" style="border: 2px solid var(--md-sys-color-error);">
        <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-error);">Danger Zone</h3>
        <p class="text-sm mb-4" style="color: var(--md-sys-color-on-surface-variant);">
            Reset the entire database. This will delete ALL data and re-seed with defaults. This action cannot be undone.
        </p>
        <form method="post" asp-page-handler="ResetDatabase" onsubmit="return confirm('Are you absolutely sure? This will DELETE ALL DATA and cannot be undone!');">
            <button class="md3-btn-filled" type="submit" style="background: var(--md-sys-color-error); color: var(--md-sys-color-on-error);">
                <span class="material-symbols-outlined">delete_forever</span>
                Reset Database
            </button>
        </form>
    </div>
</div>

<!-- Quick Links -->
<div class="mt-8">
    <h3 class="text-lg font-semibold mb-4" style="color: var(--md-sys-color-on-surface);">Quick Links</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/openapi/v1.json" target="_blank" class="md3-card stat-card p-4">
            <div class="font-medium" style="color: var(--md-sys-color-on-surface);">OpenAPI Spec</div>
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">View the raw JSON specification</div>
        </a>
        <a href="/api-docs/v1" target="_blank" class="md3-card stat-card p-4">
            <div class="font-medium" style="color: var(--md-sys-color-on-surface);">API Documentation</div>
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Interactive API reference</div>
        </a>
        <a href="/health" target="_blank" class="md3-card stat-card p-4">
            <div class="font-medium" style="color: var(--md-sys-color-on-surface);">Health Check</div>
            <div class="text-sm" style="color: var(--md-sys-color-on-surface-variant);">Application health status</div>
        </a>
    </div>
</div>
